package VirtualFCS "VirtualFCS - VIRTUAL & physical platform for Fuel Cell System development"
  extends Modelica.Icons.Package;
  annotation (
    preferredView="info",
    version="5",
    versionDate="2023-01-19",
    uses(Modelica(version = "4.1.0"),
      Modelica_DeviceDrivers(version="2.1.0")),
    Icon(graphics={  Rectangle(fillColor = {255, 255, 255}, fillPattern = FillPattern.Solid, extent = {{-100, 100}, {100, -100}}), Bitmap(origin = {-1, 0}, extent = {{-99, -100}, {99, 100}}, fileName = "modelica://VirtualFCS/Resources/images/virtual-fcs-logo-emblem.png")}),
    Documentation(info = "<html><head></head><body><div><b>Version</b></div><div>3.0.0 (23.10.2026)</div><div><b><br></b></div><div><b>Overview</b></div><div>VirtualFCS is an open Modelica library for dynamic modelling of hydrogen and hybrid energy systems. It brings together electrochemical, electrical, fluid, thermal, control, and vehicle models, with examples ranging from PEM fuel cell vehicles to ammonia cracking. The library provides classes describing:</div><div><ul><li>Electrochemical systems: PEM fuel cells and stacks, fuel-cell systems, batteries, and PEM electrolysers.</li><li>Balance of plant: hydrogen, air, and cooling subsystems, compressors, humidifiers, heat exchangers, and related controls.</li><li>System integration: battery-electric and fuel cell range-extender powertrains.</li><li>Other applications: ammonia-cracking system case study, vehicle drive cycles, hardware-, software-, and user-in-the-loop examples.</li></ul></div><div><div>The VirtualFCS library is composed of 8 main sub-packages: Examples, Chemical, Control, Electrical, Electrochemical, Fluid, Media, Thermal, Powertrains, Subsystems, Vehicles, and Utilities.</div><div><br></div><b></b></div><div><br></div><div><img src=\"modelica://VirtualFCS/Resources/images/imgHydrogenVehicle.jpg\" style=\"width:15cm\"></div><div><br></div><div><br></div><b>Contributors (in alphabetical order)</b><div><div>Amélie Pinard, <span class=\"Apple-tab-span\" style=\"white-space:pre\">		</span>SINTEF Industry, Trondheim, Norway</div><div>Benjamin Synnevåg, <span class=\"Apple-tab-span\" style=\"white-space:pre\">	</span>SINTEF Industry, Trondheim, Norway</div><div>Dr. Daniel Pérez Clos, <span class=\"Apple-tab-span\" style=\"white-space:pre\">	</span>SINTEF Industry, Trondheim, Norway</div><div>Dr. Federico Zenith, <span class=\"Apple-tab-span\" style=\"white-space:pre\">	</span>SINTEF Digital, Trondheim, Norway</div><div>Dr. Karim Bendioub, <span class=\"Apple-tab-span\" style=\"white-space:pre\">	</span>SINTEF Industry, Trondheim, Norway</div><div>Dr. Loic Vichard, <span class=\"Apple-tab-span\" style=\"white-space:pre\">		</span>UBFC, Belfort, France</div><div>Dr. Mike Gerhardt, <span class=\"Apple-tab-span\" style=\"white-space:pre\">	</span>SINTEF Industry, Trondheim, Norway</div><div>Dr. Nadia Steiner,<span class=\"Apple-tab-span\" style=\"white-space:pre\">		</span>UBFC, Belfort, France</div><div>Dr. Roberto Scipioni, <span class=\"Apple-tab-span\" style=\"white-space:pre\">	</span>SINTEF Industry Trondheim, Norway</div><div>Dr. Simon Clark, <span class=\"Apple-tab-span\" style=\"white-space:pre\">		</span>SINTEF Industry, Trondheim, Norway</div><div>Dr. Yash Raka, <span class=\"Apple-tab-span\" style=\"white-space:pre\">		</span>SINTEF Industry, Trondheim, Norway</div></div><div><br></div><div><b>Funding</b></div><div>This library is part of a project that has received funding from the Clean Hydrogen (formerly Fuel Cells and Hydrogen 2) Joint Undertaking under Grant Agreements No 875087, 101192365, 101250260, and 101250344. This Joint Undertaking receives support from the European Union’s Horizon 2020 Research and Innovation programme, Hydrogen Europe and Hydrogen Europe Research.</div></body></html>"),
    conversion(from(version={"4","2.1.0-dev","3"}, script=
            "modelica://VirtualFCS/Resources/ConvertFromVirtualFCS_4.mos")));
end VirtualFCS;
