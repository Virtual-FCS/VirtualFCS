      dCMotorControlCompressor.speedController.add3.y;
    dCMotorControlCompressor.speedController.addSat.y = dCMotorControlCompressor.speedController.addAntiWindup.u2;
    dCMotorControlCompressor.speedController.integrator.u = dCMotorControlCompressor.speedController.addAntiWindup.y;
    dCMotorControlCompressor.speedController.variableLimiter.y = 
      dCMotorControlCompressor.speedController.addSat.u2;
    dCMotorControlCompressor.speedController.y = dCMotorControlCompressor.speedController.addSat.u2;
    dCMotorControlCompressor.speedController.product.u2 = dCMotorControlCompressor.speedController.constantKFF.y;
    dCMotorControlCompressor.speedController.u = dCMotorControlCompressor.speedController.feedback.u1;
    dCMotorControlCompressor.speedController.u_m = dCMotorControlCompressor.speedController.feedback.u2;
    dCMotorControlCompressor.speedController.variableLimiter.limit1 = 
      dCMotorControlCompressor.speedController.gain.u;
    dCMotorControlCompressor.speedController.yMaxConst.y = dCMotorControlCompressor.speedController.gain.u;
    dCMotorControlCompressor.speedController.variableLimiter.limit2 = 
      dCMotorControlCompressor.speedController.gain.y;
    dCMotorControlCompressor.speedController.zeroFF.y = dCMotorControlCompressor.speedController.product.u1;

  // Component dCMotorControlCompressor.preFilter
  // class Modelica.Blocks.Continuous.FirstOrder
  equation
    der(dCMotorControlCompressor.preFilter.y) = (dCMotorControlCompressor.preFilter.k
      *dCMotorControlCompressor.preFilter.u-dCMotorControlCompressor.preFilter.y)
      /dCMotorControlCompressor.preFilter.T;

  // Component dCMotorControlCompressor
  // class VirtualFCS.Control.DCMotorControlCompressor
  equation
    dCMotorControlCompressor.currentController.u_m = dCMotorControlCompressor.armatureInverter.iMot;
    dCMotorControlCompressor.pwr_pin_n.i-dCMotorControlCompressor.armatureInverter.pin_nBat.i
       = 0.0;
    dCMotorControlCompressor.pwr_pin_n.v = dCMotorControlCompressor.armatureInverter.pin_nBat.v;
    dCMotorControlCompressor.pin_n.i-dCMotorControlCompressor.armatureInverter.pin_nMot.i
       = 0.0;
    dCMotorControlCompressor.pin_n.v = dCMotorControlCompressor.armatureInverter.pin_nMot.v;
    dCMotorControlCompressor.pwr_pin_p.i-dCMotorControlCompressor.armatureInverter.pin_pBat.i
       = 0.0;
    dCMotorControlCompressor.pwr_pin_p.v = dCMotorControlCompressor.armatureInverter.pin_pBat.v;
    dCMotorControlCompressor.pin_p.i-dCMotorControlCompressor.armatureInverter.pin_pMot.i
       = 0.0;
    dCMotorControlCompressor.pin_p.v = dCMotorControlCompressor.armatureInverter.pin_pMot.v;
    dCMotorControlCompressor.currentController.yMaxVar = dCMotorControlCompressor.armatureInverter.vDC;
    dCMotorControlCompressor.currentController.y = dCMotorControlCompressor.armatureInverter.vRef;
    dCMotorControlCompressor.measuredSpeedInput = dCMotorControlCompressor.currentController.feedForward;
    dCMotorControlCompressor.speedController.u_m = dCMotorControlCompressor.currentController.feedForward;
    dCMotorControlCompressor.tau2i.y = dCMotorControlCompressor.currentController.u;
    dCMotorControlCompressor.setSpeedInput = dCMotorControlCompressor.preFilter.u;
    dCMotorControlCompressor.speedController.u = dCMotorControlCompressor.preFilter.y;
    dCMotorControlCompressor.tau2i.u = dCMotorControlCompressor.speedController.y;

  // Component dcpm.inertiaRotor
  // class Modelica.Mechanics.Rotational.Components.Inertia
  equation
    dcpm.inertiaRotor.phi = dcpm.inertiaRotor.flange_a.phi;
    dcpm.inertiaRotor.phi = dcpm.inertiaRotor.flange_b.phi;
    dcpm.inertiaRotor.w = der(dcpm.inertiaRotor.phi);
    dcpm.inertiaRotor.a = der(dcpm.inertiaRotor.w);
    dcpm.inertiaRotor.J*dcpm.inertiaRotor.a = dcpm.inertiaRotor.flange_a.tau+
      dcpm.inertiaRotor.flange_b.tau;

  // Component dcpm.inertiaStator
  // class Modelica.Mechanics.Rotational.Components.Inertia
  equation
    dcpm.inertiaStator.phi = dcpm.inertiaStator.flange_a.phi;
    dcpm.inertiaStator.phi = dcpm.inertiaStator.flange_b.phi;
    dcpm.inertiaStator.w = der(dcpm.inertiaStator.phi);
    dcpm.inertiaStator.a = der(dcpm.inertiaStator.w);
    dcpm.inertiaStator.J*dcpm.inertiaStator.a = dcpm.inertiaStator.flange_a.tau+
      dcpm.inertiaStator.flange_b.tau;

  // Component dcpm.fixed
  // class Modelica.Mechanics.Rotational.Components.Fixed
  equation
    dcpm.fixed.flange.phi = dcpm.fixed.phi0;

  // Component dcpm.friction
  // class Modelica.Electrical.Machines.Losses.Friction
    // extends Modelica.Electrical.Machines.Interfaces.FlangeSupport
    equation
      dcpm.friction.phi = dcpm.friction.flange.phi-dcpm.friction.support.phi;
      dcpm.friction.w = der(dcpm.friction.phi);
      dcpm.friction.tau =  -dcpm.friction.flange.tau;
      dcpm.friction.tau = dcpm.friction.support.tau;
    // end of extends 
  equation
    if (dcpm.friction.frictionParameters.PRef <= 0) then 
      dcpm.friction.tau = 0;
    else
      dcpm.friction.tau =  -(if noEvent(abs(dcpm.friction.w) > dcpm.friction.frictionParameters.wLinear)
         then dcpm.friction.frictionParameters.tauRef*noEvent((if 
        dcpm.friction.w > 0 then 1 else (if dcpm.friction.w < 0 then -1 else 0)))
        *(abs(dcpm.friction.w)/dcpm.friction.frictionParameters.wRef)^
        dcpm.friction.frictionParameters.power_w else dcpm.friction.frictionParameters.tauLinear
        *dcpm.friction.w/dcpm.friction.frictionParameters.wLinear);
    end if;
    dcpm.friction.lossPower =  -dcpm.friction.tau*dcpm.friction.w;

  // Component dcpm.ra
  // class Modelica.Electrical.Analog.Basic.Resistor
    // extends Modelica.Electrical.Analog.Interfaces.TwoPin
    equation
      dcpm.ra.v = dcpm.ra.p.v-dcpm.ra.n.v;
    // extends Modelica.Electrical.Analog.Interfaces.OnePort
    equation
      0 = dcpm.ra.p.i+dcpm.ra.n.i;
      dcpm.ra.i = dcpm.ra.p.i;
    // extends Modelica.Electrical.Analog.Interfaces.ConditionalHeatPort
    equation
      if ( not dcpm.ra.useHeatPort) then 
        dcpm.ra.T_heatPort = dcpm.ra.T;
      end if;
    // end of extends 
  equation
    assert(1+dcpm.ra.alpha*(dcpm.ra.T_heatPort-dcpm.ra.T_ref) >= 1E-15, 
      "Temperature outside scope of model!");
    dcpm.ra.R_actual = dcpm.ra.R*(1+dcpm.ra.alpha*(dcpm.ra.T_heatPort-
      dcpm.ra.T_ref));
    dcpm.ra.v = dcpm.ra.R_actual*dcpm.ra.i;
    dcpm.ra.LossPower = dcpm.ra.v*dcpm.ra.i;

  // Component dcpm.la
  // class Modelica.Electrical.Machines.BasicMachines.Components.InductorDC
    // extends Modelica.Electrical.Analog.Interfaces.TwoPin
    equation
      dcpm.la.v = dcpm.la.p.v-dcpm.la.n.v;
    // extends Modelica.Electrical.Analog.Interfaces.OnePort
    equation
      0 = dcpm.la.p.i+dcpm.la.n.i;
      dcpm.la.i = dcpm.la.p.i;
    // end of extends 
  equation
    dcpm.la.v = (if dcpm.la.quasiStatic then 0 else dcpm.la.L*der(dcpm.la.i));

  // Component dcpm.brush
  // class Modelica.Electrical.Machines.Losses.DCMachines.Brush
    // extends Modelica.Electrical.Analog.Interfaces.TwoPin
    equation
      dcpm.brush.v = dcpm.brush.p.v-dcpm.brush.n.v;
    // extends Modelica.Electrical.Analog.Interfaces.OnePort
    equation
      0 = dcpm.brush.p.i+dcpm.brush.n.i;
      dcpm.brush.i = dcpm.brush.p.i;
    // end of extends 
  equation
    if (dcpm.brush.brushParameters.V <= 0) then 
      dcpm.brush.v = 0;
    else
      dcpm.brush.v = smooth(0, (if dcpm.brush.i > dcpm.brush.brushParameters.ILinear
         then dcpm.brush.brushParameters.V else (if dcpm.brush.i <  -
        dcpm.brush.brushParameters.ILinear then  -dcpm.brush.brushParameters.V
         else dcpm.brush.brushParameters.V*dcpm.brush.i/dcpm.brush.brushParameters.ILinear)));
    end if;
    dcpm.brush.lossPower = dcpm.brush.v*dcpm.brush.i;

  // Component dcpm.core
  // class Modelica.Electrical.Machines.Losses.DCMachines.Core
    // extends Modelica.Electrical.Analog.Interfaces.TwoPin
    equation
      dcpm.core.v = dcpm.core.p.v-dcpm.core.n.v;
    // extends Modelica.Electrical.Analog.Interfaces.OnePort
    equation
      0 = dcpm.core.p.i+dcpm.core.n.i;
      dcpm.core.i = dcpm.core.p.i;
    // end of extends 
  equation
    if (dcpm.core.coreParameters.PRef <= 0) then 
      dcpm.core.Gc = 0;
      dcpm.core.i = 0;
    else
      dcpm.core.Gc = dcpm.core.coreParameters.GcRef;
      dcpm.core.i = dcpm.core.Gc*dcpm.core.v;
    end if;
    dcpm.core.lossPower = dcpm.core.v*dcpm.core.i;

  // Component dcpm.strayLoad
  // class Modelica.Electrical.Machines.Losses.DCMachines.StrayLoad
    // extends Modelica.Electrical.Analog.Interfaces.TwoPin
    equation
      dcpm.strayLoad.v = dcpm.strayLoad.p.v-dcpm.strayLoad.n.v;
    // extends Modelica.Electrical.Analog.Interfaces.OnePort
    equation
      0 = dcpm.strayLoad.p.i+dcpm.strayLoad.n.i;
      dcpm.strayLoad.i = dcpm.strayLoad.p.i;
    // extends Modelica.Electrical.Machines.Interfaces.FlangeSupport
    equation
      dcpm.strayLoad.phi = dcpm.strayLoad.flange.phi-dcpm.strayLoad.support.phi;
      dcpm.strayLoad.w = der(dcpm.strayLoad.phi);
      dcpm.strayLoad.tau =  -dcpm.strayLoad.flange.tau;
      dcpm.strayLoad.tau = dcpm.strayLoad.support.tau;
    // end of extends 
  equation
    dcpm.strayLoad.v = 0;
    if (dcpm.strayLoad.strayLoadParameters.PRef <= 0) then 
      dcpm.strayLoad.tau = 0;
    else
      dcpm.strayLoad.tau =  -dcpm.strayLoad.strayLoadParameters.tauRef*(
        dcpm.strayLoad.i/dcpm.strayLoad.strayLoadParameters.IRef)^2*noEvent((if 
        dcpm.strayLoad.w > 0 then 1 else (if dcpm.strayLoad.w < 0 then -1 else 0)))
        *(abs(dcpm.strayLoad.w)/dcpm.strayLoad.strayLoadParameters.wRef)^
        dcpm.strayLoad.strayLoadParameters.power_w;
    end if;
    dcpm.strayLoad.lossPower =  -dcpm.strayLoad.tau*dcpm.strayLoad.w;

  // Component dcpm.thermalAmbient.temperatureArmature
  // class Modelica.Thermal.HeatTransfer.Sources.PrescribedTemperature
  equation
    dcpm.thermalAmbient.temperatureArmature.port.T = dcpm.thermalAmbient.temperatureArmature.T;

  // Component dcpm.thermalAmbient.temperatureCore
  // class Modelica.Thermal.HeatTransfer.Sources.FixedTemperature
  equation
    dcpm.thermalAmbient.temperatureCore.port.T = dcpm.thermalAmbient.temperatureCore.T;

  // Component dcpm.thermalAmbient.temperatureStrayLoad
  // class Modelica.Thermal.HeatTransfer.Sources.FixedTemperature
  equation
    dcpm.thermalAmbient.temperatureStrayLoad.port.T = dcpm.thermalAmbient.temperatureStrayLoad.T;

  // Component dcpm.thermalAmbient.temperatureFriction
  // class Modelica.Thermal.HeatTransfer.Sources.FixedTemperature
  equation
    dcpm.thermalAmbient.temperatureFriction.port.T = dcpm.thermalAmbient.temperatureFriction.T;

  // Component dcpm.thermalAmbient.constTa
  // class Modelica.Blocks.Sources.Constant
  equation
    dcpm.thermalAmbient.constTa.y = dcpm.thermalAmbient.constTa.k;

  // Component dcpm.thermalAmbient.temperatureBrush
  // class Modelica.Thermal.HeatTransfer.Sources.FixedTemperature
  equation
    dcpm.thermalAmbient.temperatureBrush.port.T = dcpm.thermalAmbient.temperatureBrush.T;

  // Component dcpm.thermalAmbient.temperaturePermanentMagnet
  // class Modelica.Thermal.HeatTransfer.Sources.PrescribedTemperature
  equation
    dcpm.thermalAmbient.temperaturePermanentMagnet.port.T = dcpm.thermalAmbient.temperaturePermanentMagnet.T;

  // Component dcpm.thermalAmbient.constTpm
  // class Modelica.Blocks.Sources.Constant
  equation
    dcpm.thermalAmbient.constTpm.y = dcpm.thermalAmbient.constTpm.k;

  // Component dcpm.thermalAmbient
  // class Modelica.Electrical.Machines.Thermal.DCMachines.ThermalAmbientDCPM
  equation
    dcpm.thermalAmbient.temperatureArmature.T = dcpm.thermalAmbient.constTa.y;
    dcpm.thermalAmbient.temperaturePermanentMagnet.T = dcpm.thermalAmbient.constTpm.y;
    dcpm.thermalAmbient.thermalPort.heatPortArmature.Q_flow-dcpm.thermalAmbient.temperatureArmature.port.Q_flow
       = 0.0;
    dcpm.thermalAmbient.thermalPort.heatPortArmature.T = dcpm.thermalAmbient.temperatureArmature.port.T;
    dcpm.thermalAmbient.thermalPort.heatPortBrush.Q_flow-dcpm.thermalAmbient.temperatureBrush.port.Q_flow
       = 0.0;
    dcpm.thermalAmbient.thermalPort.heatPortBrush.T = dcpm.thermalAmbient.temperatureBrush.port.T;
    dcpm.thermalAmbient.thermalPort.heatPortCore.Q_flow-dcpm.thermalAmbient.temperatureCore.port.Q_flow
       = 0.0;
    dcpm.thermalAmbient.thermalPort.heatPortCore.T = dcpm.thermalAmbient.temperatureCore.port.T;
    dcpm.thermalAmbient.thermalPort.heatPortFriction.Q_flow-dcpm.thermalAmbient.temperatureFriction.port.Q_flow
       = 0.0;
    dcpm.thermalAmbient.thermalPort.heatPortFriction.T = dcpm.thermalAmbient.temperatureFriction.port.T;
    dcpm.thermalAmbient.thermalPort.heatPortPermanentMagnet.Q_flow-
      dcpm.thermalAmbient.temperaturePermanentMagnet.port.Q_flow = 0.0;
    dcpm.thermalAmbient.thermalPort.heatPortPermanentMagnet.T = dcpm.thermalAmbient.temperaturePermanentMagnet.port.T;
    dcpm.thermalAmbient.thermalPort.heatPortStrayLoad.Q_flow-dcpm.thermalAmbient.temperatureStrayLoad.port.Q_flow
       = 0.0;
    dcpm.thermalAmbient.thermalPort.heatPortStrayLoad.T = dcpm.thermalAmbient.temperatureStrayLoad.port.T;

  // Component dcpm.airGapDC
  // class Modelica.Electrical.Machines.BasicMachines.Components.AirGapDC
    // extends Modelica.Electrical.Machines.BasicMachines.Components.PartialAirGapDC
    equation
      dcpm.airGapDC.vai = dcpm.airGapDC.pin_ap.v-dcpm.airGapDC.pin_an.v;
      dcpm.airGapDC.ia = dcpm.airGapDC.pin_ap.i;
      dcpm.airGapDC.ia =  -dcpm.airGapDC.pin_an.i;
      dcpm.airGapDC.vei = dcpm.airGapDC.pin_ep.v-dcpm.airGapDC.pin_en.v;
      dcpm.airGapDC.ie = dcpm.airGapDC.pin_ep.i;
      dcpm.airGapDC.ie =  -dcpm.airGapDC.pin_en.i;
      dcpm.airGapDC.vei = (if dcpm.airGapDC.quasiStatic then 0 else der(
        dcpm.airGapDC.psi_e));
      dcpm.airGapDC.w = der(dcpm.airGapDC.flange.phi)-der(dcpm.airGapDC.support.phi);
      dcpm.airGapDC.vai = dcpm.airGapDC.turnsRatio*dcpm.airGapDC.psi_e*
        dcpm.airGapDC.w;
      dcpm.airGapDC.tauElectrical = dcpm.airGapDC.turnsRatio*dcpm.airGapDC.psi_e
        *dcpm.airGapDC.ia;
      dcpm.airGapDC.flange.tau =  -dcpm.airGapDC.tauElectrical;
      dcpm.airGapDC.support.tau = dcpm.airGapDC.tauElectrical;
    // end of extends 
  equation
    dcpm.airGapDC.psi_e = dcpm.airGapDC.Le*dcpm.airGapDC.ie;

  // Component dcpm.eGround
  // class Modelica.Electrical.Analog.Basic.Ground
  equation
    dcpm.eGround.p.v = 0;

  // Component dcpm.ie
  // class Modelica.Electrical.Analog.Sources.ConstantCurrent
    // extends Modelica.Electrical.Analog.Interfaces.TwoPin
    equation
      dcpm.ie.v = dcpm.ie.p.v-dcpm.ie.n.v;
    // extends Modelica.Electrical.Analog.Interfaces.OnePort
    equation
      0 = dcpm.ie.p.i+dcpm.ie.n.i;
      dcpm.ie.i = dcpm.ie.p.i;
    // end of extends 
  equation
    dcpm.ie.i = dcpm.ie.I;

  // Component dcpm
  // class Modelica.Electrical.Machines.BasicMachines.DCMachines.DC_PermanentMagnet
    // extends Modelica.Electrical.Machines.Interfaces.PartialBasicDCMachine
    equation
      assert(dcpm.ViNominal > 1E-15, "VaNominal has to be > (Ra[+Rse])*IaNominal");
    // end of extends 
  equation
    dcpm.inertiaRotor.flange_a.phi = dcpm.airGapDC.flange.phi;
    dcpm.airGapDC.flange.tau+dcpm.inertiaRotor.flange_a.tau = 0.0;
    dcpm.airGapDC.pin_an.i+dcpm.brush.p.i+dcpm.core.n.i = 0.0;
    dcpm.brush.p.v = dcpm.airGapDC.pin_an.v;
    dcpm.core.n.v = dcpm.airGapDC.pin_an.v;
    dcpm.airGapDC.pin_ap.i+dcpm.la.n.i = 0.0;
    dcpm.la.n.v = dcpm.airGapDC.pin_ap.v;
    dcpm.airGapDC.pin_en.i+dcpm.eGround.p.i+dcpm.ie.p.i = 0.0;
    dcpm.eGround.p.v = dcpm.airGapDC.pin_en.v;
    dcpm.ie.p.v = dcpm.airGapDC.pin_en.v;
    dcpm.airGapDC.pin_ep.i+dcpm.ie.n.i = 0.0;
    dcpm.ie.n.v = dcpm.airGapDC.pin_ep.v;
    dcpm.fixed.flange.phi = dcpm.airGapDC.support.phi;
    dcpm.friction.support.phi = dcpm.airGapDC.support.phi;
    dcpm.inertiaStator.flange_a.phi = dcpm.airGapDC.support.phi;
    dcpm.internalSupport.phi = dcpm.airGapDC.support.phi;
    dcpm.strayLoad.support.phi = dcpm.airGapDC.support.phi;
    dcpm.internalSupport.tau-(dcpm.airGapDC.support.tau+dcpm.fixed.flange.tau+
      dcpm.friction.support.tau+dcpm.inertiaStator.flange_a.tau)-
      dcpm.strayLoad.support.tau = 0.0;
    dcpm.internalThermalPort.heatPortBrush.Q_flow-dcpm.brush.heatPort.Q_flow-
      dcpm.thermalAmbient.thermalPort.heatPortBrush.Q_flow = 0.0;
    dcpm.internalThermalPort.heatPortBrush.T = dcpm.brush.heatPort.T;
    dcpm.thermalAmbient.thermalPort.heatPortBrush.T = dcpm.brush.heatPort.T;
    dcpm.pin_an.i-dcpm.brush.n.i = 0.0;
    dcpm.pin_an.v = dcpm.brush.n.v;
    dcpm.internalThermalPort.heatPortCore.Q_flow-dcpm.core.heatPort.Q_flow-
      dcpm.thermalAmbient.thermalPort.heatPortCore.Q_flow = 0.0;
    dcpm.internalThermalPort.heatPortCore.T = dcpm.core.heatPort.T;
    dcpm.thermalAmbient.thermalPort.heatPortCore.T = dcpm.core.heatPort.T;
    dcpm.core.p.i+dcpm.la.p.i+dcpm.ra.n.i = 0.0;
    dcpm.la.p.v = dcpm.core.p.v;
    dcpm.ra.n.v = dcpm.core.p.v;
    dcpm.friction.flange.phi = dcpm.flange.phi;
    dcpm.inertiaRotor.flange_b.phi = dcpm.flange.phi;
    dcpm.strayLoad.flange.phi = dcpm.flange.phi;
    dcpm.flange.tau-dcpm.friction.flange.tau-dcpm.inertiaRotor.flange_b.tau-
      dcpm.strayLoad.flange.tau = 0.0;
    dcpm.internalThermalPort.heatPortFriction.Q_flow-dcpm.friction.heatPort.Q_flow
      -dcpm.thermalAmbient.thermalPort.heatPortFriction.Q_flow = 0.0;
    dcpm.internalThermalPort.heatPortFriction.T = dcpm.friction.heatPort.T;
    dcpm.thermalAmbient.thermalPort.heatPortFriction.T = dcpm.friction.heatPort.T;
    dcpm.inertiaStator.flange_b.tau = 0.0;
    // extends VirtualFCS.Fluid.Compressor
    equation
      dcpm.internalSupport.tau = 0.0;
    // end of extends 
  equation
    dcpm.internalThermalPort.heatPortArmature.Q_flow-dcpm.ra.heatPort.Q_flow-
      dcpm.thermalAmbient.thermalPort.heatPortArmature.Q_flow = 0.0;
    // extends VirtualFCS.Fluid.Compressor
    equation
      dcpm.internalThermalPort.heatPortArmature.Q_flow = 0.0;
    // end of extends 
  equation
    dcpm.ra.heatPort.T = dcpm.internalThermalPort.heatPortArmature.T;
    dcpm.thermalAmbient.thermalPort.heatPortArmature.T = dcpm.internalThermalPort.heatPortArmature.T;
    // extends VirtualFCS.Fluid.Compressor
    equation
      dcpm.internalThermalPort.heatPortBrush.Q_flow = 0.0;
      dcpm.internalThermalPort.heatPortCore.Q_flow = 0.0;
      dcpm.internalThermalPort.heatPortFriction.Q_flow = 0.0;
    // end of extends 
  equation
    dcpm.internalThermalPort.heatPortPermanentMagnet.Q_flow-dcpm.thermalAmbient.thermalPort.heatPortPermanentMagnet.Q_flow
       = 0.0;
    // extends VirtualFCS.Fluid.Compressor
    equation
      dcpm.internalThermalPort.heatPortPermanentMagnet.Q_flow = 0.0;
    // end of extends 
  equation
    dcpm.thermalAmbient.thermalPort.heatPortPermanentMagnet.T = dcpm.internalThermalPort.heatPortPermanentMagnet.T;
    dcpm.internalThermalPort.heatPortStrayLoad.Q_flow-dcpm.strayLoad.heatPort.Q_flow
      -dcpm.thermalAmbient.thermalPort.heatPortStrayLoad.Q_flow = 0.0;
    // extends VirtualFCS.Fluid.Compressor
    equation
      dcpm.internalThermalPort.heatPortStrayLoad.Q_flow = 0.0;
    // end of extends 
  equation
    dcpm.strayLoad.heatPort.T = dcpm.internalThermalPort.heatPortStrayLoad.T;
    dcpm.thermalAmbient.thermalPort.heatPortStrayLoad.T = dcpm.internalThermalPort.heatPortStrayLoad.T;
    dcpm.pin_ap.i-dcpm.strayLoad.p.i = 0.0;
    dcpm.strayLoad.p.v = dcpm.pin_ap.v;
    dcpm.ra.p.i+dcpm.strayLoad.n.i = 0.0;
    dcpm.strayLoad.n.v = dcpm.ra.p.v;

  // Component inertia
  // class Modelica.Mechanics.Rotational.Components.Inertia
  equation
    inertia.phi = inertia.flange_a.phi;
    inertia.phi = inertia.flange_b.phi;
    inertia.w = der(inertia.phi);
    inertia.a = der(inertia.w);
    inertia.J*inertia.a = inertia.flange_a.tau+inertia.flange_b.tau;

  // Component pump.medium
  // class Modelica.Media.Air.MoistAir.BaseProperties
    // extends Modelica.Media.Interfaces.PartialMedium.BaseProperties_D283
    equation
      if (pump.medium.standardOrderComponents) then 
        pump.medium.Xi = pump.medium.X[1:1];
        pump.medium.X[2] = 1-sum(pump.medium.Xi);
        for i in (1:2) loop
          assert(pump.medium.X[i] >= -1E-05 and pump.medium.X[i] <= 1.00001, 
            "Mass fraction X["+       String(i, true, 0)+"] = "+       String(
            pump.medium.X[i], true, 0)+"of substance "+({"water", "air"})[i]+
            "\nof medium "+"Moist air"+" is not in the range 0..1");
        end for;
      end if;
      assert(pump.medium.p >= 0.0, "Pressure (= "+       String(pump.medium.p, 
        true, 0)+" Pa) of medium \""+"Moist air"+"\" is negative\n(Temperature = "
        +       String(pump.medium.T, true, 0)+" K)");
    // end of extends 
  equation
    assert(pump.medium.T >= 190 and pump.medium.T <= 647, "
Temperature T is not in the allowed range
190.0 K <= (T ="
      +       String(pump.medium.T, true, 0)+" K) <= 647.0 K
required from medium model \""
      +"Moist air"+"\".");
    pump.medium.MM = 1/(pump.medium.Xi[1]/0.01801528+(1.0-pump.medium.Xi[1])/
      0.0289651159);
    pump.medium.p_steam_sat = min(pump.saturationPressure_Unique9(pump.medium.T),
       0.999*pump.medium.p);
    pump.medium.X_sat = min(pump.medium.p_steam_sat*0.6219647130774989/max(1E-13,
       pump.medium.p-pump.medium.p_steam_sat)*(1-pump.medium.Xi[1]), 1.0);
    pump.medium.X_liquid = max(pump.medium.Xi[1]-pump.medium.X_sat, 0.0);
    pump.medium.X_steam = pump.medium.Xi[1]-pump.medium.X_liquid;
    pump.medium.X_air = 1-pump.medium.Xi[1];
    pump.medium.h = pump.specificEnthalpy_pTX_Unique6(pump.medium.p, 
      pump.medium.T, pump.medium.Xi);
    pump.medium.R_s = _GlobalScope.pump.dryair.R_s*(pump.medium.X_air/(1-
      pump.medium.X_liquid))+_GlobalScope.pump.steam.R_s*pump.medium.X_steam/(1-
      pump.medium.X_liquid);
    pump.medium.u = pump.medium.h-pump.medium.R_s*pump.medium.T;
    pump.medium.d = pump.medium.p/(pump.medium.R_s*pump.medium.T);
    pump.medium.state.p = pump.medium.p;
    pump.medium.state.T = pump.medium.T;
    pump.medium.state.X = pump.medium.X;
    pump.medium.x_sat = 0.6219647130774989*pump.medium.p_steam_sat/max(1E-13, 
      pump.medium.p-pump.medium.p_steam_sat);
    pump.medium.x_water = pump.medium.Xi[1]/max(pump.medium.X_air, 1E-13);
    pump.medium.phi = pump.medium.p/pump.medium.p_steam_sat*pump.medium.Xi[1]/(
      pump.medium.Xi[1]+0.6219647130774989*pump.medium.X_air);

  // Component pump.heatTransfer
  // class Modelica.Fluid.Machines.BaseClasses.PartialPump.HeatTransfer
    // extends Modelica.Fluid.Interfaces.PartialHeatTransfer
    equation
      if (pump.heatTransfer.use_k) then 
        pump.heatTransfer.Q_flows = pump.heatTransfer.heatPorts.Q_flow+(array(
          pump.heatTransfer.k*pump.heatTransfer.surfaceAreas[i]*(
          pump.heatTransfer.T_ambient-pump.heatTransfer.heatPorts[i].T) for i
           in 1:pump.heatTransfer.n));
      else
        pump.heatTransfer.Q_flows = pump.heatTransfer.heatPorts.Q_flow;
      end if;
    // extends Modelica.Fluid.Vessels.BaseClasses.HeatTransfer.IdealHeatTransfer
    equation
      pump.heatTransfer.Ts = pump.heatTransfer.heatPorts.T;
    // end of extends 

  // Component pump
  // class Modelica.Fluid.Machines.PrescribedPump
    // extends Modelica.Fluid.Interfaces.PartialLumpedVolume
    equation
      assert( not (pump.energyDynamics <> Modelica.Fluid.Types.Dynamics.
        SteadyState and pump.massDynamics == Modelica.Fluid.Types.Dynamics.
        SteadyState) or false, "Bad combination of dynamics options and Medium not conserving mass if fluidVolume is fixed.");
      pump.m = pump.fluidVolume*pump.medium.d;
      pump.mXi = pump.m*pump.medium.Xi;
      pump.U = pump.m*pump.medium.u;
      pump.mC = pump.m*pump.C;
      if (pump.energyDynamics == Modelica.Fluid.Types.Dynamics.SteadyState)
         then 
        0 = pump.Hb_flow+pump.Qb_flow+pump.Wb_flow;
      else
        der(pump.U) = pump.Hb_flow+pump.Qb_flow+pump.Wb_flow;
      end if;
      if (pump.massDynamics == Modelica.Fluid.Types.Dynamics.SteadyState) then 
        0 = pump.mb_flow;
      else
        der(pump.m) = pump.mb_flow;
      end if;
      if (pump.substanceDynamics == Modelica.Fluid.Types.Dynamics.SteadyState)
         then 
        zeros(1) = pump.mbXi_flow;
      else
        der(pump.mXi) = pump.mbXi_flow;
      end if;
      if (pump.traceDynamics == Modelica.Fluid.Types.Dynamics.SteadyState) then 
        zeros(0) = pump.mbC_flow;
      else
        der(pump.mC_scaled) = pump.mbC_flow./{};
      end if;
      pump.mC = pump.mC_scaled.*{};
    // extends Modelica.Fluid.Machines.BaseClasses.PartialPump
    equation
      pump.V_flow = homotopy(pump.m_flow/pump.rho, pump.m_flow/pump.rho_nominal);
      pump.V_flow_single = pump.V_flow/pump.nParallel;
      if ( not pump.checkValve) then 
        pump.head = homotopy((pump.N/pump.N_nominal)^2*pump.flowCharacteristic_Unique'"pump"'
          (pump.V_flow_single*pump.N_nominal/pump.N, {0, 0.00365}, {150000, 100000}),
           pump.N/pump.N_nominal*(pump.flowCharacteristic_Unique'"pump"'(
          pump.V_flow_single_init, {0, 0.00365}, {150000, 100000})+(
          pump.V_flow_single-pump.V_flow_single_init)*(if abs(pump.V_flow_single_init)
           > 0 then pump.delta_head_init/(0.1*pump.V_flow_single_init) else 0)));
        pump.s = 0;
      else
        if (pump.checkValveHomotopy == Modelica.Fluid.Types.CheckValveHomotopyType.
          NoHomotopy) then 
          pump.head = (if pump.s > 0 then (pump.N/pump.N_nominal)^2*
            pump.flowCharacteristic_Unique'"pump"'(pump.V_flow_single*
            pump.N_nominal/pump.N, {0, 0.00365}, {150000, 100000}) else (pump.N/
            pump.N_nominal)^2*pump.flowCharacteristic_Unique'"pump"'(0, {0, 
            0.00365}, {150000, 100000})-pump.s*pump.unitHead);
          pump.V_flow_single = (if pump.s > 0 then pump.s*pump.unitMassFlowRate/
            pump.rho else 0);
        else
          pump.head = homotopy((if pump.s > 0 then (pump.N/pump.N_nominal)^2*
            pump.flowCharacteristic_Unique'"pump"'(pump.V_flow_single*
            pump.N_nominal/pump.N, {0, 0.00365}, {150000, 100000}) else (pump.N/
            pump.N_nominal)^2*pump.flowCharacteristic_Unique'"pump"'(0, {0, 
            0.00365}, {150000, 100000})-pump.s*pump.unitHead), (if 
            pump.checkValveHomotopy == Modelica.Fluid.Types.CheckValveHomotopyType.
            Open then pump.N/pump.N_nominal*(pump.flowCharacteristic_Unique'"pump"'
            (pump.V_flow_single_init, {0, 0.00365}, {150000, 100000})+(
            pump.V_flow_single-pump.V_flow_single_init)*(if abs(pump.V_flow_single_init)
             > 0 then pump.delta_head_init/(0.1*pump.V_flow_single_init) else 0))
             else pump.N/pump.N_nominal*pump.flowCharacteristic_Unique'"pump"'(0,
             {0, 0.00365}, {150000, 100000})-pump.s*pump.unitHead));
          pump.V_flow_single = homotopy((if pump.s > 0 then pump.s*
            pump.unitMassFlowRate/pump.rho else 0), (if pump.checkValveHomotopy
             == Modelica.Fluid.Types.CheckValveHomotopyType.Open then pump.s*
            pump.unitMassFlowRate/pump.rho_nominal else 0));
        end if;
      end if;
      if (pump.use_powerCharacteristic) then 
        pump.W_single = homotopy((pump.N/pump.N_nominal)^3*(pump.rho/
          pump.rho_nominal)*pump.powerCharacteristic_Unique'"pump"'(
          pump.V_flow_single*pump.N_nominal/pump.N, {0, 0, 0}, {0, 0, 0}), 
          pump.N/pump.N_nominal*pump.V_flow_single/pump.V_flow_single_init*
          pump.powerCharacteristic_Unique'"pump"'(pump.V_flow_single_init, {0, 0,
           0}, {0, 0, 0}));
        pump.eta = pump.dp_pump*pump.V_flow_single/pump.W_single;
      else
        pump.eta = homotopy(pump.efficiencyCharacteristic_Unique'"pump"'(
          pump.V_flow_single*(pump.N_nominal/pump.N), 0.62), pump.efficiencyCharacteristic_Unique'"pump"'
          (pump.V_flow_single_init, 0.62));
        pump.W_single = homotopy(pump.dp_pump*pump.V_flow_single/pump.eta, 
          pump.dp_pump*pump.V_flow_single_init/pump.eta);
      end if;
      pump.Wb_flow = pump.W_total;
      pump.Qb_flow = pump.heatTransfer.Q_flows[1];
      pump.Hb_flow = pump.port_a.m_flow*actualStream(pump.port_a.h_outflow)+
        pump.port_b.m_flow*actualStream(pump.port_b.h_outflow);
      pump.port_a.h_outflow = pump.medium.h;
      pump.port_b.h_outflow = pump.medium.h;
      pump.port_b.p = pump.medium.p;
      pump.mb_flow = pump.port_a.m_flow+pump.port_b.m_flow;
      pump.mbXi_flow = pump.port_a.m_flow*actualStream(pump.port_a.Xi_outflow)+
        pump.port_b.m_flow*actualStream(pump.port_b.Xi_outflow);
      pump.port_a.Xi_outflow = pump.medium.Xi;
      pump.port_b.Xi_outflow = pump.medium.Xi;
      pump.mbC_flow = pump.port_a.m_flow*actualStream(pump.port_a.C_outflow)+
        pump.port_b.m_flow*actualStream(pump.port_b.C_outflow);
      pump.port_a.C_outflow = pump.C;
      pump.port_b.C_outflow = pump.C;
    // end of extends 
  equation
    if ( not pump.use_N_in) then 
      pump.N_in_internal = pump.N_const;
    end if;
    pump.N = max(pump.N_in_internal, 0.001);
    pump.N_in_internal = pump.N_in;
    pump.heatTransfer.heatPorts[1].Q_flow = 0.0;

  // Component torque
  // class Modelica.Mechanics.Rotational.Sources.Torque
    // extends Modelica.Mechanics.Rotational.Interfaces.PartialElementaryOneFlangeAndSupport2
    equation
      if ( not torque.useSupport) then 
        torque.phi_support = 0;
      end if;
    // end of extends 
  equation
    torque.flange.tau =  -torque.tau;

  // Component speedSensor
  // class Modelica.Mechanics.Rotational.Sensors.SpeedSensor
    // extends Modelica.Mechanics.Rotational.Interfaces.PartialAbsoluteSensor
    equation
      0 = speedSensor.flange.tau;
    // end of extends 
  equation
    speedSensor.w = der(speedSensor.flange.phi);

  // Component gain
  // class Modelica.Blocks.Math.Gain
  equation
    gain.y = gain.k*gain.u;

  // Component limPID.addP
  // class Modelica.Blocks.Math.Add
  equation
    limPID.addP.y = limPID.addP.k1*limPID.addP.u1+limPID.addP.k2*limPID.addP.u2;

  // Component limPID.P
  // class Modelica.Blocks.Math.Gain
  equation
    limPID.P.y = limPID.P.k*limPID.P.u;

  // Component limPID.gainPID
  // class Modelica.Blocks.Math.Gain
  equation
    limPID.gainPID.y = limPID.gainPID.k*limPID.gainPID.u;

  // Component limPID.addPID
  // class Modelica.Blocks.Math.Add3
  equation
    limPID.addPID.y = limPID.addPID.k1*limPID.addPID.u1+limPID.addPID.k2*
      limPID.addPID.u2+limPID.addPID.k3*limPID.addPID.u3;

  // Component limPID.limiter
  // class Modelica.Blocks.Nonlinear.Limiter
  equation
    assert(limPID.limiter.uMax >= limPID.limiter.uMin, "Limiter: Limits must be consistent. However, uMax (="
      +       String(limPID.limiter.uMax, true, 0)+") < uMin (="+       String(
      limPID.limiter.uMin, true, 0)+")");
    limPID.limiter.simplifiedExpr = (if limPID.limiter.homotopyType == 
      Modelica.Blocks.Types.LimiterHomotopy.Linear then limPID.limiter.u else (
      if limPID.limiter.homotopyType == Modelica.Blocks.Types.LimiterHomotopy.
      UpperLimit then limPID.limiter.uMax else (if limPID.limiter.homotopyType
       == Modelica.Blocks.Types.LimiterHomotopy.LowerLimit then limPID.limiter.uMin
       else 0)));
    if (limPID.limiter.strict) then 
      if (limPID.limiter.homotopyType == Modelica.Blocks.Types.LimiterHomotopy.
        NoHomotopy) then 
        limPID.limiter.y = smooth(0, noEvent((if limPID.limiter.u > 
          limPID.limiter.uMax then limPID.limiter.uMax else (if limPID.limiter.u
           < limPID.limiter.uMin then limPID.limiter.uMin else limPID.limiter.u))));
      else
        limPID.limiter.y = homotopy(smooth(0, noEvent((if limPID.limiter.u > 
          limPID.limiter.uMax then limPID.limiter.uMax else (if limPID.limiter.u
           < limPID.limiter.uMin then limPID.limiter.uMin else limPID.limiter.u)))),
           limPID.limiter.simplifiedExpr);
      end if;
    else
      if (limPID.limiter.homotopyType == Modelica.Blocks.Types.LimiterHomotopy.
        NoHomotopy) then 
        limPID.limiter.y = smooth(0, (if limPID.limiter.u > limPID.limiter.uMax
           then limPID.limiter.uMax else (if limPID.limiter.u < limPID.limiter.uMin
           then limPID.limiter.uMin else limPID.limiter.u)));
      else
        limPID.limiter.y = homotopy(smooth(0, (if limPID.limiter.u > 
          limPID.limiter.uMax then limPID.limiter.uMax else (if limPID.limiter.u
           < limPID.limiter.uMin then limPID.limiter.uMin else limPID.limiter.u))),
           limPID.limiter.simplifiedExpr);
      end if;
    end if;

  // Component limPID.FFzero
  // class Modelica.Blocks.Sources.Constant
  equation
    limPID.FFzero.y = limPID.FFzero.k;

  // Component limPID.addFF
  // class Modelica.Blocks.Math.Add
  equation
    limPID.addFF.y = limPID.addFF.k1*limPID.addFF.u1+limPID.addFF.k2*
      limPID.addFF.u2;

  // Component limPID.addD
  // class Modelica.Blocks.Math.Add
  equation
    limPID.addD.y = limPID.addD.k1*limPID.addD.u1+limPID.addD.k2*limPID.addD.u2;

  // Component limPID.I
  // class Modelica.Blocks.Continuous.Integrator
  equation
    limPID.I.local_reset = false;
    limPID.I.local_set = 0;
    der(limPID.I.y) = limPID.I.k*limPID.I.u;

  // Component limPID.D
  // class Modelica.Blocks.Continuous.Derivative
  equation
    der(limPID.D.x) = (if limPID.D.zeroGain then 0 else (limPID.D.u-limPID.D.x)/
      limPID.D.T);
    limPID.D.y = (if limPID.D.zeroGain then 0 else limPID.D.k/limPID.D.T*(
      limPID.D.u-limPID.D.x));

  // Component limPID.addI
  // class Modelica.Blocks.Math.Add3
  equation
    limPID.addI.y = limPID.addI.k1*limPID.addI.u1+limPID.addI.k2*limPID.addI.u2+
      limPID.addI.k3*limPID.addI.u3;

  // Component limPID.addSat
  // class Modelica.Blocks.Math.Add
  equation
    limPID.addSat.y = limPID.addSat.k1*limPID.addSat.u1+limPID.addSat.k2*
      limPID.addSat.u2;

  // Component limPID.gainTrack
  // class Modelica.Blocks.Math.Gain
  equation
    limPID.gainTrack.y = limPID.gainTrack.k*limPID.gainTrack.u;

  // Component limPID
  // class Modelica.Blocks.Continuous.LimPID
  equation
    if (limPID.initType == Modelica.Blocks.Types.Init.InitialOutput and (
      limPID.y_start < limPID.yMin or limPID.y_start > limPID.yMax)) then 
      ModelicaError("LimPID: Start value y_start (="+       String(
        limPID.y_start, true, 0)+") is outside of the limits of yMin (="+
               String(limPID.yMin, true, 0)+") and yMax (="+       String(
        limPID.yMax, true, 0)+")");
    end if;
    limPID.addD.y = limPID.D.u;
    limPID.addPID.u2 = limPID.D.y;
    limPID.addFF.u2 = limPID.FFzero.y;
    limPID.addI.y = limPID.I.u;
    limPID.addPID.u3 = limPID.I.y;
    limPID.addP.y = limPID.P.u;
    limPID.addPID.u1 = limPID.P.y;
    limPID.addI.u1 = limPID.addD.u1;
    limPID.addP.u1 = limPID.addD.u1;
    limPID.u_s = limPID.addD.u1;
    limPID.addI.u2 = limPID.addD.u2;
    limPID.addP.u2 = limPID.addD.u2;
    limPID.u_m = limPID.addD.u2;
    limPID.gainPID.y = limPID.addFF.u1;
    limPID.addSat.u2 = limPID.addFF.y;
    limPID.limiter.u = limPID.addFF.y;
    limPID.gainTrack.y = limPID.addI.u3;
    limPID.gainPID.u = limPID.addPID.y;
    limPID.limiter.y = limPID.addSat.u1;
    limPID.y = limPID.addSat.u1;
    limPID.gainTrack.u = limPID.addSat.y;

  // Component senTem
  // class AixLib.Fluid.Sensors.TemperatureTwoPort
    // extends AixLib.Fluid.Sensors.BaseClasses.PartialFlowSensor
    equation
      senTem.port_b.m_flow =  -senTem.port_a.m_flow;
      senTem.port_a.p = senTem.port_b.p;
      senTem.port_a.h_outflow = (if senTem.allowFlowReversal then inStream(
        senTem.port_b.h_outflow) else senTem.specificEnthalpy_pTX_Unique49(101325,
         293.15, {0.01, 0.99}));
      senTem.port_b.h_outflow = inStream(senTem.port_a.h_outflow);
      senTem.port_a.Xi_outflow = (if senTem.allowFlowReversal then inStream(
        senTem.port_b.Xi_outflow) else {0.01});
      senTem.port_b.Xi_outflow = inStream(senTem.port_a.Xi_outflow);
      senTem.port_a.C_outflow = (if senTem.allowFlowReversal then inStream(
        senTem.port_b.C_outflow) else zeros(0));
      senTem.port_b.C_outflow = inStream(senTem.port_a.C_outflow);
    // extends AixLib.Fluid.Sensors.BaseClasses.PartialDynamicFlowSensor
    equation
      if (senTem.dynamic) then 
        senTem.mNor_flow = senTem.port_a.m_flow/senTem.m_flow_nominal;
        senTem.k = Modelica.Fluid.Utilities.regStep(senTem.port_a.m_flow, 
          senTem.mNor_flow,  -senTem.mNor_flow, senTem.m_flow_small);
      else
        senTem.mNor_flow = 1;
        senTem.k = 1;
      end if;
    // end of extends 
  equation
    if (senTem.allowFlowReversal) then 
      senTem.T_a_inflow = senTem.temperature_Unique68(
        senTem.setState_phX_Unique69(senTem.port_b.p, senTem.port_b.h_outflow, 
          senTem.port_b.Xi_outflow));
      senTem.T_b_inflow = senTem.temperature_Unique68(
        senTem.setState_phX_Unique69(senTem.port_a.p, senTem.port_a.h_outflow, 
          senTem.port_a.Xi_outflow));
      senTem.TMed = Modelica.Fluid.Utilities.regStep(senTem.port_a.m_flow, 
        senTem.T_a_inflow, senTem.T_b_inflow, senTem.m_flow_small);
    else
      senTem.TMed = senTem.temperature_Unique68(
        senTem.setState_phX_Unique69(senTem.port_b.p, senTem.port_b.h_outflow, 
          senTem.port_b.Xi_outflow));
      senTem.T_a_inflow = senTem.TMed;
      senTem.T_b_inflow = senTem.TMed;
    end if;
    if (senTem.dynamic) then 
      if (senTem.transferHeat) then 
        der(senTem.T) = (senTem.TMed-senTem.T)*senTem.k*senTem.tauInv+(
          senTem.TAmb-senTem.T)*senTem.tauHeaTraInv/(senTem.ratTau*senTem.k+1);
      else
        der(senTem.T) = (senTem.TMed-senTem.T)*senTem.k*senTem.tauInv;
      end if;
    else
      senTem.T = senTem.TMed;
    end if;

  // Component senRelHum
  // class AixLib.Fluid.Sensors.RelativeHumidityTwoPort
    // extends AixLib.Fluid.Sensors.BaseClasses.PartialFlowSensor
    equation
      senRelHum.port_b.m_flow =  -senRelHum.port_a.m_flow;
      senRelHum.port_a.p = senRelHum.port_b.p;
      senRelHum.port_a.h_outflow = (if senRelHum.allowFlowReversal then inStream
        (senRelHum.port_b.h_outflow) else senRelHum.specificEnthalpy_pTX_Unique72
        (101325, 293.15, {0.01, 0.99}));
      senRelHum.port_b.h_outflow = inStream(senRelHum.port_a.h_outflow);
      senRelHum.port_a.Xi_outflow = (if senRelHum.allowFlowReversal then 
        inStream(senRelHum.port_b.Xi_outflow) else {0.01});
      senRelHum.port_b.Xi_outflow = inStream(senRelHum.port_a.Xi_outflow);
      senRelHum.port_a.C_outflow = (if senRelHum.allowFlowReversal then inStream
        (senRelHum.port_b.C_outflow) else zeros(0));
      senRelHum.port_b.C_outflow = inStream(senRelHum.port_a.C_outflow);
    // extends AixLib.Fluid.Sensors.BaseClasses.PartialDynamicFlowSensor
    equation
      if (senRelHum.dynamic) then 
        senRelHum.mNor_flow = senRelHum.port_a.m_flow/senRelHum.m_flow_nominal;
        senRelHum.k = Modelica.Fluid.Utilities.regStep(senRelHum.port_a.m_flow, 
          senRelHum.mNor_flow,  -senRelHum.mNor_flow, senRelHum.m_flow_small);
      else
        senRelHum.mNor_flow = 1;
        senRelHum.k = 1;
      end if;
    // end of extends 
  equation
    senRelHum.Xi_a = senRelHum.port_b.Xi_outflow;
    senRelHum.T_a = senRelHum.temperature_phX_Unique90(senRelHum.port_a.p, 
      senRelHum.port_b.h_outflow, senRelHum.Xi_a);
    senRelHum.phi_a = AixLib.Utilities.Psychrometrics.Functions.phi_pTX(
      senRelHum.port_a.p, senRelHum.T_a, senRelHum.Xi_a[1]);
    if (senRelHum.allowFlowReversal) then 
      senRelHum.phi_b = AixLib.Utilities.Psychrometrics.Functions.phi_pTX(
        senRelHum.port_b.p, senRelHum.T_b, senRelHum.Xi_b[1]);
      senRelHum.T_b = senRelHum.temperature_phX_Unique90(senRelHum.port_b.p, 
        senRelHum.port_a.h_outflow, senRelHum.Xi_b);
      senRelHum.Xi_b = senRelHum.port_a.Xi_outflow;
      senRelHum.phiMed = Modelica.Fluid.Utilities.regStep(senRelHum.port_a.m_flow,
         senRelHum.phi_a, senRelHum.phi_b, senRelHum.m_flow_small);
    else
      senRelHum.phi_b = 0;
      senRelHum.T_b = 273.15;
      senRelHum.Xi_b = zeros(1);
      senRelHum.phiMed = senRelHum.phi_a;
    end if;
    if (senRelHum.dynamic) then 
      der(senRelHum.phi) = (senRelHum.phiMed-senRelHum.phi)*senRelHum.k*
        senRelHum.tauInv;
    else
      senRelHum.phi = senRelHum.phiMed;
    end if;

  // Component constant3
  // class Modelica.Blocks.Sources.Constant
  equation
    constant3.y = constant3.k;

  // Component hum.vol.preTem
  // class Buildings.HeatTransfer.Sources.PrescribedTemperature
  equation
    hum.vol.preTem.port.T = hum.vol.preTem.T;

  // Component hum.vol.heaFloSen
  // class Modelica.Thermal.HeatTransfer.Sensors.HeatFlowSensor
  equation
    hum.vol.heaFloSen.port_a.T = hum.vol.heaFloSen.port_b.T;
    hum.vol.heaFloSen.port_a.Q_flow+hum.vol.heaFloSen.port_b.Q_flow = 0;
    hum.vol.heaFloSen.Q_flow = hum.vol.heaFloSen.port_a.Q_flow;

  // Component hum.vol.dynBal.medium
  // class Modelica.Media.Air.MoistAir.BaseProperties
    // extends Modelica.Media.Interfaces.PartialMedium.BaseProperties_D1473
    equation
      if (hum.vol.dynBal.medium.standardOrderComponents) then 
        hum.vol.dynBal.medium.Xi = hum.vol.dynBal.medium.X[1:1];
        hum.vol.dynBal.medium.X[2] = 1-sum(hum.vol.dynBal.medium.Xi);
        for i in (1:2) loop
          assert(hum.vol.dynBal.medium.X[i] >= -1E-05 and hum.vol.dynBal.medium.X
            [i] <= 1.00001, "Mass fraction X["+       String(i, true, 0)+"] = "+
                   String(hum.vol.dynBal.medium.X[i], true, 0)+"of substance "+(
            {"water", "air"})[i]+"\nof medium "+"Moist air"+" is not in the range 0..1");
        end for;
      end if;
      assert(hum.vol.dynBal.medium.p >= 0.0, "Pressure (= "+       String(
        hum.vol.dynBal.medium.p, true, 0)+" Pa) of medium \""+"Moist air"+
        "\" is negative\n(Temperature = "+       String(hum.vol.dynBal.medium.T,
         true, 0)+" K)");
    // end of extends 
  equation
    assert(hum.vol.dynBal.medium.T >= 190 and hum.vol.dynBal.medium.T <= 647, 
      "
Temperature T is not in the allowed range
190.0 K <= (T ="+       String
      (hum.vol.dynBal.medium.T, true, 0)+" K) <= 647.0 K
required from medium model \""
      +"Moist air"+"\".");
    hum.vol.dynBal.medium.MM = 1/(hum.vol.dynBal.medium.Xi[1]/0.01801528+(1.0-
      hum.vol.dynBal.medium.Xi[1])/0.0289651159);
    hum.vol.dynBal.medium.p_steam_sat = min(hum.vol.dynBal.saturationPressure_Unique171
      (hum.vol.dynBal.medium.T), 0.999*hum.vol.dynBal.medium.p);
    hum.vol.dynBal.medium.X_sat = min(hum.vol.dynBal.medium.p_steam_sat*
      0.6219647130774989/max(1E-13, hum.vol.dynBal.medium.p-hum.vol.dynBal.medium.p_steam_sat)
      *(1-hum.vol.dynBal.medium.Xi[1]), 1.0);
    hum.vol.dynBal.medium.X_liquid = max(hum.vol.dynBal.medium.Xi[1]-
      hum.vol.dynBal.medium.X_sat, 0.0);
    hum.vol.dynBal.medium.X_steam = hum.vol.dynBal.medium.Xi[1]-hum.vol.dynBal.medium.X_liquid;
    hum.vol.dynBal.medium.X_air = 1-hum.vol.dynBal.medium.Xi[1];
    hum.vol.dynBal.medium.h = hum.vol.dynBal.specificEnthalpy_pTX_Unique179(
      hum.vol.dynBal.medium.p, hum.vol.dynBal.medium.T, hum.vol.dynBal.medium.Xi);
    hum.vol.dynBal.medium.R_s = _GlobalScope.hum.vol.dynBal.dryair.R_s*(
      hum.vol.dynBal.medium.X_air/(1-hum.vol.dynBal.medium.X_liquid))+
      _GlobalScope.hum.vol.dynBal.steam.R_s*hum.vol.dynBal.medium.X_steam/(1-
      hum.vol.dynBal.medium.X_liquid);
    hum.vol.dynBal.medium.u = hum.vol.dynBal.medium.h-hum.vol.dynBal.medium.R_s*
      hum.vol.dynBal.medium.T;
    hum.vol.dynBal.medium.d = hum.vol.dynBal.medium.p/(hum.vol.dynBal.medium.R_s
      *hum.vol.dynBal.medium.T);
    hum.vol.dynBal.medium.state.p = hum.vol.dynBal.medium.p;
    hum.vol.dynBal.medium.state.T = hum.vol.dynBal.medium.T;
    hum.vol.dynBal.medium.state.X = hum.vol.dynBal.medium.X;
    hum.vol.dynBal.medium.x_sat = 0.6219647130774989*hum.vol.dynBal.medium.p_steam_sat
      /max(1E-13, hum.vol.dynBal.medium.p-hum.vol.dynBal.medium.p_steam_sat);
    hum.vol.dynBal.medium.x_water = hum.vol.dynBal.medium.Xi[1]/max(
      hum.vol.dynBal.medium.X_air, 1E-13);
    hum.vol.dynBal.medium.phi = hum.vol.dynBal.medium.p/hum.vol.dynBal.medium.p_steam_sat
      *hum.vol.dynBal.medium.Xi[1]/(hum.vol.dynBal.medium.Xi[1]+0.6219647130774989
      *hum.vol.dynBal.medium.X_air);

  // Component hum.vol.dynBal
  // class Buildings.Fluid.Interfaces.ConservationEquation
  equation
    if ( not hum.vol.dynBal.use_mWat_flow) then 
      hum.vol.dynBal.mWat_flow_internal = 0;
    end if;
    if ( not hum.vol.dynBal.use_C_flow) then 
      hum.vol.dynBal.C_flow_internal = zeros(0);
    end if;
    if (hum.vol.dynBal.massDynamics == Modelica.Fluid.Types.Dynamics.SteadyState)
       then 
      hum.vol.dynBal.m = hum.vol.dynBal.fluidVolume*hum.vol.dynBal.rho_start;
    else
      if (hum.vol.dynBal._simplify_mWat_flow) then 
        hum.vol.dynBal.m = hum.vol.dynBal.fluidVolume*hum.vol.dynBal.density_Unique198
          (
          hum.vol.dynBal.setState_phX_Unique191(hum.vol.dynBal.medium.p, 
            hum.vol.dynBal.hOut, {0.01, 0.99}));
      else
        hum.vol.dynBal.m = hum.vol.dynBal.fluidVolume*hum.vol.dynBal.medium.d;
      end if;
    end if;
    hum.vol.dynBal.mXi = hum.vol.dynBal.m*hum.vol.dynBal.medium.Xi;
    if (hum.vol.dynBal.computeCSen) then 
      hum.vol.dynBal.U = hum.vol.dynBal.m*hum.vol.dynBal.medium.u+
        hum.vol.dynBal.CSen*(hum.vol.dynBal.medium.T-298.15);
    else
      hum.vol.dynBal.U = hum.vol.dynBal.m*hum.vol.dynBal.medium.u;
    end if;
    hum.vol.dynBal.mC = hum.vol.dynBal.m*hum.vol.dynBal.C;
    hum.vol.dynBal.hOut = hum.vol.dynBal.medium.h;
    hum.vol.dynBal.XiOut = hum.vol.dynBal.medium.Xi;
    hum.vol.dynBal.COut = hum.vol.dynBal.C;
    for i in (1:hum.vol.dynBal.nPorts) loop
      hum.vol.dynBal.ports_H_flow[i] = semiLinear(hum.vol.dynBal.ports[i].m_flow,
         inStream(hum.vol.dynBal.ports[i].h_outflow), hum.vol.dynBal.ports[i].
        h_outflow);
      for j in (1:1) loop
        hum.vol.dynBal.ports_mXi_flow[i, j] = semiLinear(hum.vol.dynBal.ports[i]
          .m_flow, inStream(hum.vol.dynBal.ports[i].Xi_outflow[j]), 
          hum.vol.dynBal.ports[i].Xi_outflow[j]);
      end for;
      for j in (1:0) loop
        hum.vol.dynBal.ports_mC_flow[i, j] = semiLinear(hum.vol.dynBal.ports[i].
          m_flow, inStream(hum.vol.dynBal.ports[i].C_outflow[j]), 
          hum.vol.dynBal.ports[i].C_outflow[j]);
      end for;
    end for;
    for i in (1:1) loop
      hum.vol.dynBal.mbXi_flow[i] = sum(hum.vol.dynBal.ports_mXi_flow[:, i]);
    end for;
    for i in (1:0) loop
      hum.vol.dynBal.mbC_flow[i] = sum(hum.vol.dynBal.ports_mC_flow[:, i]);
    end for;
    hum.vol.dynBal.mb_flow = sum(hum.vol.dynBal.ports.m_flow);
    hum.vol.dynBal.Hb_flow = sum(hum.vol.dynBal.ports_H_flow);
    if (hum.vol.dynBal.energyDynamics == Modelica.Fluid.Types.Dynamics.
      SteadyState) then 
      0 = hum.vol.dynBal.Hb_flow+hum.vol.dynBal.Q_flow;
    else
      der(hum.vol.dynBal.U) = hum.vol.dynBal.Hb_flow+hum.vol.dynBal.Q_flow;
    end if;
    if (hum.vol.dynBal.massDynamics == Modelica.Fluid.Types.Dynamics.SteadyState)
       then 
      0 = hum.vol.dynBal.mb_flow+(if hum.vol.dynBal.simplify_mWat_flow then 0
         else hum.vol.dynBal.mWat_flow_internal);
    else
      der(hum.vol.dynBal.m) = hum.vol.dynBal.mb_flow+(if hum.vol.dynBal.simplify_mWat_flow
         then 0 else hum.vol.dynBal.mWat_flow_internal);
    end if;
    if (hum.vol.dynBal.substanceDynamics == Modelica.Fluid.Types.Dynamics.
      SteadyState) then 
      zeros(1) = hum.vol.dynBal.mbXi_flow+hum.vol.dynBal.mWat_flow_internal*
        hum.vol.dynBal.s;
    else
      der(hum.vol.dynBal.medium.Xi) = (hum.vol.dynBal.mbXi_flow+hum.vol.dynBal.mWat_flow_internal
        *hum.vol.dynBal.s)/hum.vol.dynBal.m;
    end if;
    if (hum.vol.dynBal.traceDynamics == Modelica.Fluid.Types.Dynamics.
      SteadyState) then 
      zeros(0) = hum.vol.dynBal.mbC_flow+hum.vol.dynBal.C_flow_internal;
    else
      der(hum.vol.dynBal.mC) = hum.vol.dynBal.mbC_flow+hum.vol.dynBal.C_flow_internal;
    end if;
    for i in (1:hum.vol.dynBal.nPorts) loop
      hum.vol.dynBal.ports[i].p = hum.vol.dynBal.medium.p;
      hum.vol.dynBal.ports[i].h_outflow = hum.vol.dynBal.medium.h;
      hum.vol.dynBal.ports[i].Xi_outflow = hum.vol.dynBal.medium.Xi;
      hum.vol.dynBal.ports[i].C_outflow = hum.vol.dynBal.C;
    end for;
    hum.vol.dynBal.UOut = hum.vol.dynBal.U;
    hum.vol.dynBal.mXiOut = hum.vol.dynBal.mXi;
    hum.vol.dynBal.mOut = hum.vol.dynBal.m;
    hum.vol.dynBal.mCOut = hum.vol.dynBal.mC;
    hum.vol.dynBal.mWat_flow_internal = hum.vol.dynBal.mWat_flow;

  // Component hum.vol
  // class Buildings.Fluid.MixingVolumes.MixingVolumeMoistAir
    // extends Buildings.Fluid.MixingVolumes.BaseClasses.PartialMixingVolume
    equation
      if ( not hum.vol.allowFlowReversal) then 
        assert(hum.vol.ports[1].m_flow >  -hum.vol.m_flow_small, 
          "In Compressor.hum.vol: Model has flow reversal,
  but the parameter allowFlowReversal is set to false.
  m_flow_small    = "
          +       String(hum.vol.m_flow_small, true, 0)+"
  ports[1].m_flow = "+
                 String(hum.vol.ports[1].m_flow, true, 0)+"
");
      end if;
    // end of extends 
  equation
    hum.vol.dynBal.COut = hum.vol.COut_internal;
    hum.vol.dynBal.UOut = hum.vol.U;
    hum.vol.X_w = hum.vol.XLiq.y;
    hum.vol.dynBal.XiOut = hum.vol.XiOut_internal;
    hum.vol.heaFloSen.Q_flow = hum.vol.dynBal.Q_flow;
    hum.vol.hOut_internal = hum.vol.dynBal.hOut;
    hum.vol.mC = hum.vol.dynBal.mCOut;
    hum.vol.m = hum.vol.dynBal.mOut;
    hum.vol.mWat_flow = hum.vol.dynBal.mWat_flow;
    hum.vol.mXi = hum.vol.dynBal.mXiOut;
    hum.vol.ports[1].m_flow-hum.vol.dynBal.ports[1].m_flow = 0.0;
    hum.vol.ports[1].p = hum.vol.dynBal.ports[1].p;
    hum.vol.ports[2].m_flow-hum.vol.dynBal.ports[2].m_flow = 0.0;
    hum.vol.ports[2].p = hum.vol.dynBal.ports[2].p;
    hum.vol.heatPort.Q_flow-hum.vol.heaFloSen.port_a.Q_flow = 0.0;
    hum.vol.heatPort.T = hum.vol.heaFloSen.port_a.T;
    hum.vol.heaFloSen.port_b.Q_flow+hum.vol.preTem.port.Q_flow = 0.0;
    hum.vol.preTem.port.T = hum.vol.heaFloSen.port_b.T;
    hum.vol.preTem.T = hum.vol.portT.y;

  // Component hum.preDro
  // class Buildings.Fluid.FixedResistances.PressureDrop
    // extends Buildings.Fluid.BaseClasses.PartialResistance
    equation
      hum.preDro.port_a.h_outflow = (if hum.preDro.allowFlowReversal then 
        inStream(hum.preDro.port_b.h_outflow) else hum.preDro.specificEnthalpy_pTX_Unique141
        (101325, 293.15, {0.01, 0.99}));
      hum.preDro.port_b.h_outflow = inStream(hum.preDro.port_a.h_outflow);
      hum.preDro.port_a.m_flow+hum.preDro.port_b.m_flow = 0;
      hum.preDro.port_a.Xi_outflow = (if hum.preDro.allowFlowReversal then 
        inStream(hum.preDro.port_b.Xi_outflow) else {0.01});
      hum.preDro.port_b.Xi_outflow = inStream(hum.preDro.port_a.Xi_outflow);
      hum.preDro.port_a.C_outflow = (if hum.preDro.allowFlowReversal then 
        inStream(hum.preDro.port_b.C_outflow) else zeros(0));
      hum.preDro.port_b.C_outflow = inStream(hum.preDro.port_a.C_outflow);
    // end of extends 
  equation
    if (hum.preDro.computeFlowResistance) then 
      if (hum.preDro.linearized) then 
        if (hum.preDro.from_dp) then 
          hum.preDro.m_flow = hum.preDro.dp*hum.preDro.coeff;
        else
          hum.preDro.dp = hum.preDro.m_flow*hum.preDro.coeff;
        end if;
      else
        if (hum.preDro.homotopyInitialization) then 
          if (hum.preDro.from_dp) then 
            hum.preDro.m_flow = homotopy(Buildings.Fluid.BaseClasses.FlowModels.basicFlowFunction_dp
              (hum.preDro.dp, hum.preDro.k, hum.preDro.m_flow_turbulent), 
              hum.preDro.m_flow_nominal_pos*hum.preDro.dp/hum.preDro.dp_nominal_pos);
          else
            hum.preDro.dp = homotopy(Buildings.Fluid.BaseClasses.FlowModels.basicFlowFunction_m_flow
              (hum.preDro.m_flow, hum.preDro.k, hum.preDro.m_flow_turbulent), 
              hum.preDro.dp_nominal_pos*hum.preDro.m_flow/hum.preDro.m_flow_nominal_pos);
          end if;
        else
          if (hum.preDro.from_dp) then 
            hum.preDro.m_flow = Buildings.Fluid.BaseClasses.FlowModels.basicFlowFunction_dp
              (hum.preDro.dp, hum.preDro.k, hum.preDro.m_flow_turbulent);
          else
            hum.preDro.dp = Buildings.Fluid.BaseClasses.FlowModels.basicFlowFunction_m_flow
              (hum.preDro.m_flow, hum.preDro.k, hum.preDro.m_flow_turbulent);
          end if;
        end if;
      end if;
    else
      hum.preDro.dp = 0;
    end if;

  // Component hum.gai
  // class Modelica.Blocks.Math.Gain
  equation
    hum.gai.y = hum.gai.k*hum.gai.u;

  // Component hum
  // class Buildings.Fluid.Humidifiers.Humidifier_u
  equation
    hum.u = hum.gai.u;
    hum.mWat_flow = hum.gai.y;
    hum.vol.mWat_flow = hum.gai.y;
    hum.heatPort.Q_flow-hum.vol.heatPort.Q_flow = 0.0;
    // extends VirtualFCS.Fluid.Compressor
    equation
      hum.heatPort.Q_flow = 0.0;
    // end of extends 
  equation
    hum.vol.heatPort.T = hum.heatPort.T;
    hum.port_a.m_flow-hum.preDro.port_a.m_flow = 0.0;
    hum.preDro.port_a.p = hum.port_a.p;
    hum.port_b.m_flow-hum.vol.ports[2].m_flow = 0.0;
    hum.vol.ports[2].p = hum.port_b.p;
    hum.preDro.port_b.m_flow+hum.vol.ports[1].m_flow = 0.0;
    hum.vol.ports[1].p = hum.preDro.port_b.p;

  // This model
  // class VirtualFCS.Fluid.Compressor
  equation
    torque.tau =  -9.5488*pump.W_total/pump.N;
    Power_Compressor = pin_p.i*pin_p.v;
    Input.m_flow-pump.port_a.m_flow = 0.0;
    pump.port_a.p = Input.p;
    Output.m_flow-senRelHum.port_b.m_flow = 0.0;
    senRelHum.port_b.p = Output.p;
    limPID.u_s = constant3.y;
    gain1.u = controlInterface;
    gain.u = dCMotorControlCompressor.measuredSpeedInput;
    sen_Air_comp_speed = dCMotorControlCompressor.measuredSpeedInput;
    speedSensor.w = dCMotorControlCompressor.measuredSpeedInput;
    dCMotorControlCompressor.pin_n.i+dcpm.pin_an.i = 0.0;
    dcpm.pin_an.v = dCMotorControlCompressor.pin_n.v;
    dCMotorControlCompressor.pin_p.i+dcpm.pin_ap.i = 0.0;
    dcpm.pin_ap.v = dCMotorControlCompressor.pin_p.v;
    pin_n.i-dCMotorControlCompressor.pwr_pin_n.i = 0.0;
    pin_n.v = dCMotorControlCompressor.pwr_pin_n.v;
    pin_p.i-dCMotorControlCompressor.pwr_pin_p.i = 0.0;
    pin_p.v = dCMotorControlCompressor.pwr_pin_p.v;
    gain1.y = dCMotorControlCompressor.setSpeedInput;
    inertia.flange_a.phi = dcpm.flange.phi;
    dcpm.flange.tau+inertia.flange_a.tau = 0.0;
    pump.N_in = gain.y;
    hum.port_a.m_flow+pump.port_b.m_flow = 0.0;
    pump.port_b.p = hum.port_a.p;
    hum.port_b.m_flow+senTem.port_a.m_flow = 0.0;
    senTem.port_a.p = hum.port_b.p;
    limPID.y = hum.u;
    speedSensor.flange.phi = inertia.flange_b.phi;
    torque.flange.phi = inertia.flange_b.phi;
    inertia.flange_b.tau+speedSensor.flange.tau+torque.flange.tau = 0.0;
    senRelHum.phi = limPID.u_m;
    senRelHum.port_a.m_flow+senTem.port_b.m_flow = 0.0;
    senTem.port_b.p = senRelHum.port_a.p;

// Fictive Equations for flow variables in top-level flow connectors: 
  Input.m_flow = function_of(Input.p, Input.h_outflow, Input.Xi_outflow, 
    Input.C_outflow, Output.p, Output.h_outflow, Output.Xi_outflow, 
    Output.C_outflow, pin_p.v, pin_n.v);
  Output.m_flow = function_of(Input.p, Input.h_outflow, Input.Xi_outflow, 
    Input.C_outflow, Output.p, Output.h_outflow, Output.Xi_outflow, 
    Output.C_outflow, pin_p.v, pin_n.v);
  pin_p.i = function_of(Input.p, Input.h_outflow, Input.Xi_outflow, 
    Input.C_outflow, Output.p, Output.h_outflow, Output.Xi_outflow, 
    Output.C_outflow, pin_p.v, pin_n.v);
  pin_n.i = function_of(Input.p, Input.h_outflow, Input.Xi_outflow, 
    Input.C_outflow, Output.p, Output.h_outflow, Output.Xi_outflow, 
    Output.C_outflow, pin_p.v, pin_n.v);
            
// Initial equations and algorithms

  // Component dCMotorControlCompressor.armatureInverter.vDCFilter
  // class Modelica.Blocks.Continuous.FirstOrder
  initial equation
    if (dCMotorControlCompressor.armatureInverter.vDCFilter.initType == 
      Modelica.Blocks.Types.Init.SteadyState) then 
      der(dCMotorControlCompressor.armatureInverter.vDCFilter.y) = 0;
    elseif (dCMotorControlCompressor.armatureInverter.vDCFilter.initType == 
      Modelica.Blocks.Types.Init.InitialState or dCMotorControlCompressor.armatureInverter.vDCFilter.initType
       == Modelica.Blocks.Types.Init.InitialOutput) then 
      dCMotorControlCompressor.armatureInverter.vDCFilter.y = dCMotorControlCompressor.armatureInverter.vDCFilter.y_start;
    end if;

  // Component dCMotorControlCompressor.armatureInverter.iMotFilter
  // class Modelica.Blocks.Continuous.FirstOrder
  initial equation
    if (dCMotorControlCompressor.armatureInverter.iMotFilter.initType == 
      Modelica.Blocks.Types.Init.SteadyState) then 
      der(dCMotorControlCompressor.armatureInverter.iMotFilter.y) = 0;
    elseif (dCMotorControlCompressor.armatureInverter.iMotFilter.initType == 
      Modelica.Blocks.Types.Init.InitialState or dCMotorControlCompressor.armatureInverter.iMotFilter.initType
       == Modelica.Blocks.Types.Init.InitialOutput) then 
      dCMotorControlCompressor.armatureInverter.iMotFilter.y = dCMotorControlCompressor.armatureInverter.iMotFilter.y_start;
    end if;

  // Component dCMotorControlCompressor.armatureInverter.idealDcDc.deadTime
  // class Modelica.Blocks.Continuous.FirstOrder
  initial equation
    if (dCMotorControlCompressor.armatureInverter.idealDcDc.deadTime.initType
       == Modelica.Blocks.Types.Init.SteadyState) then 
      der(dCMotorControlCompressor.armatureInverter.idealDcDc.deadTime.y) = 0;
    elseif (dCMotorControlCompressor.armatureInverter.idealDcDc.deadTime.initType
       == Modelica.Blocks.Types.Init.InitialState or dCMotorControlCompressor.armatureInverter.idealDcDc.deadTime.initType
       == Modelica.Blocks.Types.Init.InitialOutput) then 
      dCMotorControlCompressor.armatureInverter.idealDcDc.deadTime.y = 
        dCMotorControlCompressor.armatureInverter.idealDcDc.deadTime.y_start;
    end if;

  // Component dCMotorControlCompressor.armatureInverter.idealDcDc.powerController
  // class Modelica.Blocks.Continuous.Integrator
  initial equation
    if (dCMotorControlCompressor.armatureInverter.idealDcDc.powerController.initType
       == Modelica.Blocks.Types.Init.SteadyState) then 
      der(dCMotorControlCompressor.armatureInverter.idealDcDc.powerController.y)
         = 0;
    elseif (dCMotorControlCompressor.armatureInverter.idealDcDc.powerController.initType
       == Modelica.Blocks.Types.Init.InitialState or dCMotorControlCompressor.armatureInverter.idealDcDc.powerController.initType
       == Modelica.Blocks.Types.Init.InitialOutput) then 
      dCMotorControlCompressor.armatureInverter.idealDcDc.powerController.y = 
        dCMotorControlCompressor.armatureInverter.idealDcDc.powerController.y_start;
    end if;

  // Component dCMotorControlCompressor.armatureInverter.vMotFilter
  // class Modelica.Blocks.Continuous.FirstOrder
  initial equation
    if (dCMotorControlCompressor.armatureInverter.vMotFilter.initType == 
      Modelica.Blocks.Types.Init.SteadyState) then 
      der(dCMotorControlCompressor.armatureInverter.vMotFilter.y) = 0;
    elseif (dCMotorControlCompressor.armatureInverter.vMotFilter.initType == 
      Modelica.Blocks.Types.Init.InitialState or dCMotorControlCompressor.armatureInverter.vMotFilter.initType
       == Modelica.Blocks.Types.Init.InitialOutput) then 
      dCMotorControlCompressor.armatureInverter.vMotFilter.y = dCMotorControlCompressor.armatureInverter.vMotFilter.y_start;
    end if;

  // Component dCMotorControlCompressor.armatureInverter.iDCFilter
  // class Modelica.Blocks.Continuous.FirstOrder
  initial equation
    if (dCMotorControlCompressor.armatureInverter.iDCFilter.initType == 
      Modelica.Blocks.Types.Init.SteadyState) then 
      der(dCMotorControlCompressor.armatureInverter.iDCFilter.y) = 0;
    elseif (dCMotorControlCompressor.armatureInverter.iDCFilter.initType == 
      Modelica.Blocks.Types.Init.InitialState or dCMotorControlCompressor.armatureInverter.iDCFilter.initType
       == Modelica.Blocks.Types.Init.InitialOutput) then 
      dCMotorControlCompressor.armatureInverter.iDCFilter.y = dCMotorControlCompressor.armatureInverter.iDCFilter.y_start;
    end if;

  // Component dCMotorControlCompressor.currentController.integrator
  // class Modelica.Blocks.Continuous.Integrator
  initial equation
    if (dCMotorControlCompressor.currentController.integrator.initType == 
      Modelica.Blocks.Types.Init.SteadyState) then 
      der(dCMotorControlCompressor.currentController.integrator.y) = 0;
    elseif (dCMotorControlCompressor.currentController.integrator.initType == 
      Modelica.Blocks.Types.Init.InitialState or dCMotorControlCompressor.currentController.integrator.initType
       == Modelica.Blocks.Types.Init.InitialOutput) then 
      dCMotorControlCompressor.currentController.integrator.y = dCMotorControlCompressor.currentController.integrator.y_start;
    end if;

  // Component dCMotorControlCompressor.currentController
  // class Modelica.Electrical.Machines.Examples.ControlledDCDrives.Utilities.LimitedPI
  initial equation
    if (dCMotorControlCompressor.currentController.initType == Modelica.Blocks.Types.Init.
      SteadyState and dCMotorControlCompressor.currentController.useI) then 
      der(dCMotorControlCompressor.currentController.add3.u2) = 0;
    elseif (dCMotorControlCompressor.currentController.initType == 
      Modelica.Blocks.Types.Init.InitialState and dCMotorControlCompressor.currentController.useI)
       then 
      dCMotorControlCompressor.currentController.add3.u2 = dCMotorControlCompressor.currentController.x_start;
    elseif (dCMotorControlCompressor.currentController.initType == 
      Modelica.Blocks.Types.Init.InitialOutput) then 
      dCMotorControlCompressor.currentController.add3.y = dCMotorControlCompressor.currentController.y_start;
    end if;

  // Component dCMotorControlCompressor.speedController.integrator
  // class Modelica.Blocks.Continuous.Integrator
  initial equation
    if (dCMotorControlCompressor.speedController.integrator.initType == 
      Modelica.Blocks.Types.Init.SteadyState) then 
      der(dCMotorControlCompressor.speedController.integrator.y) = 0;
    elseif (dCMotorControlCompressor.speedController.integrator.initType == 
      Modelica.Blocks.Types.Init.InitialState or dCMotorControlCompressor.speedController.integrator.initType
       == Modelica.Blocks.Types.Init.InitialOutput) then 
      dCMotorControlCompressor.speedController.integrator.y = dCMotorControlCompressor.speedController.integrator.y_start;
    end if;

  // Component dCMotorControlCompressor.speedController
  // class Modelica.Electrical.Machines.Examples.ControlledDCDrives.Utilities.LimitedPI
  initial equation
    if (dCMotorControlCompressor.speedController.initType == Modelica.Blocks.Types.Init.
      SteadyState and dCMotorControlCompressor.speedController.useI) then 
      der(dCMotorControlCompressor.speedController.add3.u2) = 0;
    elseif (dCMotorControlCompressor.speedController.initType == 
      Modelica.Blocks.Types.Init.InitialState and dCMotorControlCompressor.speedController.useI)
       then 
      dCMotorControlCompressor.speedController.add3.u2 = dCMotorControlCompressor.speedController.x_start;
    elseif (dCMotorControlCompressor.speedController.initType == 
      Modelica.Blocks.Types.Init.InitialOutput) then 
      dCMotorControlCompressor.speedController.add3.y = dCMotorControlCompressor.speedController.y_start;
    end if;

  // Component dCMotorControlCompressor.preFilter
  // class Modelica.Blocks.Continuous.FirstOrder
  initial equation
    if (dCMotorControlCompressor.preFilter.initType == Modelica.Blocks.Types.Init.
      SteadyState) then 
      der(dCMotorControlCompressor.preFilter.y) = 0;
    elseif (dCMotorControlCompressor.preFilter.initType == Modelica.Blocks.Types.Init.
      InitialState or dCMotorControlCompressor.preFilter.initType == 
      Modelica.Blocks.Types.Init.InitialOutput) then 
      dCMotorControlCompressor.preFilter.y = dCMotorControlCompressor.preFilter.y_start;
    end if;

  // Component pump
  // class Modelica.Fluid.Machines.PrescribedPump
    // extends Modelica.Fluid.Interfaces.PartialLumpedVolume
    initial equation
      if (pump.energyDynamics == Modelica.Fluid.Types.Dynamics.FixedInitial)
         then 
        pump.medium.T = pump.T_start;
      elseif (pump.energyDynamics == Modelica.Fluid.Types.Dynamics.
        SteadyStateInitial) then 
        der(pump.medium.T) = 0;
      end if;
      if (pump.massDynamics == Modelica.Fluid.Types.Dynamics.FixedInitial) then 
        if (pump.initialize_p) then 
          pump.medium.p = pump.p_start;
        end if;
      elseif (pump.massDynamics == Modelica.Fluid.Types.Dynamics.
        SteadyStateInitial) then 
        if (pump.initialize_p) then 
          der(pump.medium.p) = 0;
        end if;
      end if;
      if (pump.substanceDynamics == Modelica.Fluid.Types.Dynamics.FixedInitial)
         then 
        pump.medium.Xi = pump.X_start[1:1];
      elseif (pump.substanceDynamics == Modelica.Fluid.Types.Dynamics.
        SteadyStateInitial) then 
        der(pump.medium.Xi) = zeros(1);
      end if;
      if (pump.traceDynamics == Modelica.Fluid.Types.Dynamics.FixedInitial)
         then 
        pump.mC_scaled = pump.m*pump.C_start[1:0]./{};
      elseif (pump.traceDynamics == Modelica.Fluid.Types.Dynamics.
        SteadyStateInitial) then 
        der(pump.mC_scaled) = zeros(0);
      end if;
    // end of extends 

  // Component limPID.I
  // class Modelica.Blocks.Continuous.Integrator
  initial equation
    if (limPID.I.initType == Modelica.Blocks.Types.Init.SteadyState) then 
      der(limPID.I.y) = 0;
    elseif (limPID.I.initType == Modelica.Blocks.Types.Init.InitialState or 
      limPID.I.initType == Modelica.Blocks.Types.Init.InitialOutput) then 
      limPID.I.y = limPID.I.y_start;
    end if;

  // Component limPID.D
  // class Modelica.Blocks.Continuous.Derivative
  initial equation
    if (limPID.D.initType == Modelica.Blocks.Types.Init.SteadyState) then 
      der(limPID.D.x) = 0;
    elseif (limPID.D.initType == Modelica.Blocks.Types.Init.InitialState) then 
      limPID.D.x = limPID.D.x_start;
    elseif (limPID.D.initType == Modelica.Blocks.Types.Init.InitialOutput) then 
      if (limPID.D.zeroGain) then 
        limPID.D.x = limPID.D.u;
      else
        limPID.D.y = limPID.D.y_start;
      end if;
    end if;

  // Component limPID
  // class Modelica.Blocks.Continuous.LimPID
  initial equation
    if (limPID.initType == Modelica.Blocks.Types.Init.InitialOutput) then 
      limPID.gainPID.y = limPID.y_start;
    end if;

  // Component senTem
  // class AixLib.Fluid.Sensors.TemperatureTwoPort
  initial equation
    if (senTem.dynamic) then 
      if (senTem.initType == Modelica.Blocks.Types.Init.SteadyState) then 
        der(senTem.T) = 0;
      elseif (senTem.initType == Modelica.Blocks.Types.Init.InitialState or 
        senTem.initType == Modelica.Blocks.Types.Init.InitialOutput) then 
        senTem.T = senTem.T_start;
      end if;
    end if;

  // Component senRelHum
  // class AixLib.Fluid.Sensors.RelativeHumidityTwoPort
  initial equation
    if (senRelHum.dynamic) then 
      if (senRelHum.initType == Modelica.Blocks.Types.Init.SteadyState) then 
        der(senRelHum.phi) = 0;
      elseif (senRelHum.initType == Modelica.Blocks.Types.Init.InitialState or 
        senRelHum.initType == Modelica.Blocks.Types.Init.InitialOutput) then 
        senRelHum.phi = senRelHum.phi_start;
      end if;
    end if;

  // Component hum.vol.dynBal
  // class Buildings.Fluid.Interfaces.ConservationEquation
    // extends Buildings.Fluid.Interfaces.LumpedVolumeDeclarations
    initial equation
      if (hum.vol.dynBal.wrongEnergyMassBalanceConfiguration) then 
        assert( not hum.vol.dynBal.wrongEnergyMassBalanceConfiguration, 
          "In Compressor.hum.vol.dynBal: energyDynamics is selected as steady state, and therefore massDynamics must also be steady-state.");
      end if;
    // end of extends 
  initial equation
    if (hum.vol.dynBal.use_mWat_flow) then 
      assert(false or abs(sum(hum.vol.dynBal.s)-1) < 1E-05, "In Compressor.hum.vol.dynBal:
         If Medium.nXi > 1, then substance 'water' must be present for one component of 'Moist air'.
         Check medium model.");
    end if;
    if (hum.vol.dynBal.energyDynamics == Modelica.Fluid.Types.Dynamics.
      SteadyState) then 
      assert(hum.vol.dynBal.massDynamics == hum.vol.dynBal.energyDynamics, 
        "In Compressor.hum.vol.dynBal:
         If 'massDynamics == Modelica.Fluid.Types.Dynamics.SteadyState', then it is
         required that 'energyDynamics==Modelica.Fluid.Types.Dynamics.SteadyState'.
         Otherwise, the system of equations may not be consistent.
         You need to select other parameter values.");
    end if;
    if (hum.vol.dynBal.energyDynamics == Modelica.Fluid.Types.Dynamics.
      FixedInitial) then 
      hum.vol.dynBal.medium.T = hum.vol.dynBal.T_start;
    else
      if (hum.vol.dynBal.energyDynamics == Modelica.Fluid.Types.Dynamics.
        SteadyStateInitial) then 
        der(hum.vol.dynBal.medium.T) = 0;
      end if;
    end if;
    if (hum.vol.dynBal.massDynamics == Modelica.Fluid.Types.Dynamics.
      FixedInitial) then 
      if (hum.vol.dynBal.initialize_p) then 
        hum.vol.dynBal.medium.p = hum.vol.dynBal.p_start;
      end if;
    else
      if (hum.vol.dynBal.massDynamics == Modelica.Fluid.Types.Dynamics.
        SteadyStateInitial) then 
        if (hum.vol.dynBal.initialize_p) then 
          der(hum.vol.dynBal.medium.p) = 0;
        end if;
      end if;
    end if;
    if (hum.vol.dynBal.substanceDynamics == Modelica.Fluid.Types.Dynamics.
      FixedInitial) then 
      hum.vol.dynBal.medium.Xi = hum.vol.dynBal.X_start[1:1];
    else
      if (hum.vol.dynBal.substanceDynamics == Modelica.Fluid.Types.Dynamics.
        SteadyStateInitial) then 
        der(hum.vol.dynBal.medium.Xi) = zeros(1);
      end if;
    end if;
    if (hum.vol.dynBal.traceDynamics == Modelica.Fluid.Types.Dynamics.
      FixedInitial) then 
      hum.vol.dynBal.C = hum.vol.dynBal.C_start[1:0];
    else
      if (hum.vol.dynBal.traceDynamics == Modelica.Fluid.Types.Dynamics.
        SteadyStateInitial) then 
        der(hum.vol.dynBal.C) = zeros(0);
      end if;
    end if;

  // Component hum.vol
  // class Buildings.Fluid.MixingVolumes.MixingVolumeMoistAir
    // extends Buildings.Fluid.Interfaces.LumpedVolumeDeclarations
    initial equation
      if (hum.vol.wrongEnergyMassBalanceConfiguration) then 
        assert( not hum.vol.wrongEnergyMassBalanceConfiguration, 
          "In Compressor.hum.vol: energyDynamics is selected as steady state, and therefore massDynamics must also be steady-state.");
      end if;
    // end of extends 

  // Component hum.preDro
  // class Buildings.Fluid.FixedResistances.PressureDrop
    // extends Buildings.Fluid.BaseClasses.PartialResistance
    initial equation
      assert(hum.preDro.homotopyInitialization, "In Compressor.hum.preDro: The constant homotopyInitialization has been modified from its default value. This constant will be removed in future releases.",
         AssertionLevel.warning);
    // end of extends 
  initial equation
    if (hum.preDro.computeFlowResistance) then 
      assert(hum.preDro.m_flow_turbulent > 0, "m_flow_turbulent must be bigger than zero.");
    end if;
    assert(hum.preDro.m_flow_nominal_pos > 0, "m_flow_nominal_pos must be non-zero. Check parameters.");

  // Component hum
  // class Buildings.Fluid.Humidifiers.Humidifier_u
    // extends Buildings.Fluid.Interfaces.TwoPortHeatMassExchanger
    initial algorithm
      assert(hum.energyDynamics == Modelica.Fluid.Types.Dynamics.SteadyState or 
        hum.tau > 1E-15, "The parameter tau, or the volume of the model from which tau may be derived, is unreasonably small.
 You need to set energyDynamics == Modelica.Fluid.Types.Dynamics.SteadyState to model steady-state.
 Received tau = "
        +       String(hum.tau, true, 0)+"\n");
      assert(hum.homotopyInitialization, "In Compressor.hum: The constant homotopyInitialization has been modified from its default value. This constant will be removed in future releases.",
         AssertionLevel.warning);
    // end of extends 

end Compressor;
