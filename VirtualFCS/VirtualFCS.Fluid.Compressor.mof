    dCMotorControlCompressor.armatureInverter.vMotSensor.v = dCMotorControlCompressor.armatureInverter.vMotSensor.p.v
      -dCMotorControlCompressor.armatureInverter.vMotSensor.n.v;

  // Component dCMotorControlCompressor.armatureInverter.vMotFilter
