  Modelica.Media.Interfaces.Types.MassFraction hum.vol.dynBal.medium.X_steam 
    "Mass fraction of steam water";
  Modelica.Media.Interfaces.Types.MassFraction hum.vol.dynBal.medium.X_air 
    "Mass fraction of air";
  Modelica.Media.Interfaces.Types.MassFraction hum.vol.dynBal.medium.X_sat 
    "Steam water mass fraction of saturation boundary in kg_water/kg_moistair";
  Modelica.Media.Interfaces.Types.MassFraction hum.vol.dynBal.medium.x_sat 
    "Steam water mass content of saturation boundary in kg_water/kg_dryair";
  Modelica.Media.Interfaces.Types.AbsolutePressure hum.vol.dynBal.medium.p_steam_sat
    (start = system.p_start) "Partial saturation pressure of steam";
  Modelica.Units.SI.Energy hum.vol.dynBal.U(start = hum.vol.dynBal.fluidVolume*
    hum.vol.dynBal.rho_start*hum.vol.dynBal.specificInternalEnergy_Unique194(
    hum.vol.dynBal.setState_pTX_Unique187(hum.vol.dynBal.p_start, 
      hum.vol.dynBal.T_start, hum.vol.dynBal.X_start[1:1]))+(hum.vol.dynBal.T_start
    -298.15)*hum.vol.dynBal.CSen, nominal = 100000.0) "Internal energy of fluid";
  Modelica.Units.SI.Mass hum.vol.dynBal.m(start = hum.vol.V*hum.vol.rho_start, 
    stateSelect = StateSelect.prefer) "Mass of fluid";
  Modelica.Units.SI.Mass hum.vol.dynBal.mXi[1](start = hum.vol.dynBal.fluidVolume
    *hum.vol.dynBal.rho_start*hum.vol.dynBal.X_start[1:1], stateSelect = 
    StateSelect.never) "Masses of independent components in the fluid";
  Modelica.Units.SI.Mass hum.vol.dynBal.mC[0](start = hum.vol.dynBal.fluidVolume
    *hum.vol.dynBal.rho_start*hum.vol.dynBal.C_start) "Masses of trace substances in the fluid";
  Modelica.Media.Interfaces.Types.ExtraProperty hum.vol.dynBal.C[0](start = fill
    (1.0, size(hum.vol.dynBal.C, 1))) "Trace substance mixture content";
  Modelica.Units.SI.MassFlowRate hum.vol.dynBal.mb_flow "Mass flows across boundaries";
  Modelica.Units.SI.MassFlowRate hum.vol.dynBal.mbXi_flow[1] "Substance mass flows across boundaries";
  Modelica.Media.Interfaces.Types.ExtraPropertyFlowRate hum.vol.dynBal.mbC_flow[0]
     "Trace substance mass flows across boundaries";
  Modelica.Units.SI.EnthalpyFlowRate hum.vol.dynBal.Hb_flow "Enthalpy flow across boundaries or energy source/sink";
  Modelica.Media.Interfaces.Types.EnthalpyFlowRate hum.vol.dynBal.ports_H_flow[
    hum.vol.dynBal.nPorts];
  Modelica.Units.SI.MassFlowRate hum.vol.dynBal.ports_mXi_flow[hum.vol.dynBal.nPorts,
     1];
  Modelica.Media.Interfaces.Types.ExtraPropertyFlowRate hum.vol.dynBal.ports_mC_flow
    [hum.vol.dynBal.nPorts, 0];
  Modelica.Blocks.Interfaces.RealInput hum.vol.dynBal.mWat_flow_internal(unit = 
    "kg/s") "Needed to connect to conditional connector";
  Modelica.Blocks.Interfaces.RealInput hum.vol.dynBal.C_flow_internal[0] 
    "Needed to connect to conditional connector";
  Modelica.Media.Interfaces.PartialMedium.MassFlowRate hum.preDro.port_a.m_flow(
    min = -1E+60) "Mass flow rate from the connection point into the component";
  Modelica.Media.Interfaces.Types.AbsolutePressure hum.preDro.port_a.p(start = 101325)
     "Thermodynamic pressure in the connection point";
  Modelica.Media.Interfaces.Types.SpecificEnthalpy hum.preDro.port_a.h_outflow(
    start = hum.preDro.specificEnthalpy_pTX_Unique141(101325, 293.15, {0.01, 
    0.99})) "Specific thermodynamic enthalpy close to the connection point if m_flow < 0";
  Modelica.Media.Interfaces.Types.MassFraction hum.preDro.port_a.Xi_outflow[1] 
    "Independent mixture mass fractions m_i/m close to the connection point if m_flow < 0";
  Modelica.Media.Interfaces.Types.ExtraProperty hum.preDro.port_a.C_outflow[0](
    start = fill(1.0, size(hum.preDro.port_a.C_outflow, 1))) "Properties c_i/m close to the connection point if m_flow < 0";
  Modelica.Media.Interfaces.PartialMedium.MassFlowRate hum.preDro.port_b.m_flow(
    max = 1E+60) "Mass flow rate from the connection point into the component";
  Modelica.Media.Interfaces.Types.AbsolutePressure hum.preDro.port_b.p(start = 101325)
     "Thermodynamic pressure in the connection point";
  Modelica.Media.Interfaces.Types.SpecificEnthalpy hum.preDro.port_b.h_outflow(
    start = hum.preDro.specificEnthalpy_pTX_Unique141(101325, 293.15, {0.01, 
    0.99})) "Specific thermodynamic enthalpy close to the connection point if m_flow < 0";
  Modelica.Media.Interfaces.Types.MassFraction hum.preDro.port_b.Xi_outflow[1] 
    "Independent mixture mass fractions m_i/m close to the connection point if m_flow < 0";
  Modelica.Media.Interfaces.Types.ExtraProperty hum.preDro.port_b.C_outflow[0](
    start = fill(1.0, size(hum.preDro.port_b.C_outflow, 1))) "Properties c_i/m close to the connection point if m_flow < 0";
  Modelica.Units.SI.MassFlowRate hum.preDro.m_flow(start = hum.preDro._m_flow_start,
     nominal = 0.1) = hum.preDro.port_a.m_flow "Mass flow rate from port_a to port_b (m_flow > 0 is design flow direction)";
  Modelica.Units.SI.PressureDifference hum.preDro.dp(start = hum.preDro._dp_start,
     nominal = 1200.0, displayUnit = "Pa") = hum.preDro.port_a.p-
    hum.preDro.port_b.p "Pressure difference between port_a and port_b";
  Modelica.Blocks.Interfaces.RealInput hum.u(unit = "1") "Control input";
  Modelica.Blocks.Interfaces.RealOutput hum.mWat_flow(unit = "kg/s") 
    "Water added to the fluid";
  Modelica.Units.SI.Temperature hum.heatPort.T "Port temperature";
  Modelica.Units.SI.HeatFlowRate hum.heatPort.Q_flow "Heat flow rate (positive if flowing from outside into the component)";
  Modelica.Blocks.Interfaces.RealInput hum.gai.u "Input signal connector";
  Modelica.Blocks.Interfaces.RealOutput hum.gai.y "Output signal connector";

// Equations and algorithms

  // Component gain1
  // class Modelica.Blocks.Math.Gain
  equation
    gain1.y = gain1.k*gain1.u;

  // Component dCMotorControlCompressor.armatureInverter.vDCSensor
  // class Modelica.Electrical.Analog.Sensors.VoltageSensor
  equation
    dCMotorControlCompressor.armatureInverter.vDCSensor.p.i = 0;
    dCMotorControlCompressor.armatureInverter.vDCSensor.n.i = 0;
    dCMotorControlCompressor.armatureInverter.vDCSensor.v = dCMotorControlCompressor.armatureInverter.vDCSensor.p.v
      -dCMotorControlCompressor.armatureInverter.vDCSensor.n.v;

  // Component dCMotorControlCompressor.armatureInverter.iMotSensor
  // class Modelica.Electrical.Analog.Sensors.CurrentSensor
  equation
    dCMotorControlCompressor.armatureInverter.iMotSensor.p.v = dCMotorControlCompressor.armatureInverter.iMotSensor.n.v;
    dCMotorControlCompressor.armatureInverter.iMotSensor.p.i = dCMotorControlCompressor.armatureInverter.iMotSensor.i;
    dCMotorControlCompressor.armatureInverter.iMotSensor.n.i =  -
      dCMotorControlCompressor.armatureInverter.iMotSensor.i;

  // Component dCMotorControlCompressor.armatureInverter.variableLimiter
  // class Modelica.Blocks.Nonlinear.VariableLimiter
  equation
    assert(dCMotorControlCompressor.armatureInverter.variableLimiter.limit1 >= 
      dCMotorControlCompressor.armatureInverter.variableLimiter.limit2, 
      "Input signals are not consistent: limit1 < limit2");
    dCMotorControlCompressor.armatureInverter.variableLimiter.simplifiedExpr = (
      if dCMotorControlCompressor.armatureInverter.variableLimiter.homotopyType
       == Modelica.Blocks.Types.VariableLimiterHomotopy.Linear then 
      dCMotorControlCompressor.armatureInverter.variableLimiter.u else (if 
      dCMotorControlCompressor.armatureInverter.variableLimiter.homotopyType == 
      Modelica.Blocks.Types.VariableLimiterHomotopy.Fixed then dCMotorControlCompressor.armatureInverter.variableLimiter.ySimplified
       else 0));
    if (dCMotorControlCompressor.armatureInverter.variableLimiter.strict) then 
      if (dCMotorControlCompressor.armatureInverter.variableLimiter.homotopyType
         == Modelica.Blocks.Types.VariableLimiterHomotopy.NoHomotopy) then 
        dCMotorControlCompressor.armatureInverter.variableLimiter.y = smooth(0, 
          noEvent((if dCMotorControlCompressor.armatureInverter.variableLimiter.u
           > dCMotorControlCompressor.armatureInverter.variableLimiter.limit1
           then dCMotorControlCompressor.armatureInverter.variableLimiter.limit1
           else (if dCMotorControlCompressor.armatureInverter.variableLimiter.u
           < dCMotorControlCompressor.armatureInverter.variableLimiter.limit2
           then dCMotorControlCompressor.armatureInverter.variableLimiter.limit2
           else dCMotorControlCompressor.armatureInverter.variableLimiter.u))));
      else
        dCMotorControlCompressor.armatureInverter.variableLimiter.y = homotopy(
          smooth(0, noEvent((if dCMotorControlCompressor.armatureInverter.variableLimiter.u
           > dCMotorControlCompressor.armatureInverter.variableLimiter.limit1
           then dCMotorControlCompressor.armatureInverter.variableLimiter.limit1
           else (if dCMotorControlCompressor.armatureInverter.variableLimiter.u
           < dCMotorControlCompressor.armatureInverter.variableLimiter.limit2
           then dCMotorControlCompressor.armatureInverter.variableLimiter.limit2
           else dCMotorControlCompressor.armatureInverter.variableLimiter.u)))),
           dCMotorControlCompressor.armatureInverter.variableLimiter.simplifiedExpr);
      end if;
    else
      if (dCMotorControlCompressor.armatureInverter.variableLimiter.homotopyType
         == Modelica.Blocks.Types.VariableLimiterHomotopy.NoHomotopy) then 
        dCMotorControlCompressor.armatureInverter.variableLimiter.y = smooth(0, 
          (if dCMotorControlCompressor.armatureInverter.variableLimiter.u > 
          dCMotorControlCompressor.armatureInverter.variableLimiter.limit1 then 
          dCMotorControlCompressor.armatureInverter.variableLimiter.limit1 else 
          (if dCMotorControlCompressor.armatureInverter.variableLimiter.u < 
          dCMotorControlCompressor.armatureInverter.variableLimiter.limit2 then 
          dCMotorControlCompressor.armatureInverter.variableLimiter.limit2 else 
          dCMotorControlCompressor.armatureInverter.variableLimiter.u)));
      else
        dCMotorControlCompressor.armatureInverter.variableLimiter.y = homotopy(
          smooth(0, (if dCMotorControlCompressor.armatureInverter.variableLimiter.u
           > dCMotorControlCompressor.armatureInverter.variableLimiter.limit1
           then dCMotorControlCompressor.armatureInverter.variableLimiter.limit1
           else (if dCMotorControlCompressor.armatureInverter.variableLimiter.u
           < dCMotorControlCompressor.armatureInverter.variableLimiter.limit2
           then dCMotorControlCompressor.armatureInverter.variableLimiter.limit2
           else dCMotorControlCompressor.armatureInverter.variableLimiter.u))), 
          dCMotorControlCompressor.armatureInverter.variableLimiter.simplifiedExpr);
      end if;
    end if;

  // Component dCMotorControlCompressor.armatureInverter.gain
  // class Modelica.Blocks.Math.Gain
  equation
    dCMotorControlCompressor.armatureInverter.gain.y = dCMotorControlCompressor.armatureInverter.gain.k
      *dCMotorControlCompressor.armatureInverter.gain.u;

  // Component dCMotorControlCompressor.armatureInverter.vDCFilter
  // class Modelica.Blocks.Continuous.FirstOrder
  equation
    der(dCMotorControlCompressor.armatureInverter.vDCFilter.y) = (
      dCMotorControlCompressor.armatureInverter.vDCFilter.k*dCMotorControlCompressor.armatureInverter.vDCFilter.u
      -dCMotorControlCompressor.armatureInverter.vDCFilter.y)/dCMotorControlCompressor.armatureInverter.vDCFilter.T;

  // Component dCMotorControlCompressor.armatureInverter.iMotFilter
  // class Modelica.Blocks.Continuous.FirstOrder
  equation
    der(dCMotorControlCompressor.armatureInverter.iMotFilter.y) = (
      dCMotorControlCompressor.armatureInverter.iMotFilter.k*dCMotorControlCompressor.armatureInverter.iMotFilter.u
      -dCMotorControlCompressor.armatureInverter.iMotFilter.y)/dCMotorControlCompressor.armatureInverter.iMotFilter.T;

  // Component dCMotorControlCompressor.armatureInverter.idealDcDc.signalVoltage
  // class Modelica.Electrical.Analog.Sources.SignalVoltage
  equation
    dCMotorControlCompressor.armatureInverter.idealDcDc.signalVoltage.v = 
      dCMotorControlCompressor.armatureInverter.idealDcDc.signalVoltage.p.v-
      dCMotorControlCompressor.armatureInverter.idealDcDc.signalVoltage.n.v;
    0 = dCMotorControlCompressor.armatureInverter.idealDcDc.signalVoltage.p.i+
      dCMotorControlCompressor.armatureInverter.idealDcDc.signalVoltage.n.i;
    dCMotorControlCompressor.armatureInverter.idealDcDc.signalVoltage.i = 
      dCMotorControlCompressor.armatureInverter.idealDcDc.signalVoltage.p.i;

  // Component dCMotorControlCompressor.armatureInverter.idealDcDc.signalCurrent
  // class Modelica.Electrical.Analog.Sources.SignalCurrent
  equation
    dCMotorControlCompressor.armatureInverter.idealDcDc.signalCurrent.v = 
      dCMotorControlCompressor.armatureInverter.idealDcDc.signalCurrent.p.v-
      dCMotorControlCompressor.armatureInverter.idealDcDc.signalCurrent.n.v;
    0 = dCMotorControlCompressor.armatureInverter.idealDcDc.signalCurrent.p.i+
      dCMotorControlCompressor.armatureInverter.idealDcDc.signalCurrent.n.i;
    dCMotorControlCompressor.armatureInverter.idealDcDc.signalCurrent.i = 
      dCMotorControlCompressor.armatureInverter.idealDcDc.signalCurrent.p.i;

  // Component dCMotorControlCompressor.armatureInverter.idealDcDc.powerBat.voltageSensor
  // class Modelica.Electrical.Analog.Sensors.VoltageSensor
  equation
    dCMotorControlCompressor.armatureInverter.idealDcDc.powerBat.voltageSensor.p.i
       = 0;
    dCMotorControlCompressor.armatureInverter.idealDcDc.powerBat.voltageSensor.n.i
       = 0;
    dCMotorControlCompressor.armatureInverter.idealDcDc.powerBat.voltageSensor.v
       = dCMotorControlCompressor.armatureInverter.idealDcDc.powerBat.voltageSensor.p.v
      -dCMotorControlCompressor.armatureInverter.idealDcDc.powerBat.voltageSensor.n.v;

  // Component dCMotorControlCompressor.armatureInverter.idealDcDc.powerBat.currentSensor
  // class Modelica.Electrical.Analog.Sensors.CurrentSensor
  equation
    dCMotorControlCompressor.armatureInverter.idealDcDc.powerBat.currentSensor.p.v
       = dCMotorControlCompressor.armatureInverter.idealDcDc.powerBat.currentSensor.n.v;
    dCMotorControlCompressor.armatureInverter.idealDcDc.powerBat.currentSensor.p.i
       = dCMotorControlCompressor.armatureInverter.idealDcDc.powerBat.currentSensor.i;
    dCMotorControlCompressor.armatureInverter.idealDcDc.powerBat.currentSensor.n.i
       =  -dCMotorControlCompressor.armatureInverter.idealDcDc.powerBat.currentSensor.i;

  // Component dCMotorControlCompressor.armatureInverter.idealDcDc.powerBat.product
  // class Modelica.Blocks.Math.Product
  equation
    dCMotorControlCompressor.armatureInverter.idealDcDc.powerBat.product.y = 
      dCMotorControlCompressor.armatureInverter.idealDcDc.powerBat.product.u1*
      dCMotorControlCompressor.armatureInverter.idealDcDc.powerBat.product.u2;

  // Component dCMotorControlCompressor.armatureInverter.idealDcDc.powerBat
  // class Modelica.Electrical.Analog.Sensors.PowerSensor
  equation
    dCMotorControlCompressor.armatureInverter.idealDcDc.powerBat.product.u2 = 
      dCMotorControlCompressor.armatureInverter.idealDcDc.powerBat.currentSensor.i;
    dCMotorControlCompressor.armatureInverter.idealDcDc.powerBat.nc.i-
      dCMotorControlCompressor.armatureInverter.idealDcDc.powerBat.currentSensor.n.i
       = 0.0;
    dCMotorControlCompressor.armatureInverter.idealDcDc.powerBat.nc.v = 
      dCMotorControlCompressor.armatureInverter.idealDcDc.powerBat.currentSensor.n.v;
    dCMotorControlCompressor.armatureInverter.idealDcDc.powerBat.pc.i-
      dCMotorControlCompressor.armatureInverter.idealDcDc.powerBat.currentSensor.p.i
       = 0.0;
    dCMotorControlCompressor.armatureInverter.idealDcDc.powerBat.pc.v = 
      dCMotorControlCompressor.armatureInverter.idealDcDc.powerBat.currentSensor.p.v;
    dCMotorControlCompressor.armatureInverter.idealDcDc.powerBat.nv.i-
      dCMotorControlCompressor.armatureInverter.idealDcDc.powerBat.voltageSensor.n.i
       = 0.0;
    dCMotorControlCompressor.armatureInverter.idealDcDc.powerBat.voltageSensor.n.v
       = dCMotorControlCompressor.armatureInverter.idealDcDc.powerBat.nv.v;
    dCMotorControlCompressor.armatureInverter.idealDcDc.powerBat.product.y = 
      dCMotorControlCompressor.armatureInverter.idealDcDc.powerBat.power;
    dCMotorControlCompressor.armatureInverter.idealDcDc.powerBat.voltageSensor.v
       = dCMotorControlCompressor.armatureInverter.idealDcDc.powerBat.product.u1;
    dCMotorControlCompressor.armatureInverter.idealDcDc.powerBat.pv.i-
      dCMotorControlCompressor.armatureInverter.idealDcDc.powerBat.voltageSensor.p.i
       = 0.0;
    dCMotorControlCompressor.armatureInverter.idealDcDc.powerBat.voltageSensor.p.v
       = dCMotorControlCompressor.armatureInverter.idealDcDc.powerBat.pv.v;

  // Component dCMotorControlCompressor.armatureInverter.idealDcDc.powerMot.voltageSensor
  // class Modelica.Electrical.Analog.Sensors.VoltageSensor
  equation
    dCMotorControlCompressor.armatureInverter.idealDcDc.powerMot.voltageSensor.p.i
       = 0;
    dCMotorControlCompressor.armatureInverter.idealDcDc.powerMot.voltageSensor.n.i
       = 0;
    dCMotorControlCompressor.armatureInverter.idealDcDc.powerMot.voltageSensor.v
       = dCMotorControlCompressor.armatureInverter.idealDcDc.powerMot.voltageSensor.p.v
      -dCMotorControlCompressor.armatureInverter.idealDcDc.powerMot.voltageSensor.n.v;

  // Component dCMotorControlCompressor.armatureInverter.idealDcDc.powerMot.currentSensor
  // class Modelica.Electrical.Analog.Sensors.CurrentSensor
  equation
    dCMotorControlCompressor.armatureInverter.idealDcDc.powerMot.currentSensor.p.v
       = dCMotorControlCompressor.armatureInverter.idealDcDc.powerMot.currentSensor.n.v;
    dCMotorControlCompressor.armatureInverter.idealDcDc.powerMot.currentSensor.p.i
       = dCMotorControlCompressor.armatureInverter.idealDcDc.powerMot.currentSensor.i;
    dCMotorControlCompressor.armatureInverter.idealDcDc.powerMot.currentSensor.n.i
       =  -dCMotorControlCompressor.armatureInverter.idealDcDc.powerMot.currentSensor.i;

  // Component dCMotorControlCompressor.armatureInverter.idealDcDc.powerMot.product
  // class Modelica.Blocks.Math.Product
  equation
    dCMotorControlCompressor.armatureInverter.idealDcDc.powerMot.product.y = 
      dCMotorControlCompressor.armatureInverter.idealDcDc.powerMot.product.u1*
      dCMotorControlCompressor.armatureInverter.idealDcDc.powerMot.product.u2;

  // Component dCMotorControlCompressor.armatureInverter.idealDcDc.powerMot
  // class Modelica.Electrical.Analog.Sensors.PowerSensor
  equation
    dCMotorControlCompressor.armatureInverter.idealDcDc.powerMot.product.u2 = 
      dCMotorControlCompressor.armatureInverter.idealDcDc.powerMot.currentSensor.i;
    dCMotorControlCompressor.armatureInverter.idealDcDc.powerMot.nc.i-
      dCMotorControlCompressor.armatureInverter.idealDcDc.powerMot.currentSensor.n.i
       = 0.0;
    dCMotorControlCompressor.armatureInverter.idealDcDc.powerMot.nc.v = 
      dCMotorControlCompressor.armatureInverter.idealDcDc.powerMot.currentSensor.n.v;
    dCMotorControlCompressor.armatureInverter.idealDcDc.powerMot.pc.i-
      dCMotorControlCompressor.armatureInverter.idealDcDc.powerMot.currentSensor.p.i
       = 0.0;
    dCMotorControlCompressor.armatureInverter.idealDcDc.powerMot.pc.v = 
      dCMotorControlCompressor.armatureInverter.idealDcDc.powerMot.currentSensor.p.v;
    dCMotorControlCompressor.armatureInverter.idealDcDc.powerMot.nv.i-
      dCMotorControlCompressor.armatureInverter.idealDcDc.powerMot.voltageSensor.n.i
       = 0.0;
    dCMotorControlCompressor.armatureInverter.idealDcDc.powerMot.voltageSensor.n.v
       = dCMotorControlCompressor.armatureInverter.idealDcDc.powerMot.nv.v;
    dCMotorControlCompressor.armatureInverter.idealDcDc.powerMot.product.y = 
      dCMotorControlCompressor.armatureInverter.idealDcDc.powerMot.power;
    dCMotorControlCompressor.armatureInverter.idealDcDc.powerMot.voltageSensor.v
       = dCMotorControlCompressor.armatureInverter.idealDcDc.powerMot.product.u1;
    dCMotorControlCompressor.armatureInverter.idealDcDc.powerMot.pv.i-
      dCMotorControlCompressor.armatureInverter.idealDcDc.powerMot.voltageSensor.p.i
       = 0.0;
    dCMotorControlCompressor.armatureInverter.idealDcDc.powerMot.voltageSensor.p.v
       = dCMotorControlCompressor.armatureInverter.idealDcDc.powerMot.pv.v;

  // Component dCMotorControlCompressor.armatureInverter.idealDcDc.deadTime
  // class Modelica.Blocks.Continuous.FirstOrder
  equation
    der(dCMotorControlCompressor.armatureInverter.idealDcDc.deadTime.y) = (
      dCMotorControlCompressor.armatureInverter.idealDcDc.deadTime.k*
      dCMotorControlCompressor.armatureInverter.idealDcDc.deadTime.u-
      dCMotorControlCompressor.armatureInverter.idealDcDc.deadTime.y)/
      dCMotorControlCompressor.armatureInverter.idealDcDc.deadTime.T;

  // Component dCMotorControlCompressor.armatureInverter.idealDcDc.feedback
  // class Modelica.Blocks.Math.Feedback
  equation
    dCMotorControlCompressor.armatureInverter.idealDcDc.feedback.y = 
      dCMotorControlCompressor.armatureInverter.idealDcDc.feedback.u1-
      dCMotorControlCompressor.armatureInverter.idealDcDc.feedback.u2;

  // Component dCMotorControlCompressor.armatureInverter.idealDcDc.powerController
  // class Modelica.Blocks.Continuous.Integrator
  equation
    dCMotorControlCompressor.armatureInverter.idealDcDc.powerController.local_reset
       = false;
    dCMotorControlCompressor.armatureInverter.idealDcDc.powerController.local_set
       = 0;
    der(dCMotorControlCompressor.armatureInverter.idealDcDc.powerController.y)
       = dCMotorControlCompressor.armatureInverter.idealDcDc.powerController.k*
      dCMotorControlCompressor.armatureInverter.idealDcDc.powerController.u;

  // Component dCMotorControlCompressor.armatureInverter.idealDcDc.groundMotor
  // class Modelica.Electrical.Analog.Basic.Ground
  equation
    dCMotorControlCompressor.armatureInverter.idealDcDc.groundMotor.p.v = 0;

  // Component dCMotorControlCompressor.armatureInverter.idealDcDc
  // class Modelica.Electrical.Machines.Examples.ControlledDCDrives.Utilities.IdealDcDc
  equation
    dCMotorControlCompressor.armatureInverter.idealDcDc.vRef = dCMotorControlCompressor.armatureInverter.idealDcDc.deadTime.u;
    dCMotorControlCompressor.armatureInverter.idealDcDc.signalVoltage.v = 
      dCMotorControlCompressor.armatureInverter.idealDcDc.deadTime.y;
    dCMotorControlCompressor.armatureInverter.idealDcDc.powerMot.power = 
      dCMotorControlCompressor.armatureInverter.idealDcDc.feedback.u1;
    dCMotorControlCompressor.armatureInverter.idealDcDc.powerBat.power = 
      dCMotorControlCompressor.armatureInverter.idealDcDc.feedback.u2;
    dCMotorControlCompressor.armatureInverter.idealDcDc.powerController.u = 
      dCMotorControlCompressor.armatureInverter.idealDcDc.feedback.y;
    dCMotorControlCompressor.armatureInverter.idealDcDc.pin_nMot.i-
      dCMotorControlCompressor.armatureInverter.idealDcDc.groundMotor.p.i-
      dCMotorControlCompressor.armatureInverter.idealDcDc.powerMot.nv.i-
      dCMotorControlCompressor.armatureInverter.idealDcDc.signalVoltage.n.i = 
      0.0;
    dCMotorControlCompressor.armatureInverter.idealDcDc.pin_nMot.v = 
      dCMotorControlCompressor.armatureInverter.idealDcDc.groundMotor.p.v;
    dCMotorControlCompressor.armatureInverter.idealDcDc.powerMot.nv.v = 
      dCMotorControlCompressor.armatureInverter.idealDcDc.groundMotor.p.v;
    dCMotorControlCompressor.armatureInverter.idealDcDc.signalVoltage.n.v = 
      dCMotorControlCompressor.armatureInverter.idealDcDc.groundMotor.p.v;
    dCMotorControlCompressor.armatureInverter.idealDcDc.pin_nBat.i-
      dCMotorControlCompressor.armatureInverter.idealDcDc.powerBat.nv.i-
