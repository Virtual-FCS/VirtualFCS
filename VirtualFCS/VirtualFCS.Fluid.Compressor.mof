  parameter Modelica.Units.SI.Voltage dcpm.coreParameters.VRef(min = 1E-60) 
    "Reference inner RMS voltage that reference core losses PRef refer to";
  parameter Modelica.Units.SI.AngularVelocity dcpm.coreParameters.wRef(min = 
    1E-60) "Reference angular velocity that reference core losses PRef refer to";
  parameter Real dcpm.coreParameters.ratioHysteresis(min = 0.0, max = 1.0) = 
    0.775 "Ratio of hysteresis losses with respect to the total core losses at VRef and fRef";
  parameter Modelica.Units.SI.Conductance dcpm.coreParameters.GcRef 
    "Reference conductance at reference frequency and voltage";
  parameter Modelica.Units.SI.AngularVelocity dcpm.coreParameters.wMin 
    "Angular velocity limit";
  parameter Modelica.Units.SI.Power dcpm.strayLoadParameters.PRef(min = 0.0) 
    "Reference stray load losses at IRef and wRef";
  parameter Modelica.Units.SI.Current dcpm.strayLoadParameters.IRef(min = 1E-60)
     "Reference RMS current that PRef refers to";
  parameter Modelica.Units.SI.AngularVelocity dcpm.strayLoadParameters.wRef(
    displayUnit = "rev/min", min = 1E-60) "Reference angular velocity that PRef refers to";
  parameter Real dcpm.strayLoadParameters.power_w(min = 1E-60) "Exponent of stray load loss torque w.r.t. angular velocity";
  parameter Modelica.Units.SI.Torque dcpm.strayLoadParameters.tauRef 
    "Reference stray load torque at reference angular velocity and reference current";
  parameter Modelica.Units.SI.Voltage dcpm.brushParameters.V "Total voltage drop of brushes for currents > ILinear";
  parameter Modelica.Units.SI.Current dcpm.brushParameters.ILinear = 0.01 
    "Current indicating linear voltage region of brush voltage drop";
  parameter Modelica.Units.SI.Resistance dcpm.ra.R(start = 1) = dcpm.Ra 
    "Resistance at temperature T_ref";
  parameter Modelica.Units.SI.Temperature dcpm.ra.T_ref = dcpm.TaRef 
    "Reference temperature";
  parameter Modelica.Units.SI.LinearTemperatureCoefficient dcpm.ra.alpha = 
    Modelica.Electrical.Machines.Thermal.convertAlpha(dcpm.alpha20a, dcpm.TaRef,
     293.15) "Temperature coefficient of resistance (R_actual = R*(1 + alpha*(T_heatPort - T_ref))";
  constant Boolean dcpm.ra.useHeatPort = true "= true, if heatPort is enabled";
  parameter Modelica.Units.SI.Temperature dcpm.ra.T = dcpm.ra.T_ref 
    "Fixed device temperature if useHeatPort = false";
  parameter Modelica.Units.SI.Inductance dcpm.la.L(start = 1) = dcpm.La 
    "Inductance";
  parameter Boolean dcpm.la.quasiStatic(start = false) = dcpm.quasiStatic 
    "No electrical transients if true";
  parameter Modelica.Units.SI.Voltage dcpm.brush.brushParameters.V 
    "Total voltage drop of brushes for currents > ILinear";
  parameter Modelica.Units.SI.Current dcpm.brush.brushParameters.ILinear = 0.01 
    "Current indicating linear voltage region of brush voltage drop";
  constant Boolean dcpm.brush.useHeatPort = true "= true, if heatPort is enabled";
  parameter Integer dcpm.core.coreParameters.m "Number of phases (1 for DC, 3 for induction machines)";
  parameter Modelica.Units.SI.Power dcpm.core.coreParameters.PRef(min = 0.0) 
    "Reference core losses at reference inner voltage VRef";
  parameter Modelica.Units.SI.Voltage dcpm.core.coreParameters.VRef(min = 1E-60)
     "Reference inner RMS voltage that reference core losses PRef refer to";
  parameter Modelica.Units.SI.AngularVelocity dcpm.core.coreParameters.wRef(
    min = 1E-60) "Reference angular velocity that reference core losses PRef refer to";
  parameter Real dcpm.core.coreParameters.ratioHysteresis(min = 0.0, max = 1.0)
     = 0.775 "Ratio of hysteresis losses with respect to the total core losses at VRef and fRef";
  parameter Modelica.Units.SI.Conductance dcpm.core.coreParameters.GcRef 
    "Reference conductance at reference frequency and voltage";
  parameter Modelica.Units.SI.AngularVelocity dcpm.core.coreParameters.wMin 
    "Angular velocity limit";
  constant Boolean dcpm.core.useHeatPort = true "= true, if heatPort is enabled";
  parameter Modelica.Units.SI.Power dcpm.strayLoad.strayLoadParameters.PRef(
    min = 0.0) "Reference stray load losses at IRef and wRef";
  parameter Modelica.Units.SI.Current dcpm.strayLoad.strayLoadParameters.IRef(
    min = 1E-60) "Reference RMS current that PRef refers to";
  parameter Modelica.Units.SI.AngularVelocity dcpm.strayLoad.strayLoadParameters.wRef
    (displayUnit = "rev/min", min = 1E-60) "Reference angular velocity that PRef refers to";
  parameter Real dcpm.strayLoad.strayLoadParameters.power_w(min = 1E-60) 
    "Exponent of stray load loss torque w.r.t. angular velocity";
  parameter Modelica.Units.SI.Torque dcpm.strayLoad.strayLoadParameters.tauRef 
    "Reference stray load torque at reference angular velocity and reference current";
  constant Boolean dcpm.strayLoad.useHeatPort = true "= true, if heatPort is enabled";
  constant Boolean dcpm.thermalAmbient.useTemperatureInputs = false 
    "If true, temperature inputs are used; else, temperatures are constant";
  constant Modelica.Units.SI.Temperature dcpm.thermalAmbient.TDefault = 293.15 
    "Default temperature";
  parameter Modelica.Units.SI.Temperature dcpm.thermalAmbient.Ta(start = 
    dcpm.thermalAmbient.TDefault) = dcpm.TaOperational "Temperature of armature";
  parameter Modelica.Units.SI.Temperature dcpm.thermalAmbient.temperatureCore.T
     = dcpm.thermalAmbient.TDefault "Fixed temperature at port";
  parameter Modelica.Units.SI.Temperature dcpm.thermalAmbient.temperatureStrayLoad.T
     = dcpm.thermalAmbient.TDefault "Fixed temperature at port";
  parameter Modelica.Units.SI.Temperature dcpm.thermalAmbient.temperatureFriction.T
     = dcpm.thermalAmbient.TDefault "Fixed temperature at port";
  parameter Real dcpm.thermalAmbient.constTa.k(start = 1) = dcpm.thermalAmbient.Ta
     "Constant output value";
  parameter Modelica.Units.SI.Temperature dcpm.thermalAmbient.temperatureBrush.T
     = dcpm.thermalAmbient.TDefault "Fixed temperature at port";
  parameter Modelica.Units.SI.Temperature dcpm.thermalAmbient.Tpm(start = 
    dcpm.thermalAmbient.TDefault) = dcpm.TpmOperational "Temperature of permanent magnet";
  parameter Real dcpm.thermalAmbient.constTpm.k(start = 1) = dcpm.thermalAmbient.Tpm
     "Constant output value";
  constant Real dcpm.pi = 3.141592653589793;
  constant Boolean dcpm.quasiStatic = false "No electrical transients if true";
  parameter Modelica.Units.SI.Voltage dcpm.ViNominal = dcpm.VaNominal-
    Modelica.Electrical.Machines.Thermal.convertResistance(dcpm.Ra, dcpm.TaRef, 
    dcpm.alpha20a, dcpm.TaNominal)*dcpm.IaNominal-Modelica.Electrical.Machines.Losses.DCMachines.brushVoltageDrop
    (
    dcpm.brushParameters, 
    dcpm.IaNominal) "Nominal induced Voltage";
  parameter Modelica.Units.SI.MagneticFlux dcpm.psi_eNominal = dcpm.Lme*
    dcpm.IeNominal "Nominal magnetic flux";
  parameter Real dcpm.turnsRatio = dcpm.ViNominal/(dcpm.wNominal*
    dcpm.psi_eNominal) "Ratio of armature turns over number of turns of the excitation winding";
  parameter Modelica.Units.SI.Temperature dcpm.TpmOperational = 293.15 
    "Operational temperature of permanent magnet";
  parameter Boolean dcpm.airGapDC.quasiStatic(start = false) = dcpm.quasiStatic 
    "No electrical transients if true";
  parameter Real dcpm.airGapDC.turnsRatio = dcpm.turnsRatio "Ratio of armature turns over number of turns of the excitation winding";
  parameter Modelica.Units.SI.Inductance dcpm.airGapDC.Le = dcpm.Lme 
    "Excitation inductance";
  parameter Modelica.Units.SI.Current dcpm.ie.I(start = 1) = dcpm.IeNominal 
    "Value of constant current";
  constant Modelica.Units.SI.Inductance dcpm.Lme = 1 "Field excitation inductance";
  constant Modelica.Units.SI.Current dcpm.IeNominal = 1 "Equivalent excitation current";
  parameter Modelica.Units.SI.Inertia inertia.J(start = 1, min = 0.0) = 0.15 
    "Moment of inertia";
  constant StateSelect inertia.stateSelect = StateSelect.default 
    "Priority to use phi and w as states";
  parameter Modelica.Units.SI.Inertia driveData.motorData.Jr = 0.15 
    "Rotor's moment of inertia";
  parameter Modelica.Units.SI.Inertia driveData.motorData.Js = 0.15 
    "Stator's moment of inertia";
  parameter Modelica.Units.SI.Voltage driveData.motorData.VaNominal = 24 
    "Nominal armature voltage";
  parameter Modelica.Units.SI.Current driveData.motorData.IaNominal = 100 
    "Nominal armature current (>0..Motor, <0..Generator)";
  parameter Modelica.Units.SI.AngularVelocity driveData.motorData.wNominal = 
    149.22565104551515 "Nominal speed";
  parameter Modelica.Units.SI.Temperature driveData.motorData.TaNominal = 293.15
     "Nominal armature temperature";
  parameter Modelica.Units.SI.Resistance driveData.motorData.Ra = 0.05 
    "Armature resistance at TRef";
  parameter Modelica.Units.SI.Temperature driveData.motorData.TaRef = 293.15 
    "Reference temperature of armature resistance";
  parameter Modelica.Electrical.Machines.Thermal.LinearTemperatureCoefficient20 
    driveData.motorData.alpha20a = 0 "Temperature coefficient of armature resistance";
  parameter Modelica.Units.SI.Inductance driveData.motorData.La = 0.0015 
    "Armature inductance";
  parameter Modelica.Units.SI.Power driveData.motorData.frictionParameters.PRef(
    min = 0.0) = 0 "Reference friction losses at wRef";
  parameter Modelica.Units.SI.AngularVelocity driveData.motorData.frictionParameters.wRef
    (displayUnit = "rev/min", min = 1E-60) = driveData.motorData.wNominal 
    "Reference angular velocity that the PRef refer to";
  parameter Real driveData.motorData.frictionParameters.power_w(min = 1E-60) = 2
     "Exponent of friction torque w.r.t. angular velocity";
  parameter Modelica.Units.SI.Torque driveData.motorData.frictionParameters.tauRef
     = (if driveData.motorData.frictionParameters.PRef <= 0 then 0 else 
    driveData.motorData.frictionParameters.PRef/driveData.motorData.frictionParameters.wRef)
     "Reference friction torque at reference angular velocity";
  parameter Real driveData.motorData.frictionParameters.linear = 0.001 
    "Linear angular velocity range with respect to reference angular velocity";
  parameter Modelica.Units.SI.AngularVelocity driveData.motorData.frictionParameters.wLinear
     = driveData.motorData.frictionParameters.linear*driveData.motorData.frictionParameters.wRef
     "Linear angular velocity range";
  parameter Modelica.Units.SI.Torque driveData.motorData.frictionParameters.tauLinear
     = (if driveData.motorData.frictionParameters.PRef <= 0 then 0 else 
    driveData.motorData.frictionParameters.tauRef*(driveData.motorData.frictionParameters.wLinear
    /driveData.motorData.frictionParameters.wRef)^driveData.motorData.frictionParameters.power_w)
     "Torque corresponding with linear angular velocity range";
  parameter Modelica.Units.SI.Voltage driveData.motorData.ViNominal = 
    driveData.motorData.VaNominal-Modelica.Electrical.Machines.Thermal.convertResistance
    (driveData.motorData.Ra, driveData.motorData.TaRef, driveData.motorData.alpha20a,
     driveData.motorData.TaNominal)*driveData.motorData.IaNominal-
    Modelica.Electrical.Machines.Losses.DCMachines.brushVoltageDrop(
    driveData.motorData.brushParameters, 
    driveData.motorData.IaNominal);
  parameter Integer driveData.motorData.coreParameters.m = 1 "Number of phases (1 for DC, 3 for induction machines)";
  parameter Modelica.Units.SI.Power driveData.motorData.coreParameters.PRef(
    min = 0.0) = 0 "Reference core losses at reference inner voltage VRef";
  parameter Modelica.Units.SI.Voltage driveData.motorData.coreParameters.VRef(
    min = 1E-60) = driveData.motorData.ViNominal "Reference inner RMS voltage that reference core losses PRef refer to";
  parameter Modelica.Units.SI.AngularVelocity driveData.motorData.coreParameters.wRef
    (min = 1E-60) = driveData.motorData.wNominal "Reference angular velocity that reference core losses PRef refer to";
  parameter Real driveData.motorData.coreParameters.ratioHysteresis(start = 
    0.775, min = 0.0, max = 1.0) = 0 "Ratio of hysteresis losses with respect to the total core losses at VRef and fRef";
  parameter Modelica.Units.SI.Conductance driveData.motorData.coreParameters.GcRef
     = (if driveData.motorData.coreParameters.PRef <= 0 then 0 else 
    driveData.motorData.coreParameters.PRef/driveData.motorData.coreParameters.VRef
    ^2/driveData.motorData.coreParameters.m) "Reference conductance at reference frequency and voltage";
  parameter Modelica.Units.SI.AngularVelocity driveData.motorData.coreParameters.wMin
     = 1E-06*driveData.motorData.coreParameters.wRef "Angular velocity limit";
  parameter Modelica.Units.SI.Power driveData.motorData.strayLoadParameters.PRef
    (min = 0.0) = 0 "Reference stray load losses at IRef and wRef";
  parameter Modelica.Units.SI.Current driveData.motorData.strayLoadParameters.IRef
    (min = 1E-60) = driveData.motorData.IaNominal "Reference RMS current that PRef refers to";
  parameter Modelica.Units.SI.AngularVelocity driveData.motorData.strayLoadParameters.wRef
    (displayUnit = "rev/min", min = 1E-60) = driveData.motorData.wNominal 
    "Reference angular velocity that PRef refers to";
  parameter Real driveData.motorData.strayLoadParameters.power_w(min = 1E-60) = 1
     "Exponent of stray load loss torque w.r.t. angular velocity";
  parameter Modelica.Units.SI.Torque driveData.motorData.strayLoadParameters.tauRef
     = (if driveData.motorData.strayLoadParameters.PRef <= 0 then 0 else 
    driveData.motorData.strayLoadParameters.PRef/driveData.motorData.strayLoadParameters.wRef)
     "Reference stray load torque at reference angular velocity and reference current";
  parameter Modelica.Units.SI.Voltage driveData.motorData.brushParameters.V = 0 
    "Total voltage drop of brushes for currents > ILinear";
  parameter Modelica.Units.SI.Current driveData.motorData.brushParameters.ILinear
    (start = 0.01) = 0.01*driveData.motorData.IaNominal "Current indicating linear voltage region of brush voltage drop";
  parameter Modelica.Units.SI.Resistance driveData.Ra = Modelica.Electrical.Machines.Thermal.convertResistance
    (driveData.motorData.Ra, driveData.motorData.TaRef, driveData.motorData.alpha20a,
     driveData.motorData.TaNominal) "Armature resistance at nominal temperature";
  parameter Modelica.Units.SI.Time driveData.Ta = driveData.motorData.La/
    driveData.Ra "Armature time constant";
  parameter Modelica.Units.SI.Power driveData.PNominal = driveData.motorData.ViNominal
    *driveData.motorData.IaNominal-driveData.motorData.frictionParameters.PRef-
    driveData.motorData.coreParameters.PRef-driveData.motorData.strayLoadParameters.PRef
     "Nominal mechanical output";
  parameter Modelica.Units.SI.Torque driveData.tauNominal = driveData.PNominal/
    driveData.motorData.wNominal "Nominal torque";
  parameter Modelica.Units.SI.ElectricalTorqueConstant driveData.kPhi = 
    driveData.tauNominal/driveData.motorData.IaNominal "Torque constant";
  parameter Modelica.Units.SI.AngularVelocity driveData.w0 = driveData.motorData.wNominal
    *driveData.motorData.VaNominal/driveData.motorData.ViNominal "No-load speed";
  parameter Modelica.Units.SI.Frequency driveData.fS = 2000.0 "Switching frequency";
  parameter Modelica.Units.SI.Voltage driveData.VBat = driveData.VaMax 
    "DC no-load voltage";
  parameter Modelica.Units.SI.Time driveData.Td = 0.5/driveData.fS 
    "Dead time of inverter";
  parameter Modelica.Units.SI.Time driveData.Tmf = 4*driveData.Td 
    "Measurement filter time constant";
  parameter Modelica.Units.SI.Time driveData.Tsigma = driveData.Td+driveData.Tmf
     "Sum of small time constants";
  parameter Modelica.Units.SI.Inertia driveData.JL = driveData.motorData.Jr 
    "Load inertia";
  parameter Modelica.Units.SI.Voltage driveData.VaMax = 1.2*driveData.motorData.VaNominal
     "Maximum Voltage";
  parameter Modelica.Units.SI.Current driveData.IaMax = 1.5*driveData.motorData.IaNominal
     "Maximum current";
  parameter Modelica.Units.SI.Torque driveData.tauMax = driveData.kPhi*
    driveData.IaMax "Maximum torque";
  parameter Modelica.Units.SI.AngularVelocity driveData.wMax = driveData.motorData.wNominal
    *driveData.motorData.VaNominal/driveData.motorData.ViNominal "Maximum speed";
  parameter Modelica.Units.SI.AngularAcceleration driveData.aMax = 
    driveData.tauMax/(driveData.JL+driveData.motorData.Jr) "Maximum acceleration";
  parameter Real driveData.kpI = driveData.motorData.La/(2*driveData.Tsigma) 
    "Proportional gain";
  parameter Modelica.Units.SI.Time driveData.TiI = driveData.Ta "Integral time constant";
  parameter Modelica.Units.SI.Time driveData.Tsub = 2*driveData.Tsigma 
    "Substitute time constant";
  parameter Real driveData.kpw = (driveData.JL+driveData.motorData.Jr)/(2*
    driveData.Tsub) "Proportional gain";
  parameter Modelica.Units.SI.Time driveData.Tiw = 4*driveData.Tsub 
    "Integral time constant";
  parameter Modelica.Units.SI.Time driveData.Tfw = driveData.Tiw 
    "Filter time constant";
  parameter Real driveData.kpP = 1/(16*driveData.Tsub) "Proportional gain";
  constant Boolean pump.allowFlowReversal = false "= true to allow flow reversal, false restricts to design direction (port_a -> port_b)";
  parameter Boolean pump.port_a_exposesState = false "= true if port_a exposes the state of a fluid volume";
  parameter Boolean pump.port_b_exposesState = pump.energyDynamics <> 
    Modelica.Fluid.Types.Dynamics.SteadyState or pump.massDynamics <> 
    Modelica.Fluid.Types.Dynamics.SteadyState "= true if port_b.p exposes the state of a fluid volume";
  parameter Boolean pump.showDesignFlowDirection = true "= false to hide the arrow in the model icon";
  parameter Modelica.Media.Interfaces.Types.AbsolutePressure pump.p_a_start(
    start = system.p_start) = system.p_start "Guess value for inlet pressure";
  parameter Modelica.Media.Interfaces.Types.AbsolutePressure pump.p_b_start(
    start = system.p_start) = pump.p_a_start "Guess value for outlet pressure";
  parameter Modelica.Media.Interfaces.PartialMedium.MassFlowRate 
    pump.m_flow_start = 0.01 "Guess value of m_flow = port_a.m_flow";
  parameter Modelica.Fluid.Types.CheckValveHomotopyType pump.checkValveHomotopy
     = Modelica.Fluid.Types.CheckValveHomotopyType.Closed "= whether the valve is Closed, Open, or unknown at initialization";
  parameter Modelica.Units.SI.VolumeFlowRate pump.V_flow_single_init = 
    pump.m_flow_start/pump.rho_nominal/pump.nParallel "Used for simplified initialization model";
  parameter Modelica.Units.SI.Position pump.delta_head_init = pump.flowCharacteristic_Unique'"pump"'
    (pump.V_flow_single_init*1.1, {0, 0.00365}, {150000, 100000})-
    pump.flowCharacteristic_Unique'"pump"'(pump.V_flow_single_init, {0, 0.00365},
     {150000, 100000}) "Delta head for a 10% increase of flow at the initialization point";
  parameter Integer pump.nParallel(min = 1.0) = 1 "Number of pumps in parallel";
  parameter Modelica.Units.NonSI.AngularVelocity_rpm pump.N_nominal = 1400 
    "Nominal rotational speed for flow characteristic";
  parameter Modelica.Media.Interfaces.Types.Density pump.rho_nominal = 
    pump.density_pTX_Unique1(101325, 293.15, {0.01, 0.99}) "Nominal fluid density for characteristic";
  parameter Boolean pump.use_powerCharacteristic = false "Use powerCharacteristic (vs. efficiencyCharacteristic)";
  constant Boolean pump.checkValve = true "= true to prevent reverse flow";
  parameter Modelica.Units.SI.Volume pump.V(displayUnit = "l") = 0.006 
    "Volume inside the pump";
  parameter Modelica.Fluid.Types.Dynamics pump.energyDynamics = Modelica.Fluid.Types.Dynamics.
    FixedInitial "Formulation of energy balance";
  parameter Modelica.Fluid.Types.Dynamics pump.massDynamics = Modelica.Fluid.Types.Dynamics.
    FixedInitial "Formulation of mass balance";
  parameter Modelica.Fluid.Types.Dynamics pump.substanceDynamics = 
    pump.massDynamics "Formulation of substance balance";
  parameter Modelica.Fluid.Types.Dynamics pump.traceDynamics = pump.massDynamics
     "Formulation of trace substance balance";
  parameter Modelica.Media.Interfaces.Types.AbsolutePressure pump.p_start(
    start = system.p_start) = pump.p_b_start "Start value of pressure";
  parameter Boolean pump.use_T_start = true "= true, use T_start, otherwise h_start";
  parameter Modelica.Media.Interfaces.Types.Temperature pump.T_start(start = 
    system.T_start, min = 190.0, max = 647.0) = 298.15 "Start value of temperature";
  parameter Modelica.Media.Interfaces.Types.SpecificEnthalpy pump.h_start = (if 
    pump.use_T_start then pump.specificEnthalpy_pTX_Unique6(pump.p_start, 
    pump.T_start, pump.X_start) else pump.specificEnthalpy_pTX_Unique6(101325, 
    293.15, {0.01, 0.99})) "Start value of specific enthalpy";
  parameter Modelica.Media.Interfaces.Types.MassFraction pump.X_start[2] = {0.01,
     0.99} "Start value of mass fractions m_i/m";
  parameter Modelica.Media.Interfaces.Types.ExtraProperty pump.C_start[0](
    start = fill(1.0, size(pump.C_start, 1))) = {} "Start value of trace substances";
  constant Boolean pump.medium.preferredMediumStates = false "= true if StateSelect.prefer shall be used for the independent property variables of the medium";
  parameter Boolean pump.medium.standardOrderComponents = true "If true, and reducedX = true, the last element of X will be computed from the other ones";
  parameter Boolean pump.initialize_p = true "= true to set up initial equations for pressure";
  constant Boolean pump.use_HeatTransfer = false "= true to use a HeatTransfer model, e.g., for a housing";
  constant Integer pump.heatTransfer.n = 1 "Number of heat transfer segments";
  parameter Boolean pump.heatTransfer.use_k = pump.use_HeatTransfer 
    "= true to use k value for thermal isolation";
  parameter Modelica.Units.SI.CoefficientOfHeatTransfer pump.heatTransfer.k = 0 
    "Heat transfer coefficient to ambient";
  parameter Modelica.Units.SI.Temperature pump.heatTransfer.T_ambient = 
    system.T_ambient "Ambient temperature";
  parameter Modelica.Units.SI.Acceleration pump.g = system.g "Constant gravity acceleration";
  constant Modelica.Media.Interfaces.PartialMedium.MassFlowRate pump.unit_m_flow
     = 1;
  constant Modelica.Units.SI.Position pump.unitHead = 1;
  constant Modelica.Units.SI.MassFlowRate pump.unitMassFlowRate = 1;
  constant Boolean pump.use_N_in = true "Get the rotational speed from the input connector";
  parameter Modelica.Units.NonSI.AngularVelocity_rpm pump.N_const = 
    pump.N_nominal "Constant rotational speed";
  constant Boolean torque.useSupport = false "= true, if support flange enabled, otherwise implicitly grounded";
  parameter Real gain.k(start = 1, unit = "1") = 9.5493 "Gain value multiplied with input signal";
  constant Modelica.Blocks.Types.SimpleController limPID.controllerType = 
    Modelica.Blocks.Types.SimpleController.PID "Type of controller";
  parameter Real limPID.k(unit = "1", min = 0.0) = 450 "Gain of controller";
  parameter Modelica.Units.SI.Time limPID.Ti(min = 1E-60) = 230 "Time constant of Integrator block";
  parameter Modelica.Units.SI.Time limPID.Td(min = 0.0) = 100 "Time constant of Derivative block";
  parameter Real limPID.yMax(start = 1) = 2.4 "Upper limit of output";
  parameter Real limPID.yMin = -2.4 "Lower limit of output";
  parameter Real limPID.wp(min = 0.0) = 1 "Set-point weight for Proportional block (0..1)";
  parameter Real limPID.wd(min = 0.0) = 0 "Set-point weight for Derivative block (0..1)";
  parameter Real limPID.Ni(min = 1E-13) = 0.9 "Ni*Ti is time constant of anti-windup compensation";
  parameter Real limPID.Nd(min = 1E-13) = 10 "The higher Nd, the more ideal the derivative block";
  constant Boolean limPID.withFeedForward = false "Use feed-forward input?";
  parameter Real limPID.kFF = 1 "Gain of feed-forward input";
  parameter Modelica.Blocks.Types.Init limPID.initType = Modelica.Blocks.Types.Init.
    InitialState "Type of initialization (1: no init, 2: steady state, 3: initial state, 4: initial output)";
  parameter Real limPID.xi_start = 0.01 "Initial or guess value for integrator output (= integrator state)";
  parameter Real limPID.xd_start = 0.01 "Initial or guess value for state of derivative block";
  parameter Real limPID.y_start = 0.01 "Initial value of output";
  parameter Modelica.Blocks.Types.LimiterHomotopy limPID.homotopyType = 
    Modelica.Blocks.Types.LimiterHomotopy.Linear "Simplified model for homotopy-based initialization";
  parameter Boolean limPID.strict = false "= true, if strict limits with noEvent(..)";
  constant Modelica.Units.SI.Time limPID.unitTime = 1;
  parameter Real limPID.addP.k1 = limPID.wp "Gain of input signal 1";
  parameter Real limPID.addP.k2 = -1 "Gain of input signal 2";
  parameter Real limPID.P.k(start = 1, unit = "1") = 1 "Gain value multiplied with input signal";
  parameter Real limPID.gainPID.k(start = 1, unit = "1") = limPID.k 
    "Gain value multiplied with input signal";
  parameter Real limPID.addPID.k1 = 1 "Gain of input signal 1";
  parameter Real limPID.addPID.k2 = 1 "Gain of input signal 2";
  parameter Real limPID.addPID.k3 = 1 "Gain of input signal 3";
  parameter Real limPID.limiter.uMax(start = 1) = limPID.yMax "Upper limits of input signals";
  parameter Real limPID.limiter.uMin = limPID.yMin "Lower limits of input signals";
  parameter Boolean limPID.limiter.strict = limPID.strict "= true, if strict limits with noEvent(..)";
  parameter Modelica.Blocks.Types.LimiterHomotopy limPID.limiter.homotopyType = 
    limPID.homotopyType "Simplified model for homotopy-based initialization";
  constant Boolean limPID.with_I = true;
  constant Boolean limPID.with_D = true;
  parameter Real limPID.FFzero.k(start = 1) = 0 "Constant output value";
  parameter Real limPID.addFF.k1 = 1 "Gain of input signal 1";
  parameter Real limPID.addFF.k2 = limPID.kFF "Gain of input signal 2";
  parameter Real limPID.addD.k1 = limPID.wd "Gain of input signal 1";
  parameter Real limPID.addD.k2 = -1 "Gain of input signal 2";
  parameter Real limPID.I.k(unit = "1") = limPID.unitTime/limPID.Ti 
    "Integrator gain";
  constant Boolean limPID.I.use_reset = false "= true, if reset port enabled";
  constant Boolean limPID.I.use_set = false "= true, if set port enabled and used as reinitialization value when reset";
  parameter Modelica.Blocks.Types.Init limPID.I.initType = (if limPID.initType
     == Modelica.Blocks.Types.Init.SteadyState then Modelica.Blocks.Types.Init.
    SteadyState else (if limPID.initType == Modelica.Blocks.Types.Init.
    InitialState then Modelica.Blocks.Types.Init.InitialState else 
    Modelica.Blocks.Types.Init.NoInit)) "Type of initialization (1: no init, 2: steady state, 3,4: initial output)";
  parameter Real limPID.I.y_start = limPID.xi_start "Initial or guess value of output (= state)";
  parameter Real limPID.D.k(unit = "1") = limPID.Td/limPID.unitTime "Gains";
  parameter Modelica.Units.SI.Time limPID.D.T(min = 1E-60) = max([limPID.Td/
    limPID.Nd, 1E-14]) "Time constants (T>0 required; T=0 is ideal derivative block)";
  parameter Modelica.Blocks.Types.Init limPID.D.initType = (if limPID.initType
     == Modelica.Blocks.Types.Init.SteadyState or limPID.initType == 
    Modelica.Blocks.Types.Init.InitialOutput then Modelica.Blocks.Types.Init.
    SteadyState else (if limPID.initType == Modelica.Blocks.Types.Init.
    InitialState then Modelica.Blocks.Types.Init.InitialState else 
    Modelica.Blocks.Types.Init.NoInit)) "Type of initialization (1: no init, 2: steady state, 3: initial state, 4: initial output)";
  parameter Real limPID.D.x_start = limPID.xd_start "Initial or guess value of state";
  parameter Real limPID.D.y_start = 0 "Initial value of output (= state)";
  parameter Boolean limPID.D.zeroGain = abs(limPID.D.k) < 1E-15;
  parameter Real limPID.addI.k1 = 1 "Gain of input signal 1";
  parameter Real limPID.addI.k2 = -1 "Gain of input signal 2";
  parameter Real limPID.addI.k3 = 1 "Gain of input signal 3";
  parameter Real limPID.addSat.k1 = 1 "Gain of input signal 1";
  parameter Real limPID.addSat.k2 = -1 "Gain of input signal 2";
  parameter Real limPID.gainTrack.k(start = 1, unit = "1") = 1/(limPID.k*
    limPID.Ni) "Gain value multiplied with input signal";
  constant Boolean senTem.allowFlowReversal = true "= false to simplify equations, assuming, but not enforcing, no flow reversal";
  parameter Modelica.Units.SI.MassFlowRate senTem.m_flow_nominal(min = 0.0) = 
    0.1 "Nominal mass flow rate, used for regularization near zero flow";
  parameter Modelica.Units.SI.MassFlowRate senTem.m_flow_small(min = 0.0) = 
    0.0001*senTem.m_flow_nominal "For bi-directional flow, temperature is regularized in the region |m_flow| < m_flow_small (m_flow_small > 0 required)";
  parameter Modelica.Units.SI.Time senTem.tau(min = 0.0) = 1 "Time constant at nominal flow rate (use tau=0 for steady-state sensor, but see user guide for potential problems)";
  parameter Modelica.Blocks.Types.Init senTem.initType = Modelica.Blocks.Types.Init.
    InitialState "Type of initialization (InitialState and InitialOutput are identical)";
  parameter Boolean senTem.dynamic = senTem.tau > 1E-10 or senTem.tau < -1E-10 
    "Flag, true if the sensor is a dynamic sensor";
  parameter Real senTem.tauInv(unit = "s-1") = (if senTem.dynamic then 1/
    senTem.tau else 0) "Inverse of tau";
  parameter Modelica.Units.SI.Temperature senTem.T_start = 293.15 
    "Initial or guess value of output (= state)";
  parameter Boolean senTem.transferHeat = false "if true, temperature T converges towards TAmb when no flow";
  parameter Modelica.Units.SI.Temperature senTem.TAmb = 293.15 "Fixed ambient temperature for heat transfer";
  parameter Modelica.Units.SI.Time senTem.tauHeaTra(min = 1.0) = 1200 
    "Time constant for heat transfer, default 20 minutes";
  parameter Real senTem.tauHeaTraInv(unit = "1/s") = (if senTem.tauHeaTra < 
    1E-10 then 0 else 1/senTem.tauHeaTra) "Dummy parameter to avoid division by tauHeaTra";
  parameter Real senTem.ratTau = (if senTem.dynamic then senTem.tauHeaTra/
    senTem.tau else 1) "Ratio of tau";
  constant Boolean senRelHum.allowFlowReversal = true "= false to simplify equations, assuming, but not enforcing, no flow reversal";
  parameter Modelica.Units.SI.MassFlowRate senRelHum.m_flow_nominal(min = 0.0)
     = 0.1 "Nominal mass flow rate, used for regularization near zero flow";
  parameter Modelica.Units.SI.MassFlowRate senRelHum.m_flow_small(min = 0.0) = 
    0.0001*senRelHum.m_flow_nominal "For bi-directional flow, temperature is regularized in the region |m_flow| < m_flow_small (m_flow_small > 0 required)";
  parameter Modelica.Units.SI.Time senRelHum.tau(min = 0.0) = 1 "Time constant at nominal flow rate (use tau=0 for steady-state sensor, but see user guide for potential problems)";
  parameter Modelica.Blocks.Types.Init senRelHum.initType = Modelica.Blocks.Types.Init.
    InitialState "Type of initialization (InitialState and InitialOutput are identical)";
  parameter Boolean senRelHum.dynamic = senRelHum.tau > 1E-10 or senRelHum.tau
     < -1E-10 "Flag, true if the sensor is a dynamic sensor";
  parameter Real senRelHum.tauInv(unit = "s-1") = (if senRelHum.dynamic then 1/
    senRelHum.tau else 0) "Inverse of tau";
  parameter Real senRelHum.phi_start(unit = "1", min = 0.0, max = 1.0) = 0.5 
    "Initial or guess value of output (= state)";
  parameter Real constant3.k(start = 1) = 0.8 "Constant output value";
  constant Boolean hum.allowFlowReversal = true "= false to simplify equations, assuming, but not enforcing, no flow reversal";
  constant Modelica.Units.SI.MassFlowRate hum.m_flow_nominal = 0.1 
    "Nominal mass flow rate";
  parameter Modelica.Units.SI.MassFlowRate hum.m_flow_small(min = 0.0) = 0.0001*
    abs(hum.m_flow_nominal) "Small mass flow rate for regularization of zero flow";
  constant Boolean hum.show_T = false "= true, if actual temperature at port is computed";
  parameter Modelica.Units.SI.MassFlowRate hum._m_flow_start = 0 
    "Start value for m_flow, used to avoid a warning if not set in m_flow, and to avoid m_flow.start in parameter window";
  parameter Modelica.Units.SI.PressureDifference hum._dp_start(displayUnit = 
    "Pa") = 0 "Start value for dp, used to avoid a warning if not set in dp, and to avoid dp.start in parameter window";
  parameter Boolean hum.computeFlowResistance = true "=true, compute flow resistance. Set to false to assume no friction";
  parameter Boolean hum.from_dp = false "= true, use m_flow = f(dp) else dp = f(m_flow)";
  constant Modelica.Units.SI.PressureDifference hum.dp_nominal(displayUnit = 
    "Pa", min = 0.0) = 1200 "Pressure difference";
  parameter Boolean hum.linearizeFlowResistance = false "= true, use linear relation between m_flow and dp for any flow rate";
  parameter Real hum.deltaM = 0.1 "Fraction of nominal flow rate where flow transitions to laminar";
  constant Boolean hum.homotopyInitialization = true "= true, use homotopy method";
  parameter Modelica.Units.SI.Time hum.tau = 30 "Time constant at nominal flow (if energyDynamics <> SteadyState)";
  constant Modelica.Fluid.Types.Dynamics hum.energyDynamics = Modelica.Fluid.Types.Dynamics.
    DynamicFreeInitial "Type of energy balance: dynamic (3 initialization options) or steady state";
  parameter Modelica.Media.Interfaces.Types.AbsolutePressure hum.p_start(
    start = system.p_start) = 101325 "Start value of pressure";
  parameter Modelica.Media.Interfaces.Types.Temperature hum.T_start(start = 
    system.T_start, min = 190.0, max = 647.0) = 293.15 "Start value of temperature";
  parameter Modelica.Media.Interfaces.Types.MassFraction hum.X_start[2] = {0.01,
     0.99} "Start value of mass fractions m_i/m";
  parameter Modelica.Media.Interfaces.Types.ExtraProperty hum.C_start[0](
    start = fill(1.0, size(hum.C_start, 1))) = fill(0, 0) "Start value of trace substances";
  constant Modelica.Fluid.Types.Dynamics hum.vol.energyDynamics = 
    Modelica.Fluid.Types.Dynamics.DynamicFreeInitial "Type of energy balance: dynamic (3 initialization options) or steady state";
  constant Modelica.Fluid.Types.Dynamics hum.vol.massDynamics = Modelica.Fluid.Types.Dynamics.
    DynamicFreeInitial "Type of mass balance: dynamic (3 initialization options) or steady state, must be steady state if energyDynamics is steady state";
  constant Modelica.Fluid.Types.Dynamics hum.vol.substanceDynamics = 
    Modelica.Fluid.Types.Dynamics.DynamicFreeInitial "Type of independent mass fraction balance: dynamic (3 initialization options) or steady state";
  constant Modelica.Fluid.Types.Dynamics hum.vol.traceDynamics = 
    Modelica.Fluid.Types.Dynamics.DynamicFreeInitial "Type of trace substance balance: dynamic (3 initialization options) or steady state";
  parameter Modelica.Media.Interfaces.Types.AbsolutePressure hum.vol.p_start(
    start = system.p_start) = hum.p_start "Start value of pressure";
  parameter Modelica.Media.Interfaces.Types.Temperature hum.vol.T_start(start = 
    system.T_start, min = 190.0, max = 647.0) = hum.T_start "Start value of temperature";
  parameter Modelica.Media.Interfaces.Types.MassFraction hum.vol.X_start[2] = {
    hum.X_start[1], hum.X_start[2]} "Start value of mass fractions m_i/m";
  parameter Modelica.Media.Interfaces.Types.ExtraProperty hum.vol.C_start[0](
    start = fill(1.0, size(hum.vol.C_start, 1))) = hum.C_start "Start value of trace substances";
  constant Modelica.Media.Interfaces.Types.ExtraProperty hum.vol.C_nominal[0] = 
    {} "Nominal value of trace substances. (Set to typical order of magnitude.)";
  parameter Real hum.vol.mSenFac(min = 1.0) = 1 "Factor for scaling the sensible thermal mass of the volume";
  parameter Boolean hum.vol.wrongEnergyMassBalanceConfiguration =  not (
    hum.vol.energyDynamics <> Modelica.Fluid.Types.Dynamics.SteadyState or 
    hum.vol.massDynamics == Modelica.Fluid.Types.Dynamics.SteadyState) 
    "True if configuration of energy and mass balance is wrong.";
  parameter Boolean hum.vol.initialize_p = true "= true to set up initial equations for pressure";
  constant Boolean hum.vol.prescribedHeatFlowRate = true "Set to true if the model has a prescribed heat flow at its heatPort. If the heat flow rate at the heatPort is only based on temperature difference, then set to false";
  constant Boolean hum.vol.simplify_mWat_flow = true "Set to true to cause port_a.m_flow + port_b.m_flow = 0 even if mWat_flow is non-zero";
  parameter Modelica.Units.SI.MassFlowRate hum.vol.m_flow_nominal(min = 0.0) = 
    hum.m_flow_nominal "Nominal mass flow rate";
  constant Integer hum.vol.nPorts = 2 "Number of ports";
  parameter Modelica.Units.SI.MassFlowRate hum.vol.m_flow_small(min = 0.0) = 
    0.0001*abs(hum.vol.m_flow_nominal) "Small mass flow rate for regularization of zero flow";
  parameter Boolean hum.vol.allowFlowReversal = hum.allowFlowReversal 
    "= false to simplify equations, assuming, but not enforcing, no flow reversal. Used only if model has two ports.";
  parameter Modelica.Units.SI.Volume hum.vol.V = hum.m_flow_nominal*hum.tau/
    hum.rho_default "Volume";
  parameter Modelica.Units.SI.Density hum.vol.rho_start = hum.vol.density_Unique138
    (
    hum.vol.state_start) "Density, used to compute start and guess values";
  parameter Modelica.Media.Interfaces.Types.AbsolutePressure hum.vol.state_default.p
     = system.p_start "Absolute pressure of medium";
  parameter Modelica.Media.Interfaces.Types.Temperature hum.vol.state_default.T(
    min = 190.0, max = 647.0) = system.T_start "Temperature of medium";
  parameter Modelica.Media.Interfaces.Types.MassFraction hum.vol.state_default.X
    [2] = {0.01, 0.99} "Mass fractions (= (component mass)/total mass  m_i/m)";
  parameter Modelica.Units.SI.Density hum.vol.rho_default = hum.vol.density_Unique138
    (
    hum.vol.state_default) "Density, used to compute fluid mass";
  parameter Modelica.Media.Interfaces.Types.AbsolutePressure hum.vol.state_start.p
     = system.p_start "Absolute pressure of medium";
  parameter Modelica.Media.Interfaces.Types.Temperature hum.vol.state_start.T(
    min = 190.0, max = 647.0) = system.T_start "Temperature of medium";
  parameter Modelica.Media.Interfaces.Types.MassFraction hum.vol.state_start.X[2]
     = {0.01, 0.99} "Mass fractions (= (component mass)/total mass  m_i/m)";
  constant Boolean hum.vol.useSteadyStateTwoPort = false "Flag, true if the model has two ports only and uses a steady state balance";
  constant Boolean hum.vol.use_C_flow = false "Set to true to enable input connector for trace substance";
  parameter Real hum.vol.s[1] = array((if Modelica.Utilities.Strings.isEqual(({
    "water", "air"})[i], "Water", false) then 1 else 0) for i in 1:1) 
    "Vector with zero everywhere except where species is";
  parameter Modelica.Fluid.Types.Dynamics hum.vol.dynBal.energyDynamics = 
    hum.vol.energyDynamics "Type of energy balance: dynamic (3 initialization options) or steady state";
  constant Modelica.Fluid.Types.Dynamics hum.vol.dynBal.massDynamics = 
    Modelica.Fluid.Types.Dynamics.DynamicFreeInitial "Type of mass balance: dynamic (3 initialization options) or steady state, must be steady state if energyDynamics is steady state";
  parameter Modelica.Fluid.Types.Dynamics hum.vol.dynBal.substanceDynamics = 
    hum.vol.dynBal.energyDynamics "Type of independent mass fraction balance: dynamic (3 initialization options) or steady state";
  parameter Modelica.Fluid.Types.Dynamics hum.vol.dynBal.traceDynamics = 
    hum.vol.dynBal.energyDynamics "Type of trace substance balance: dynamic (3 initialization options) or steady state";
  parameter Modelica.Media.Interfaces.Types.AbsolutePressure hum.vol.dynBal.p_start
    (start = system.p_start) = hum.vol.p_start "Start value of pressure";
  parameter Modelica.Media.Interfaces.Types.Temperature hum.vol.dynBal.T_start(
    start = system.T_start, min = 190.0, max = 647.0) = hum.vol.T_start 
    "Start value of temperature";
  parameter Modelica.Media.Interfaces.Types.MassFraction hum.vol.dynBal.X_start[2]
     = {hum.vol.X_start[1], hum.vol.X_start[2]} "Start value of mass fractions m_i/m";
  parameter Modelica.Media.Interfaces.Types.ExtraProperty hum.vol.dynBal.C_start
    [0](start = fill(1.0, size(hum.vol.dynBal.C_start, 1))) = hum.vol.C_start 
    "Start value of trace substances";
  constant Modelica.Media.Interfaces.Types.ExtraProperty hum.vol.dynBal.C_nominal
    [0] = {} "Nominal value of trace substances. (Set to typical order of magnitude.)";
  parameter Real hum.vol.dynBal.mSenFac(min = 1.0) = hum.vol.mSenFac 
    "Factor for scaling the sensible thermal mass of the volume";
  parameter Boolean hum.vol.dynBal.wrongEnergyMassBalanceConfiguration =  not (
    hum.vol.dynBal.energyDynamics <> Modelica.Fluid.Types.Dynamics.SteadyState
     or hum.vol.dynBal.massDynamics == Modelica.Fluid.Types.Dynamics.SteadyState)
     "True if configuration of energy and mass balance is wrong.";
  parameter Boolean hum.vol.dynBal.initialize_p = hum.vol.initialize_p 
    "= true to set up initial equations for pressure";
  constant Boolean hum.vol.dynBal.simplify_mWat_flow = hum.vol.simplify_mWat_flow
     "Set to true to cause port_a.m_flow + port_b.m_flow = 0 even if mWat_flow is non-zero. Used only if Medium.nX > 1";
  constant Integer hum.vol.dynBal.nPorts = 2 "Number of ports";
  constant Boolean hum.vol.dynBal.use_mWat_flow = true "Set to true to enable input connector for moisture mass flow rate";
  constant Boolean hum.vol.dynBal.use_C_flow = false "Set to true to enable input connector for trace substance";
  constant Boolean hum.vol.dynBal.medium.preferredMediumStates = false 
    "= true if StateSelect.prefer shall be used for the independent property variables of the medium";
  parameter Boolean hum.vol.dynBal.medium.standardOrderComponents = true 
    "If true, and reducedX = true, the last element of X will be computed from the other ones";
  parameter Modelica.Units.SI.Volume hum.vol.dynBal.fluidVolume = hum.vol.V 
    "Volume";
  parameter Modelica.Units.SI.HeatCapacity hum.vol.dynBal.CSen = (
    hum.vol.dynBal.mSenFac-1)*hum.vol.dynBal.rho_default*hum.vol.dynBal.cp_default
    *hum.vol.dynBal.fluidVolume "Aditional heat capacity for implementing mFactor";
  parameter Modelica.Units.SI.SpecificHeatCapacity hum.vol.dynBal.cp_default = 
    hum.vol.dynBal.specificHeatCapacityCp_Unique197(
    hum.vol.dynBal.state_default) "Heat capacity, to compute additional dry mass";
  parameter Modelica.Units.SI.Density hum.vol.dynBal.rho_start = 
    hum.vol.dynBal.density_Unique198(
    hum.vol.dynBal.setState_pTX_Unique187(hum.vol.dynBal.p_start, 
      hum.vol.dynBal.T_start, hum.vol.dynBal.X_start[1:1])) "Density, used to compute fluid mass";
  parameter Boolean hum.vol.dynBal.computeCSen = abs(hum.vol.dynBal.mSenFac-1)
     > 1E-15;
  parameter Modelica.Media.Interfaces.Types.AbsolutePressure hum.vol.dynBal.state_default.p
     = system.p_start "Absolute pressure of medium";
  parameter Modelica.Media.Interfaces.Types.Temperature hum.vol.dynBal.state_default.T
    (min = 190.0, max = 647.0) = system.T_start "Temperature of medium";
  parameter Modelica.Media.Interfaces.Types.MassFraction hum.vol.dynBal.state_default.X
    [2] = {0.01, 0.99} "Mass fractions (= (component mass)/total mass  m_i/m)";
  parameter Modelica.Units.SI.Density hum.vol.dynBal.rho_default = 
    hum.vol.dynBal.density_Unique198(
    hum.vol.dynBal.state_default) "Density, used to compute fluid mass";
  parameter Real hum.vol.dynBal.s[1] = array((if Modelica.Utilities.Strings.isEqual
    (({"water", "air"})[i], "Water", false) then 1 else 0) for i in 1:1) 
    "Vector with zero everywhere except where species is";
  parameter Modelica.Units.SI.SpecificEnthalpy hum.vol.dynBal.hStart = 
    hum.vol.dynBal.specificEnthalpy_pTX_Unique179(hum.vol.dynBal.p_start, 
    hum.vol.dynBal.T_start, hum.vol.dynBal.X_start) "Start value for specific enthalpy";
  constant Boolean hum.vol.dynBal._simplify_mWat_flow = hum.vol.dynBal.simplify_mWat_flow
     and true "If true, then port_a.m_flow + port_b.m_flow = 0 even if mWat_flow is non-zero, and equations are simplified";
  constant Boolean hum.preDro.allowFlowReversal = true "= false to simplify equations, assuming, but not enforcing, no flow reversal";
  constant Modelica.Units.SI.MassFlowRate hum.preDro.m_flow_nominal = 0.1 
    "Nominal mass flow rate";
  parameter Modelica.Units.SI.MassFlowRate hum.preDro.m_flow_small(min = 0.0) = 
    0.0001*abs(hum.preDro.m_flow_nominal) "Small mass flow rate for regularization of zero flow";
  constant Boolean hum.preDro.show_T = false "= true, if actual temperature at port is computed";
  parameter Modelica.Units.SI.MassFlowRate hum.preDro._m_flow_start = 0 
    "Start value for m_flow, used to avoid a warning if not set in m_flow, and to avoid m_flow.start in parameter window";
  parameter Modelica.Units.SI.PressureDifference hum.preDro._dp_start(
    displayUnit = "Pa") = 0 "Start value for dp, used to avoid a warning if not set in dp, and to avoid dp.start in parameter window";
  constant Boolean hum.preDro.homotopyInitialization = hum.homotopyInitialization
     "= true, use homotopy method";
  parameter Boolean hum.preDro.from_dp = hum.from_dp "= true, use m_flow = f(dp) else dp = f(m_flow)";
  constant Modelica.Units.SI.PressureDifference hum.preDro.dp_nominal(
    displayUnit = "Pa") = 1200 "Pressure drop at nominal mass flow rate";
  parameter Boolean hum.preDro.linearized = hum.linearizeFlowResistance 
    "= true, use linear relation between m_flow and dp for any flow rate";
  parameter Modelica.Units.SI.MassFlowRate hum.preDro.m_flow_turbulent(min = 0.0)
     = (if hum.preDro.computeFlowResistance then hum.preDro.deltaM*
    hum.preDro.m_flow_nominal_pos else 0) "Turbulent flow if |m_flow| >= m_flow_turbulent";
  parameter Modelica.Media.Interfaces.Types.AbsolutePressure hum.preDro.sta_default.p
     = system.p_start "Absolute pressure of medium";
  parameter Modelica.Media.Interfaces.Types.Temperature hum.preDro.sta_default.T
    (min = 190.0, max = 647.0) = system.T_start "Temperature of medium";
  parameter Modelica.Media.Interfaces.Types.MassFraction hum.preDro.sta_default.X
    [2] = {0.01, 0.99} "Mass fractions (= (component mass)/total mass  m_i/m)";
  parameter Modelica.Units.SI.DynamicViscosity hum.preDro.eta_default = 
    hum.preDro.dynamicViscosity_Unique164(
    hum.preDro.sta_default) "Dynamic viscosity, used to compute transition to turbulent flow regime";
  constant Modelica.Units.SI.MassFlowRate hum.preDro.m_flow_nominal_pos = 0.1 
    "Absolute value of nominal flow rate";
  constant Modelica.Units.SI.PressureDifference hum.preDro.dp_nominal_pos(
    displayUnit = "Pa") = 1200 "Absolute value of nominal pressure difference";
  parameter Real hum.preDro.deltaM(min = 1E-06) = hum.deltaM "Fraction of nominal mass flow rate where transition to turbulent occurs";
  parameter Real hum.preDro.k = (if hum.preDro.computeFlowResistance then 
    hum.preDro.m_flow_nominal_pos/sqrt(hum.preDro.dp_nominal_pos) else 0) 
    "Flow coefficient, k=m_flow/sqrt(dp), with unit=(kg.m)^(1/2)";
  parameter Boolean hum.preDro.computeFlowResistance = hum.preDro.dp_nominal_pos
     > 1E-15 "Flag to enable/disable computation of flow resistance";
  parameter Real hum.preDro.coeff = (if hum.preDro.linearized and 
    hum.preDro.computeFlowResistance then (if hum.preDro.from_dp then 
    hum.preDro.k^2/hum.preDro.m_flow_nominal_pos else hum.preDro.m_flow_nominal_pos
    /hum.preDro.k^2) else 0) "Precomputed coefficient to avoid division by parameter";
