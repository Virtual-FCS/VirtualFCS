  parameter Modelica.Units.SI.AngularVelocity dcpm.friction.frictionParameters.wRef
    (displayUnit = "rev/min", min = 1E-60) "Reference angular velocity that the PRef refer to";
  parameter Real dcpm.friction.frictionParameters.power_w(min = 1E-60) 
