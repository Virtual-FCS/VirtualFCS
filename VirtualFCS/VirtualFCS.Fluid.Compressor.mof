  parameter Modelica.Units.SI.Time dCMotorControlCompressor.preFilter.T(start = 1)
     = dCMotorControlCompressor.driveData.Tfw "Time Constant";
  parameter Modelica.Blocks.Types.Init dCMotorControlCompressor.preFilter.initType
     = Modelica.Blocks.Types.Init.InitialOutput "Type of initialization (1: no init, 2: steady state, 3/4: initial output)";
  parameter Real dCMotorControlCompressor.preFilter.y_start = 0 "Initial or guess value of output (= state)";
  parameter Modelica.Units.SI.Temperature dcpm.TaOperational(start = 293.15) = 
    driveData.motorData.TaNominal "Operational armature temperature";
  parameter Modelica.Units.SI.Voltage dcpm.VaNominal(start = 100) = 
    driveData.motorData.VaNominal "Nominal armature voltage";
  parameter Modelica.Units.SI.Current dcpm.IaNominal(start = 100) = 
    driveData.motorData.IaNominal "Nominal armature current (>0..Motor, <0..Generator)";
  parameter Modelica.Units.SI.AngularVelocity dcpm.wNominal(start = 2850*dcpm.pi
    /60, displayUnit = "rev/min") = driveData.motorData.wNominal "Nominal speed";
  parameter Modelica.Units.SI.Temperature dcpm.TaNominal(start = 293.15) = 
    driveData.motorData.TaNominal "Nominal armature temperature";
  parameter Modelica.Units.SI.Resistance dcpm.Ra(start = 0.05) = 
    driveData.motorData.Ra "Armature resistance at TaRef";
  parameter Modelica.Units.SI.Temperature dcpm.TaRef(start = 293.15) = 
    driveData.motorData.TaRef "Reference temperature of armature resistance";
  parameter Modelica.Electrical.Machines.Thermal.LinearTemperatureCoefficient20 
    dcpm.alpha20a(start = 0) = driveData.motorData.alpha20a "Temperature coefficient of armature resistance";
  parameter Modelica.Units.SI.Inductance dcpm.La(start = 0.0015) = 
    driveData.motorData.La "Armature inductance";
  parameter Modelica.Units.SI.Inertia dcpm.Jr(start = 0.15) = driveData.motorData.Jr
     "Rotor's moment of inertia";
  constant Boolean dcpm.useSupport = false "Enable / disable (=fixed stator) support";
  parameter Modelica.Units.SI.Inertia dcpm.Js = driveData.motorData.Js 
    "Stator's moment of inertia";
  constant Boolean dcpm.useThermalPort = false "Enable / disable (=fixed temperatures) thermal port";
  parameter Modelica.Units.SI.Power dcpm.frictionParameters.PRef(min = 0.0) 
    "Reference friction losses at wRef";
  parameter Modelica.Units.SI.AngularVelocity dcpm.frictionParameters.wRef(
    displayUnit = "rev/min", min = 1E-60) "Reference angular velocity that the PRef refer to";
  parameter Real dcpm.frictionParameters.power_w(min = 1E-60) "Exponent of friction torque w.r.t. angular velocity";
  parameter Modelica.Units.SI.Torque dcpm.frictionParameters.tauRef 
    "Reference friction torque at reference angular velocity";
  parameter Real dcpm.frictionParameters.linear "Linear angular velocity range with respect to reference angular velocity";
  parameter Modelica.Units.SI.AngularVelocity dcpm.frictionParameters.wLinear 
    "Linear angular velocity range";
  parameter Modelica.Units.SI.Torque dcpm.frictionParameters.tauLinear 
    "Torque corresponding with linear angular velocity range";
  parameter Modelica.Units.SI.Inertia dcpm.inertiaRotor.J(start = 1, min = 0.0)
     = dcpm.Jr "Moment of inertia";
  constant StateSelect dcpm.inertiaRotor.stateSelect = StateSelect.default 
    "Priority to use phi and w as states";
  parameter Modelica.Units.SI.Inertia dcpm.inertiaStator.J(start = 1, min = 0.0)
     = dcpm.Js "Moment of inertia";
  constant StateSelect dcpm.inertiaStator.stateSelect = StateSelect.default 
    "Priority to use phi and w as states";
  parameter Modelica.Units.SI.Angle dcpm.fixed.phi0 = 0 "Fixed offset angle of housing";
  parameter Modelica.Units.SI.Power dcpm.friction.frictionParameters.PRef(min = 
