model Compressor
  parameter Modelica.Units.SI.AbsolutePressure system.p_ambient = 101325 
    "Default ambient pressure";
  parameter Modelica.Units.SI.Temperature system.T_ambient = 293.15 
    "Default ambient temperature";
  parameter Modelica.Units.SI.Acceleration system.g = 9.80665 "Constant gravity acceleration";
  parameter Boolean system.allowFlowReversal = true "= false to restrict to design flow direction (port_a -> port_b)";
  parameter Modelica.Fluid.Types.Dynamics system.energyDynamics = 
    Modelica.Fluid.Types.Dynamics.DynamicFreeInitial "Default formulation of energy balances";
  parameter Modelica.Fluid.Types.Dynamics system.massDynamics = system.energyDynamics
     "Default formulation of mass balances";
  parameter Modelica.Fluid.Types.Dynamics system.substanceDynamics = 
    system.massDynamics "Default formulation of substance balances";
  parameter Modelica.Fluid.Types.Dynamics system.traceDynamics = 
    system.massDynamics "Default formulation of trace substance balances";
  parameter Modelica.Fluid.Types.Dynamics system.momentumDynamics = 
    Modelica.Fluid.Types.Dynamics.SteadyState "Default formulation of momentum balances, if options available";
  parameter Modelica.Units.SI.MassFlowRate system.m_flow_start = 0 
    "Default start value for mass flow rates";
  parameter Modelica.Units.SI.AbsolutePressure system.p_start = system.p_ambient
     "Default start value for pressures";
  parameter Modelica.Units.SI.Temperature system.T_start = system.T_ambient 
    "Default start value for temperatures";
  parameter Boolean system.use_eps_Re = false "= true to determine turbulent region automatically using Reynolds number";
  parameter Modelica.Units.SI.MassFlowRate system.m_flow_nominal = (if 
    system.use_eps_Re then 1 else 100.0*system.m_flow_small) "Default nominal mass flow rate";
  parameter Real system.eps_m_flow(min = 0.0) = 0.0001 "Regularization of zero flow for |m_flow| < eps_m_flow*m_flow_nominal";
  parameter Modelica.Units.SI.AbsolutePressure system.dp_small = 1 
    "Default small pressure drop for regularization of laminar and zero flow";
  parameter Modelica.Units.SI.MassFlowRate system.m_flow_small(min = 0.0) = 0.01
     "Default small mass flow rate for regularization of laminar and zero flow";
  input Modelica.Blocks.Interfaces.RealInput controlInterface;
  parameter Real gain1.k(start = 1, unit = "1") = pump.N_nominal 
    "Gain value multiplied with input signal";
  parameter Modelica.Units.SI.Inertia dCMotorControlCompressor.driveData.motorData.Jr
     = 0.15 "Rotor's moment of inertia";
  parameter Modelica.Units.SI.Inertia dCMotorControlCompressor.driveData.motorData.Js
     = 0.28 "Stator's moment of inertia";
  parameter Modelica.Units.SI.Voltage dCMotorControlCompressor.driveData.motorData.VaNominal
     = 24 "Nominal armature voltage";
  parameter Modelica.Units.SI.Current dCMotorControlCompressor.driveData.motorData.IaNominal
     = 100 "Nominal armature current (>0..Motor, <0..Generator)";
  parameter Modelica.Units.SI.AngularVelocity dCMotorControlCompressor.driveData.motorData.wNominal
     = 149.22565104551515 "Nominal speed";
  parameter Modelica.Units.SI.Temperature dCMotorControlCompressor.driveData.motorData.TaNominal
     = 293.15 "Nominal armature temperature";
  parameter Modelica.Units.SI.Resistance dCMotorControlCompressor.driveData.motorData.Ra
     = 0.05 "Armature resistance at TRef";
  parameter Modelica.Units.SI.Temperature dCMotorControlCompressor.driveData.motorData.TaRef
     = 293.15 "Reference temperature of armature resistance";
  parameter Modelica.Electrical.Machines.Thermal.LinearTemperatureCoefficient20 
    dCMotorControlCompressor.driveData.motorData.alpha20a = 0 "Temperature coefficient of armature resistance";
  parameter Modelica.Units.SI.Inductance dCMotorControlCompressor.driveData.motorData.La
     = 0.0015 "Armature inductance";
  parameter Modelica.Units.SI.Power dCMotorControlCompressor.driveData.motorData.frictionParameters.PRef
    (min = 0.0) = 0 "Reference friction losses at wRef";
  parameter Modelica.Units.SI.AngularVelocity dCMotorControlCompressor.driveData.motorData.frictionParameters.wRef
    (displayUnit = "rev/min", min = 1E-60) = dCMotorControlCompressor.driveData.motorData.wNominal
     "Reference angular velocity that the PRef refer to";
  parameter Real dCMotorControlCompressor.driveData.motorData.frictionParameters.power_w
    (min = 1E-60) = 2 "Exponent of friction torque w.r.t. angular velocity";
  parameter Modelica.Units.SI.Torque dCMotorControlCompressor.driveData.motorData.frictionParameters.tauRef
     = (if dCMotorControlCompressor.driveData.motorData.frictionParameters.PRef
     <= 0 then 0 else dCMotorControlCompressor.driveData.motorData.frictionParameters.PRef
    /dCMotorControlCompressor.driveData.motorData.frictionParameters.wRef) 
    "Reference friction torque at reference angular velocity";
  parameter Real dCMotorControlCompressor.driveData.motorData.frictionParameters.linear
     = 0.001 "Linear angular velocity range with respect to reference angular velocity";
  parameter Modelica.Units.SI.AngularVelocity dCMotorControlCompressor.driveData.motorData.frictionParameters.wLinear
     = dCMotorControlCompressor.driveData.motorData.frictionParameters.linear*
    dCMotorControlCompressor.driveData.motorData.frictionParameters.wRef 
    "Linear angular velocity range";
  parameter Modelica.Units.SI.Torque dCMotorControlCompressor.driveData.motorData.frictionParameters.tauLinear
     = (if dCMotorControlCompressor.driveData.motorData.frictionParameters.PRef
     <= 0 then 0 else dCMotorControlCompressor.driveData.motorData.frictionParameters.tauRef
    *(dCMotorControlCompressor.driveData.motorData.frictionParameters.wLinear/
    dCMotorControlCompressor.driveData.motorData.frictionParameters.wRef)^
    dCMotorControlCompressor.driveData.motorData.frictionParameters.power_w) 
    "Torque corresponding with linear angular velocity range";
  parameter Modelica.Units.SI.Voltage dCMotorControlCompressor.driveData.motorData.ViNominal
     = dCMotorControlCompressor.driveData.motorData.VaNominal-Modelica.Electrical.Machines.Thermal.convertResistance
    (dCMotorControlCompressor.driveData.motorData.Ra, dCMotorControlCompressor.driveData.motorData.TaRef,
     dCMotorControlCompressor.driveData.motorData.alpha20a, dCMotorControlCompressor.driveData.motorData.TaNominal)
    *dCMotorControlCompressor.driveData.motorData.IaNominal-Modelica.Electrical.Machines.Losses.DCMachines.brushVoltageDrop
    (
    dCMotorControlCompressor.driveData.motorData.brushParameters, 
    dCMotorControlCompressor.driveData.motorData.IaNominal);
  parameter Integer dCMotorControlCompressor.driveData.motorData.coreParameters.m
     = 1 "Number of phases (1 for DC, 3 for induction machines)";
  parameter Modelica.Units.SI.Power dCMotorControlCompressor.driveData.motorData.coreParameters.PRef
    (min = 0.0) = 0 "Reference core losses at reference inner voltage VRef";
  parameter Modelica.Units.SI.Voltage dCMotorControlCompressor.driveData.motorData.coreParameters.VRef
    (min = 1E-60) = dCMotorControlCompressor.driveData.motorData.ViNominal 
    "Reference inner RMS voltage that reference core losses PRef refer to";
  parameter Modelica.Units.SI.AngularVelocity dCMotorControlCompressor.driveData.motorData.coreParameters.wRef
    (min = 1E-60) = dCMotorControlCompressor.driveData.motorData.wNominal 
    "Reference angular velocity that reference core losses PRef refer to";
  parameter Real dCMotorControlCompressor.driveData.motorData.coreParameters.ratioHysteresis
    (start = 0.775, min = 0.0, max = 1.0) = 0 "Ratio of hysteresis losses with respect to the total core losses at VRef and fRef";
  parameter Modelica.Units.SI.Conductance dCMotorControlCompressor.driveData.motorData.coreParameters.GcRef
     = (if dCMotorControlCompressor.driveData.motorData.coreParameters.PRef <= 0
     then 0 else dCMotorControlCompressor.driveData.motorData.coreParameters.PRef
    /dCMotorControlCompressor.driveData.motorData.coreParameters.VRef^2/
    dCMotorControlCompressor.driveData.motorData.coreParameters.m) 
    "Reference conductance at reference frequency and voltage";
  parameter Modelica.Units.SI.AngularVelocity dCMotorControlCompressor.driveData.motorData.coreParameters.wMin
     = 1E-06*dCMotorControlCompressor.driveData.motorData.coreParameters.wRef 
    "Angular velocity limit";
  parameter Modelica.Units.SI.Power dCMotorControlCompressor.driveData.motorData.strayLoadParameters.PRef
    (min = 0.0) = 0 "Reference stray load losses at IRef and wRef";
  parameter Modelica.Units.SI.Current dCMotorControlCompressor.driveData.motorData.strayLoadParameters.IRef
    (min = 1E-60) = dCMotorControlCompressor.driveData.motorData.IaNominal 
    "Reference RMS current that PRef refers to";
  parameter Modelica.Units.SI.AngularVelocity dCMotorControlCompressor.driveData.motorData.strayLoadParameters.wRef
    (displayUnit = "rev/min", min = 1E-60) = dCMotorControlCompressor.driveData.motorData.wNominal
     "Reference angular velocity that PRef refers to";
  parameter Real dCMotorControlCompressor.driveData.motorData.strayLoadParameters.power_w
    (min = 1E-60) = 1 "Exponent of stray load loss torque w.r.t. angular velocity";
  parameter Modelica.Units.SI.Torque dCMotorControlCompressor.driveData.motorData.strayLoadParameters.tauRef
     = (if dCMotorControlCompressor.driveData.motorData.strayLoadParameters.PRef
     <= 0 then 0 else dCMotorControlCompressor.driveData.motorData.strayLoadParameters.PRef
    /dCMotorControlCompressor.driveData.motorData.strayLoadParameters.wRef) 
    "Reference stray load torque at reference angular velocity and reference current";
  parameter Modelica.Units.SI.Voltage dCMotorControlCompressor.driveData.motorData.brushParameters.V
     = 0 "Total voltage drop of brushes for currents > ILinear";
  parameter Modelica.Units.SI.Current dCMotorControlCompressor.driveData.motorData.brushParameters.ILinear
    (start = 0.01) = 0.01*dCMotorControlCompressor.driveData.motorData.IaNominal
     "Current indicating linear voltage region of brush voltage drop";
  parameter Modelica.Units.SI.Resistance dCMotorControlCompressor.driveData.Ra
     = Modelica.Electrical.Machines.Thermal.convertResistance(dCMotorControlCompressor.driveData.motorData.Ra,
     dCMotorControlCompressor.driveData.motorData.TaRef, dCMotorControlCompressor.driveData.motorData.alpha20a,
     dCMotorControlCompressor.driveData.motorData.TaNominal) "Armature resistance at nominal temperature";
  parameter Modelica.Units.SI.Time dCMotorControlCompressor.driveData.Ta = 
    dCMotorControlCompressor.driveData.motorData.La/dCMotorControlCompressor.driveData.Ra
     "Armature time constant";
  parameter Modelica.Units.SI.Power dCMotorControlCompressor.driveData.PNominal
     = dCMotorControlCompressor.driveData.motorData.ViNominal*dCMotorControlCompressor.driveData.motorData.IaNominal
    -dCMotorControlCompressor.driveData.motorData.frictionParameters.PRef-
    dCMotorControlCompressor.driveData.motorData.coreParameters.PRef-
    dCMotorControlCompressor.driveData.motorData.strayLoadParameters.PRef 
    "Nominal mechanical output";
  parameter Modelica.Units.SI.Torque dCMotorControlCompressor.driveData.tauNominal
     = dCMotorControlCompressor.driveData.PNominal/dCMotorControlCompressor.driveData.motorData.wNominal
     "Nominal torque";
  parameter Modelica.Units.SI.ElectricalTorqueConstant dCMotorControlCompressor.driveData.kPhi
     = dCMotorControlCompressor.driveData.tauNominal/dCMotorControlCompressor.driveData.motorData.IaNominal
     "Torque constant";
  parameter Modelica.Units.SI.AngularVelocity dCMotorControlCompressor.driveData.w0
     = dCMotorControlCompressor.driveData.motorData.wNominal*dCMotorControlCompressor.driveData.motorData.VaNominal
    /dCMotorControlCompressor.driveData.motorData.ViNominal "No-load speed";
  parameter Modelica.Units.SI.Frequency dCMotorControlCompressor.driveData.fS = 
    2000.0 "Switching frequency";
  parameter Modelica.Units.SI.Voltage dCMotorControlCompressor.driveData.VBat = 
    dCMotorControlCompressor.driveData.VaMax "DC no-load voltage";
  parameter Modelica.Units.SI.Time dCMotorControlCompressor.driveData.Td = 0.5/
    dCMotorControlCompressor.driveData.fS "Dead time of inverter";
  parameter Modelica.Units.SI.Time dCMotorControlCompressor.driveData.Tmf = 4*
    dCMotorControlCompressor.driveData.Td "Measurement filter time constant";
  parameter Modelica.Units.SI.Time dCMotorControlCompressor.driveData.Tsigma = 
    dCMotorControlCompressor.driveData.Td+dCMotorControlCompressor.driveData.Tmf
     "Sum of small time constants";
  parameter Modelica.Units.SI.Inertia dCMotorControlCompressor.driveData.JL = 
    dCMotorControlCompressor.driveData.motorData.Jr "Load inertia";
  parameter Modelica.Units.SI.Voltage dCMotorControlCompressor.driveData.VaMax
     = 1.2*dCMotorControlCompressor.driveData.motorData.VaNominal 
    "Maximum Voltage";
  parameter Modelica.Units.SI.Current dCMotorControlCompressor.driveData.IaMax
     = 1.5*dCMotorControlCompressor.driveData.motorData.IaNominal 
    "Maximum current";
  parameter Modelica.Units.SI.Torque dCMotorControlCompressor.driveData.tauMax
     = dCMotorControlCompressor.driveData.kPhi*dCMotorControlCompressor.driveData.IaMax
     "Maximum torque";
  parameter Modelica.Units.SI.AngularVelocity dCMotorControlCompressor.driveData.wMax
     = dCMotorControlCompressor.driveData.motorData.wNominal*dCMotorControlCompressor.driveData.motorData.VaNominal
    /dCMotorControlCompressor.driveData.motorData.ViNominal "Maximum speed";
  parameter Modelica.Units.SI.AngularAcceleration dCMotorControlCompressor.driveData.aMax
     = dCMotorControlCompressor.driveData.tauMax/(dCMotorControlCompressor.driveData.JL
    +dCMotorControlCompressor.driveData.motorData.Jr) "Maximum acceleration";
  parameter Real dCMotorControlCompressor.driveData.kpI = dCMotorControlCompressor.driveData.motorData.La
    /(2*dCMotorControlCompressor.driveData.Tsigma) "Proportional gain";
  parameter Modelica.Units.SI.Time dCMotorControlCompressor.driveData.TiI = 
    dCMotorControlCompressor.driveData.Ta "Integral time constant";
  parameter Modelica.Units.SI.Time dCMotorControlCompressor.driveData.Tsub = 2*
    dCMotorControlCompressor.driveData.Tsigma "Substitute time constant";
  parameter Real dCMotorControlCompressor.driveData.kpw = (dCMotorControlCompressor.driveData.JL
    +dCMotorControlCompressor.driveData.motorData.Jr)/(2*dCMotorControlCompressor.driveData.Tsub)
     "Proportional gain";
  parameter Modelica.Units.SI.Time dCMotorControlCompressor.driveData.Tiw = 4*
    dCMotorControlCompressor.driveData.Tsub "Integral time constant";
  parameter Modelica.Units.SI.Time dCMotorControlCompressor.driveData.Tfw = 
    dCMotorControlCompressor.driveData.Tiw "Filter time constant";
  parameter Real dCMotorControlCompressor.driveData.kpP = 1/(16*dCMotorControlCompressor.driveData.Tsub)
     "Proportional gain";
  constant Boolean dCMotorControlCompressor.armatureInverter.useIdealInverter = 
    true "Use ideal averaging inverter, otherwise switching inverter";
  parameter Modelica.Units.SI.Frequency dCMotorControlCompressor.armatureInverter.fS
     = dCMotorControlCompressor.driveData.fS "Switching frequency";
  parameter Modelica.Units.SI.Time dCMotorControlCompressor.armatureInverter.Td
     = dCMotorControlCompressor.driveData.Td "Dead time";
  parameter Modelica.Units.SI.Time dCMotorControlCompressor.armatureInverter.Tmf
     = dCMotorControlCompressor.driveData.Tmf "Measurement filter time constant";
  parameter Modelica.Units.SI.Voltage dCMotorControlCompressor.armatureInverter.VMax
     = dCMotorControlCompressor.driveData.VaMax "Maximum Voltage";
  parameter Modelica.Units.SI.Time dCMotorControlCompressor.armatureInverter.Ti
     = 1E-06 "Time constant of integral power controller";
  parameter Modelica.Units.SI.Resistance dCMotorControlCompressor.armatureInverter.RonT
     = 1E-05 "Transistor closed resistance";
  parameter Modelica.Units.SI.Conductance dCMotorControlCompressor.armatureInverter.GoffT
     = 1E-05 "Transistor opened conductance";
  parameter Modelica.Units.SI.Voltage dCMotorControlCompressor.armatureInverter.VkneeT
     = 0 "Transistor threshold voltage";
  parameter Modelica.Units.SI.Resistance dCMotorControlCompressor.armatureInverter.RonD
     = 1E-05 "Diode closed resistance";
  parameter Modelica.Units.SI.Conductance dCMotorControlCompressor.armatureInverter.GoffD
     = 1E-05 "Diode opened conductance";
  parameter Modelica.Units.SI.Voltage dCMotorControlCompressor.armatureInverter.VkneeD
     = 0 "Diode threshold voltage";
  parameter Boolean dCMotorControlCompressor.armatureInverter.variableLimiter.strict
     = false "= true, if strict limits with noEvent(..)";
  parameter Modelica.Blocks.Types.VariableLimiterHomotopy dCMotorControlCompressor.armatureInverter.variableLimiter.homotopyType
     = Modelica.Blocks.Types.VariableLimiterHomotopy.Linear "Simplified model for homotopy-based initialization";
  parameter Real dCMotorControlCompressor.armatureInverter.variableLimiter.ySimplified
     = 0 "Fixed value of output in simplified model";
  parameter Real dCMotorControlCompressor.armatureInverter.gain.k(start = 1, 
    unit = "1") = -1 "Gain value multiplied with input signal";
  parameter Real dCMotorControlCompressor.armatureInverter.vDCFilter.k(unit = 
    "1") = 1 "Gain";
  parameter Modelica.Units.SI.Time dCMotorControlCompressor.armatureInverter.vDCFilter.T
    (start = 1) = dCMotorControlCompressor.armatureInverter.Tmf "Time Constant";
  parameter Modelica.Blocks.Types.Init dCMotorControlCompressor.armatureInverter.vDCFilter.initType
     = Modelica.Blocks.Types.Init.InitialOutput "Type of initialization (1: no init, 2: steady state, 3/4: initial output)";
  parameter Real dCMotorControlCompressor.armatureInverter.vDCFilter.y_start = 
    dCMotorControlCompressor.armatureInverter.VMax "Initial or guess value of output (= state)";
  parameter Real dCMotorControlCompressor.armatureInverter.iMotFilter.k(unit = 
    "1") = 1 "Gain";
  parameter Modelica.Units.SI.Time dCMotorControlCompressor.armatureInverter.iMotFilter.T
    (start = 1) = dCMotorControlCompressor.armatureInverter.Tmf "Time Constant";
  parameter Modelica.Blocks.Types.Init dCMotorControlCompressor.armatureInverter.iMotFilter.initType
     = Modelica.Blocks.Types.Init.InitialOutput "Type of initialization (1: no init, 2: steady state, 3/4: initial output)";
  parameter Real dCMotorControlCompressor.armatureInverter.iMotFilter.y_start = 0
     "Initial or guess value of output (= state)";
  parameter Modelica.Units.SI.Time dCMotorControlCompressor.armatureInverter.idealDcDc.Td
     = dCMotorControlCompressor.armatureInverter.Td "Dead time";
  parameter Modelica.Units.SI.Time dCMotorControlCompressor.armatureInverter.idealDcDc.Ti
     = dCMotorControlCompressor.armatureInverter.Ti "Time constant of integral power controller";
  parameter Real dCMotorControlCompressor.armatureInverter.idealDcDc.deadTime.k(
    unit = "1") = 1 "Gain";
  parameter Modelica.Units.SI.Time dCMotorControlCompressor.armatureInverter.idealDcDc.deadTime.T
    (start = 1) = dCMotorControlCompressor.armatureInverter.idealDcDc.Td 
    "Time Constant";
  parameter Modelica.Blocks.Types.Init dCMotorControlCompressor.armatureInverter.idealDcDc.deadTime.initType
     = Modelica.Blocks.Types.Init.InitialOutput "Type of initialization (1: no init, 2: steady state, 3/4: initial output)";
  parameter Real dCMotorControlCompressor.armatureInverter.idealDcDc.deadTime.y_start
     = 0 "Initial or guess value of output (= state)";
  parameter Real dCMotorControlCompressor.armatureInverter.idealDcDc.powerController.k
    (unit = "1") = 1/dCMotorControlCompressor.armatureInverter.idealDcDc.Ti 
    "Integrator gain";
  constant Boolean dCMotorControlCompressor.armatureInverter.idealDcDc.powerController.use_reset
     = false "= true, if reset port enabled";
  constant Boolean dCMotorControlCompressor.armatureInverter.idealDcDc.powerController.use_set
     = false "= true, if set port enabled and used as reinitialization value when reset";
  parameter Modelica.Blocks.Types.Init dCMotorControlCompressor.armatureInverter.idealDcDc.powerController.initType
     = Modelica.Blocks.Types.Init.InitialOutput "Type of initialization (1: no init, 2: steady state, 3,4: initial output)";
  parameter Real dCMotorControlCompressor.armatureInverter.idealDcDc.powerController.y_start
     = 0 "Initial or guess value of output (= state)";
  parameter Real dCMotorControlCompressor.armatureInverter.vMotFilter.k(unit = 
    "1") = 1 "Gain";
  parameter Modelica.Units.SI.Time dCMotorControlCompressor.armatureInverter.vMotFilter.T
    (start = 1) = dCMotorControlCompressor.armatureInverter.Tmf "Time Constant";
  parameter Modelica.Blocks.Types.Init dCMotorControlCompressor.armatureInverter.vMotFilter.initType
     = Modelica.Blocks.Types.Init.InitialOutput "Type of initialization (1: no init, 2: steady state, 3/4: initial output)";
  parameter Real dCMotorControlCompressor.armatureInverter.vMotFilter.y_start = 0
     "Initial or guess value of output (= state)";
  parameter Real dCMotorControlCompressor.armatureInverter.iDCFilter.k(unit = 
    "1") = 1 "Gain";
  parameter Modelica.Units.SI.Time dCMotorControlCompressor.armatureInverter.iDCFilter.T
    (start = 1) = dCMotorControlCompressor.armatureInverter.Tmf "Time Constant";
  parameter Modelica.Blocks.Types.Init dCMotorControlCompressor.armatureInverter.iDCFilter.initType
     = Modelica.Blocks.Types.Init.InitialOutput "Type of initialization (1: no init, 2: steady state, 3/4: initial output)";
  parameter Real dCMotorControlCompressor.armatureInverter.iDCFilter.y_start = 
    dCMotorControlCompressor.armatureInverter.VMax "Initial or guess value of output (= state)";
  parameter Real dCMotorControlCompressor.currentController.k(unit = "1") = 
    dCMotorControlCompressor.driveData.kpI "Gain";
  constant Boolean dCMotorControlCompressor.currentController.useI = true 
    "PI else P";
  parameter Modelica.Units.SI.Time dCMotorControlCompressor.currentController.Ti
    (min = 1E-60) = dCMotorControlCompressor.driveData.TiI "Integral time constant (T>0 required)";
  constant Boolean dCMotorControlCompressor.currentController.useFF = true 
    "Use feed-forward?";
  constant Boolean dCMotorControlCompressor.currentController.useConstantKFF = 
    true "Use constant feed-forward factor?";
  parameter Real dCMotorControlCompressor.currentController.KFF(unit = "1") = 1 
    "Feed-forward gain";
  constant Boolean dCMotorControlCompressor.currentController.constantLimits = 
    false "Use constant limits?";
  constant Boolean dCMotorControlCompressor.currentController.symmetricLimits = 
    true "Use symmetric limits?";
  parameter Real dCMotorControlCompressor.currentController.yMax = 1E+60 
    "Upper limit of output";
  parameter Real dCMotorControlCompressor.currentController.yMin =  -
    dCMotorControlCompressor.currentController.yMax "Lower limit of output";
  parameter Modelica.Blocks.Types.Init dCMotorControlCompressor.currentController.initType
     = Modelica.Blocks.Types.Init.InitialOutput "Type of initialization (1: no init, 2: steady state, 3: initial state, 4: initial output)";
  parameter Real dCMotorControlCompressor.currentController.x_start = 0 
    "Initial or guess value of state";
  parameter Real dCMotorControlCompressor.currentController.y_start = 0 
    "Initial value of output";
  parameter Real dCMotorControlCompressor.currentController.addAntiWindup.k1 = 1
     "Gain of input signal 1";
  parameter Real dCMotorControlCompressor.currentController.addAntiWindup.k2 = 
     -1/dCMotorControlCompressor.currentController.k "Gain of input signal 2";
  parameter Real dCMotorControlCompressor.currentController.integrator.k(unit = 
    "1") = 1/dCMotorControlCompressor.currentController.Ti "Integrator gain";
  constant Boolean dCMotorControlCompressor.currentController.integrator.use_reset
     = false "= true, if reset port enabled";
  constant Boolean dCMotorControlCompressor.currentController.integrator.use_set
     = false "= true, if set port enabled and used as reinitialization value when reset";
  parameter Modelica.Blocks.Types.Init dCMotorControlCompressor.currentController.integrator.initType
     = Modelica.Blocks.Types.Init.NoInit "Type of initialization (1: no init, 2: steady state, 3,4: initial output)";
  parameter Real dCMotorControlCompressor.currentController.integrator.y_start
     = 0 "Initial or guess value of output (= state)";
  parameter Real dCMotorControlCompressor.currentController.add3.k1 = 
    dCMotorControlCompressor.currentController.k "Gain of input signal 1";
  parameter Real dCMotorControlCompressor.currentController.add3.k2 = 
    dCMotorControlCompressor.currentController.k "Gain of input signal 2";
  parameter Real dCMotorControlCompressor.currentController.add3.k3 = 1 
    "Gain of input signal 3";
  parameter Boolean dCMotorControlCompressor.currentController.variableLimiter.strict
     = false "= true, if strict limits with noEvent(..)";
  parameter Modelica.Blocks.Types.VariableLimiterHomotopy dCMotorControlCompressor.currentController.variableLimiter.homotopyType
     = Modelica.Blocks.Types.VariableLimiterHomotopy.Linear "Simplified model for homotopy-based initialization";
  parameter Real dCMotorControlCompressor.currentController.variableLimiter.ySimplified
     = 0 "Fixed value of output in simplified model";
  parameter Real dCMotorControlCompressor.currentController.constantKFF.k(
    start = 1) = dCMotorControlCompressor.currentController.KFF "Constant output value";
  parameter Real dCMotorControlCompressor.currentController.gain.k(start = 1, 
    unit = "1") = -1 "Gain value multiplied with input signal";
  parameter Real dCMotorControlCompressor.tau2i.k(start = 1, unit = "1") = 1/
    dCMotorControlCompressor.driveData.kPhi "Gain value multiplied with input signal";
  parameter Real dCMotorControlCompressor.speedController.k(unit = "1") = 
    dCMotorControlCompressor.driveData.kpw "Gain";
  constant Boolean dCMotorControlCompressor.speedController.useI = true 
    "PI else P";
  parameter Modelica.Units.SI.Time dCMotorControlCompressor.speedController.Ti(
    min = 1E-60) = dCMotorControlCompressor.driveData.Tiw "Integral time constant (T>0 required)";
  constant Boolean dCMotorControlCompressor.speedController.useFF = false 
    "Use feed-forward?";
  constant Boolean dCMotorControlCompressor.speedController.useConstantKFF = 
    true "Use constant feed-forward factor?";
  parameter Real dCMotorControlCompressor.speedController.KFF(unit = "1") = 1 
    "Feed-forward gain";
  constant Boolean dCMotorControlCompressor.speedController.constantLimits = 
    true "Use constant limits?";
  constant Boolean dCMotorControlCompressor.speedController.symmetricLimits = 
    true "Use symmetric limits?";
  parameter Real dCMotorControlCompressor.speedController.yMax = 
    dCMotorControlCompressor.driveData.tauMax+100 "Upper limit of output";
  parameter Real dCMotorControlCompressor.speedController.yMin =  -
    dCMotorControlCompressor.speedController.yMax "Lower limit of output";
  parameter Modelica.Blocks.Types.Init dCMotorControlCompressor.speedController.initType
     = Modelica.Blocks.Types.Init.InitialOutput "Type of initialization (1: no init, 2: steady state, 3: initial state, 4: initial output)";
  parameter Real dCMotorControlCompressor.speedController.x_start = 0 
    "Initial or guess value of state";
  parameter Real dCMotorControlCompressor.speedController.y_start = 0 
    "Initial value of output";
  parameter Real dCMotorControlCompressor.speedController.addAntiWindup.k1 = 1 
    "Gain of input signal 1";
  parameter Real dCMotorControlCompressor.speedController.addAntiWindup.k2 =  -1
    /dCMotorControlCompressor.speedController.k "Gain of input signal 2";
  parameter Real dCMotorControlCompressor.speedController.integrator.k(unit = 
    "1") = 1/dCMotorControlCompressor.speedController.Ti "Integrator gain";
  constant Boolean dCMotorControlCompressor.speedController.integrator.use_reset
     = false "= true, if reset port enabled";
  constant Boolean dCMotorControlCompressor.speedController.integrator.use_set
     = false "= true, if set port enabled and used as reinitialization value when reset";
  parameter Modelica.Blocks.Types.Init dCMotorControlCompressor.speedController.integrator.initType
     = Modelica.Blocks.Types.Init.NoInit "Type of initialization (1: no init, 2: steady state, 3,4: initial output)";
  parameter Real dCMotorControlCompressor.speedController.integrator.y_start = 0
     "Initial or guess value of output (= state)";
  parameter Real dCMotorControlCompressor.speedController.add3.k1 = 
    dCMotorControlCompressor.speedController.k "Gain of input signal 1";
  parameter Real dCMotorControlCompressor.speedController.add3.k2 = 
    dCMotorControlCompressor.speedController.k "Gain of input signal 2";
  parameter Real dCMotorControlCompressor.speedController.add3.k3 = 1 
    "Gain of input signal 3";
  parameter Boolean dCMotorControlCompressor.speedController.variableLimiter.strict
     = false "= true, if strict limits with noEvent(..)";
  parameter Modelica.Blocks.Types.VariableLimiterHomotopy dCMotorControlCompressor.speedController.variableLimiter.homotopyType
     = Modelica.Blocks.Types.VariableLimiterHomotopy.Linear "Simplified model for homotopy-based initialization";
  parameter Real dCMotorControlCompressor.speedController.variableLimiter.ySimplified
     = 0 "Fixed value of output in simplified model";
  parameter Real dCMotorControlCompressor.speedController.zeroFF.k(start = 1) = 0
     "Constant output value";
  parameter Real dCMotorControlCompressor.speedController.constantKFF.k(start = 1)
     = dCMotorControlCompressor.speedController.KFF "Constant output value";
  parameter Real dCMotorControlCompressor.speedController.yMaxConst.k(start = 1)
     = dCMotorControlCompressor.speedController.yMax "Constant output value";
  parameter Real dCMotorControlCompressor.speedController.gain.k(start = 1, 
    unit = "1") = -1 "Gain value multiplied with input signal";
