  parameter Real dcpm.friction.frictionParameters.linear "Linear angular velocity range with respect to reference angular velocity";
  parameter Modelica.Units.SI.AngularVelocity dcpm.friction.frictionParameters.wLinear
     "Linear angular velocity range";
  parameter Modelica.Units.SI.Torque dcpm.friction.frictionParameters.tauLinear 
    "Torque corresponding with linear angular velocity range";
  constant Boolean dcpm.friction.useHeatPort = true "= true, if heatPort is enabled";
  parameter Integer dcpm.coreParameters.m "Number of phases (1 for DC, 3 for induction machines)";
  parameter Modelica.Units.SI.Power dcpm.coreParameters.PRef(min = 0.0) 
