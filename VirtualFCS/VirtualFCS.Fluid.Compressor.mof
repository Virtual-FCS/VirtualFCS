  equation
    dCMotorControlCompressor.armatureInverter.vDC = dCMotorControlCompressor.armatureInverter.gain.u;
    dCMotorControlCompressor.armatureInverter.vDCFilter.y = dCMotorControlCompressor.armatureInverter.gain.u;
