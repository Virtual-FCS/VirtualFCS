within VirtualFCS.UsersGuide;
model Acknowledgements
  extends Modelica.Icons.Information;
equation

  annotation (
    Documentation(info = "<html><head></head><body>
<h2>Model Description and References</h2>
<div>The following people have directly contributed to the implementation of the Virtual-FCS library.</div><div><ul><li>Amélie Pinard, France</li><li><a href=\"https://www.sintef.no/en/all-employees/employee/benjamin.synnevag/\">Benjamin Synnevåg</a>,&nbsp;SINTEF Industry, Trondheim, Norway</li><li><a href=\"https://scholar.google.com/citations?user=3UCUkkoAAAAJ\">Dr. Daniel Pérez Clos</a>,&nbsp;SINTEF Industry, Trondheim, Norway</li><li><a href=\"https://scholar.google.com/citations?user=96ato0cAAAAJ\">Dr. Federico Zenith</a>,&nbsp;SINTEF Digital, Trondheim, Norway</li><li><a href=\"https://www.sintef.no/en/all-employees/employee/karim.bendioub/\">Dr. Karim Bendioub</a>,&nbsp;SINTEF Industry, Trondheim, Norway</li><li><a href=\"https://scholar.google.no/citations?user=VtrKOXUAAAAJ&amp;hl=en&amp;oi=ao\">Dr. Loic Vichard</a>, UBFC, France</li><li><a href=\"https://scholar.google.no/citations?user=Lb7P3pwAAAAJ&amp;hl=en&amp;oi=ao\">Dr. Michael R. Gerhardt</a>, SINTEF Industry, Norway</li><li><a href=\"https://scholar.google.com/citations?user=I83c1BcAAAAJ\">Dr. Nadia Yousfi Steiner</a>,&nbsp;UBFC, Belfort, France</li><li><a href=\"https://scholar.google.com/citations?user=Rm-vHUsAAAAJ\">Dr. Roberto Scipioni</a>,&nbsp;SINTEF Industry Trondheim, Norway</li><li><a href=\"https://scholar.google.no/citations?user=YyXXh8UAAAAJ&amp;hl=en\">Dr. Simon Clark</a>, SINTEF Industry, Norway</li><li><a href=\"https://scholar.google.no/citations?user=mlhoJ9wAAAAJ&amp;hl=en&amp;oi=ao\">Dr. Yash Raka</a>, SINTEF Industry, Norway</li></ul></div><div>Many others have contributed by other means than model implementation. Specifically, we thank <a href=\"https://scholar.google.com/citations?user=usI_z3IAAAAJ&amp;hl=it&amp;oi=ao\">Dr. Alejandro Oyarce Barnett</a> (SINTEF Industry)&nbsp;and <a href=\"https://scholar.google.com/citations?user=C0YhMpsAAAAJ&amp;hl=it&amp;oi=ao\">Dr. Daniel Hissel</a> (UBFC) for the helpful discussions.</div><div><br></div><div>This library is part of a project that has received funding from the Clean Hydrogen (formerly Fuel Cells and Hydrogen 2) Joint Undertaking under Grant Agreements No 875087, 101192365, 101250260, and 101250344. This Joint Undertaking receives support from the European Union’s Horizon 2020 Research and Innovation programme, Hydrogen Europe and Hydrogen Europe Research.</div><div><br></div><div><span style=\"font-size: 12px;\"><br></span></div>
<img src=\"modelica://VirtualFCS/../docs/Resources/VirtualFCS/imgEuropeFlag.jpg\" style=\"width:3cm\">

</body></html>"));
end Acknowledgements;
