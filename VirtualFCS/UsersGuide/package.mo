within VirtualFCS;
package UsersGuide "User information for the VirtualFCS library"
  extends Modelica.Icons.Information;
  annotation (
   Documentation(info = "<html><head></head><body><p><code>VirtualFCS</code> is an open Modelica library for dynamic modelling of hydrogen and hybrid energy systems. It includes fuel cells, batteries, electrolysers, balance-of-plant components, vehicle powertrains, and ammonia cracking, with examples for transport and other applications.</p><p>For requirements, installation, and example models, see the <a href=\"https://github.com/Virtual-FCS/VirtualFCS/blob/main/README.md\">project README</a>. The source is hosted on <a href=\"https://github.com/Virtual-FCS/VirtualFCS\">GitHub</a>. Contributions and issue reports are welcome through the repository's <a href=\"https://github.com/Virtual-FCS/VirtualFCS/pulls\">pull requests</a> and <a href=\"https://github.com/Virtual-FCS/VirtualFCS/issues\">issue tracker</a>.</p><p>Browse the main package areas below.</p>

<div><br><table border=\"1\"><tbody><tr><th>Name</th>
            <th>Description</th>
         </tr>
         <tr>
            <td><a href=\"modelica://VirtualFCS.Chemical\">Chemical</a></td>
            <td>Chemical-process models, including ammonia cracking.</td>
         </tr>

         <tr>
            <td><a href=\"modelica://VirtualFCS.Control.UsersGuide\">Control</a></td>
            <td>Fuel-cell, battery, balance-of-plant, and energy-management controls.</td>
         </tr>
         
         <tr>
            <td><a href=\"modelica://VirtualFCS.Electrical.UsersGuide\">Electrical</a></td>
            <td>Electrical components supplementing the Modelica Standard Library.</td>
         </tr>
         
         <tr>
            <td><a href=\"modelica://VirtualFCS.Electrochemical.UsersGuide\">Electrochemical</a></td>
            <td>PEM fuel cells and stacks, batteries, and electrolysers.</td>
         </tr>
         
         <tr>
            <td><a href=\"modelica://VirtualFCS.Examples\">Examples</a></td>
            <td>Demonstrations for vehicle, ship, and electrochemical systems.</td>
         </tr>

         <tr>
            <td><a href=\"modelica://VirtualFCS.Fluid.UsersGuide\">Fluid</a></td>
            <td>Compressors, humidifiers, heat exchangers, and other fluid components.</td>
         </tr>

         <tr>
            <td><a href=\"modelica://VirtualFCS.Media\">Media</a></td>
            <td>Media models used by fluid and chemical systems.</td>
         </tr>

         <tr>
            <td><a href=\"modelica://VirtualFCS.Powertrains\">Powertrains</a></td>
            <td>Battery-electric and fuel-cell range-extender powertrains, including ECMS.</td>
         </tr>
         
         <tr>
            <td><a href=\"modelica://VirtualFCS.Thermal.UsersGuide\">Thermal</a></td>
            <td>Thermal components and models.</td>
         </tr>
         
         <tr>
            <td><a href=\"modelica://VirtualFCS.SubSystems.UsersGuide\">SubSystems</a></td>
            <td>Hydrogen, air, and cooling subsystems for fuel-cell systems.</td>
         </tr>
         
         <tr>
            <td><a href=\"modelica://VirtualFCS.Utilities\">Utilities</a></td>
            <td>Shared utilities and parameter records.</td>
         </tr>

         <tr>
            <td><a href=\"modelica://VirtualFCS.Vehicles.UsersGuide\">Vehicles</a></td>
            <td>Vehicle profiles, drive cycles, and vehicle-level models.</td>
         </tr>
         
         <tr>
            <td><a href=\"modelica://VirtualFCS.XInTheLoop\">XInTheLoop</a></td>
            <td>Hardware-, software-, model-, and user-in-the-loop functionality.</td>
         </tr>


      </tbody></table><h3>Projects and acknowledgements</h3><p>The library was developed with support from the <a href=\"https://www.virtual-fcs.eu/\">Virtual-FCS</a>, <a href=\"https://bebop-hydrogen.eu/\">BeBoP</a>, <a href=\"https://minami-project.eu/\">MiNaMi</a>, and <a href=\"https://h2surfer.eu/\">SURFER</a> projects. The work received funding from the Clean Hydrogen (formerly Fuel Cells and Hydrogen 2) Joint Undertaking under grant agreements 875087, 101192365, 101250260, and 101250344. The Joint Undertaking receives support from the European Union's Horizon 2020 Research and Innovation programme, Hydrogen Europe, and Hydrogen Europe Research.</p></div></body></html>"));
end UsersGuide;
