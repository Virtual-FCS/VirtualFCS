  annotation(
    Documentation(info = "<html><head></head><body>This sub-package includes models of commonly used physical media.<table border=\"0.9\"><tbody><tr><th>Name</th><th>Description</th></tr><tr><td><a href=\"modelica://VirtualFCS.Media.PartialCondensingMixture\">PartialCondensingMixture</a></td><td>General-purpose partial model for multicomponent condensable media.</td></tr><tr><td><a href=\"modelica://VirtualFCS.Media.Shomate\">Shomate</a></td><td>Collection of Shomate parameters and functions.</td></tr>
<tr><td><a href=\"modelica://VirtualFCS.Media.MoistAir\">MoistAir</
a></td><td>Oxygen, nitrogen, condensable water.</td></tr>
<tr><td><a href=\"modelica://VirtualFCS.Media.MoistHydrogen\">MoistHydrogen</a></td>Hydrogen and condensable water.<td></td></tr>
<tr><td><a href=\"modelica://VirtualFCS.Media.PEMELfluid\"></a></td><td>Oxygen, nitrogen, hydrogen and condensable water.</td></tr>
<tr><td><a href=\"modelica://VirtualFCS.Media.CrackedAmmonia\">CrackedAmmonia</a></td><td>Nitrogen, hydrogen and condensable ammonia.</td></tr>
<tr><td>BaseShoMix</a></td><td>Legacy medium template (deprecated).</td></tr>
<tr><td>NH3Cracked</a></td><td>Legacy cracked ammonia model (deprecated).</td></tr>
</tbody></table></body></html>"));
